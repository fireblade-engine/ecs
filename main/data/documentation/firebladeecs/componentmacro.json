{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The optional ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" product provides the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"code":"struct","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Protocol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Generated","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enables","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"stable ","type":"text"},{"type":"codeVoice","code":"componentTypeName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.componentType(named:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clone(context:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.clone(into:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"encode(to:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Nexus: Codable"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"componentProperties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init()"},{"text":" if every stored property has a default value (structs)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"key path assignment, state machines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}],"type":"paragraph"}],[{"inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The core ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" library stays dependency free. Only ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" depends on ","type":"text"},{"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}]},{"level":3,"type":"heading","text":"Adding the product","anchor":"Adding-the-product"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":": add the ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"level":3,"type":"heading","text":"Declaring components","anchor":"Declaring-components"},{"type":"codeListing","syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"items":[{"content":[{"inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" leaves serialization entirely to you.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"package","type":"codeVoice"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":" in its body (the implicit ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" itself, and it gets ","type":"text"},{"code":"DefaultInitializable","type":"codeVoice"},{"text":" only if it declares ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The macro stores ","type":"text"},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"code":"componentIndex","type":"codeVoice"},{"text":" to opt out.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"Value types and diagnostics","anchor":"Value-types-and-diagnostics"},{"type":"paragraph","inlineContent":[{"code":"@Component","type":"codeVoice"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property spelled ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Entity?","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[Entity]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Set<Entity>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Key: Entity]","type":"codeVoice"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" by ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true,"type":"reference"},{"text":". An ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","isActive":true,"type":"reference"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}]},{"level":3,"type":"heading","text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots"},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"type":"paragraph","inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true,"type":"reference"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true,"type":"reference"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true}],"metadata":{"roleHeading":"Article","title":"Generating components with the component macro","modules":[{"name":"FirebladeECS"}],"role":"article"},"identifier":{"url":"do