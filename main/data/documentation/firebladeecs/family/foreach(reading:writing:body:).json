text","text":"Available when"}]}},"sections":[],"abstract":[{"type":"text","text":"Iterates the members of this family with any number of read and written component types."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" (repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"), repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":", repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This is the fallback for more than 4 read or 4 written types; fewer are served by the overloads with fixed arity,"},{"type":"text","text":" "},{"type":"text","text":"which are faster because their loop specializes. The contract is the one of those overloads (see"},{"type":"text","text":" "},{"type":"text","text":"the overload that reads 1 and writes 1 type), with two differences in shape:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the written components first, as one "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" tuple, then the read components. Swift can not"},{"type":"text","text":" "},{"type":"text","text":"express "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" pack parameters in a closure, and two packs in one closure type can not be inferred."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The written components are copied out of the storage into the tuple and back after "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returned, so a"},{"type":"text","text":" "},{"type":"text","text":"write is not visible in the storage before "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["family.forEach(reading: A.self, B.self, C.self, D.self, E.self, writing: X.self, Y.self) { (written: inout (X, Y), a, b, c, d, e) in","    written.0.value += a.value","}"]},{"inlineContent":[{"type":"text","text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TypeSubstituter.transformPackElementType"},{"type":"text","text":")."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"style":"note","type":"aside","name":"Complexity"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"role":"symbol","title":"Family","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"url":"\/documentation\/firebladeecs\/family","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Family","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","navigatorTitle":[{"text":"Family","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:body:)":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)","title":"forEach(reading:writing:body:)","url":"\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)","type":"topic","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Iterates the members of this family with any number of read and written component types."}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"forEach"},{"text":"<each ","kind":"text"},{"text"