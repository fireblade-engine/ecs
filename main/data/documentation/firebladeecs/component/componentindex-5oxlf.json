{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storages address their per-type state and the per-entity component bitset by this value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default implementation assigns indices lazily: the first access of a type takes the next free index"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier"},{"type":"text","text":" for persistent data."}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Provide your own implementation (the "},{"type":"codeVoice","code":"@Component"},{"text":" macro will) as a stored ","type":"text"},{"type":"codeVoice","code":"static let"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type.","type":"text"},{"text":" ","type":"text"},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1)"}]}],"name":"Complexity","type":"aside"}]}],"abstract":[{"type":"text","text":"The dense index of this component type."}],"metadata":{"externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","modules":[{"name":"FirebladeECS"}],"roleHeading":"Type Property","role":"symbol","title":"componentIndex","extendedModule":"FirebladeECS","symbolKind":"property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"abstract":[{"text":"The stable identifier of this component type, derived from ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stableIdentifier","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StableComponentIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","title":"stableIdentifier"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"kind":"symbol","defaultImplementations":1,"url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","title":"componentTypeName","role":"symbol","type":"topic","required":true,"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"kind":"symbol","url":"\/documentation\/firebladeecs","title":"FirebladeECS","role":"collection","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","abstract":[{"inlineContent":[{"text":"Component","type":"text"}],"type":"strong"}],"navigatorTitle":[{"text":"Component","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/component","title":"Component","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Component","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"kind":"symbol","abstract":[{"type":"text","text":"The dense index of this component type."}],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","title":"componentIndex"}}}