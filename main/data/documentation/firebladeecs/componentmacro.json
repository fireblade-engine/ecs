{"kind":"article","sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The optional ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" product provides the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol"}]}],[{"inlineContent":[{"text":"Generated","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enables"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"code":"nexus.registeredComponentTypes","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.componentType(named:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clone(context:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"code":"nexus.clone(into:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"encode(to:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"code":"nexus.decodeSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Nexus: Codable"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"componentProperties"}]}],[{"type":"paragraph","inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"init()","type":"codeVoice"},{"text":" if every stored property has a default value (structs)","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"key path assignment, state machines"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}]}]]],"type":"table"},{"inlineContent":[{"text":"The core ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" library stays dependency free. Only ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" depends on ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}],"type":"paragraph"},{"anchor":"Adding-the-product","level":3,"type":"heading","text":"Adding the product"},{"inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":": add the ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"type":"text","text":" product too and import both modules in every file that uses "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Declaring-components","text":"Declaring components"},{"syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"type":"text","text":" takes a "},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"type":"codeVoice","code":".cloneable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".serializable"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"type":"text","text":". Registration is always implemented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" leaves serialization entirely to you."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"package"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" itself, and it gets ","type":"text"},{"code":"DefaultInitializable","type":"codeVoice"},{"text":" only if it declares ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The macro stores "},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"code":"componentIndex","type":"codeVoice"},{"type":"text","text":" to opt out."}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"Value types and diagnostics","anchor":"Value-types-and-diagnostics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Set<Entity>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[Key: Entity]"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" by ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true,"type":"reference"},{"text":". An ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","isActive":true,"type":"reference"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}]},{"level":3,"anchor":"Registering-cloning-and-snapshots","type":"heading","text":"Registering, cloning and snapshots"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference","isActive":true},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","type":"reference","isActive":true},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"metadata":{"modules":[{"name":"FirebladeECS"}],"role":"article","title":"Generating components with the component macro","roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]