{"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"variants":[{"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"FirebladeECS"}],"title":"Reacting to Nexus events","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Structural events are always delivered:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value change events are opt-in:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true},{"type":"text","text":": a component was set on an entity that already had one of that type."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","isActive":true},{"type":"text","text":" is the number of components the pass could write."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}]},{"type":"heading","anchor":"Subscribing","level":3,"text":"Subscribing"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","isActive":true},{"type":"text","text":" is "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"type":"text","text":" by default. Return "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","isActive":true},{"type":"text","text":" to receive value changes:"}]},{"syntax":"swift","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","isActive":true},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The nexus reads "},{"type":"codeVoice","code":"subscribedEvents"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"type":"codeVoice","code":"nexus.delegate = observer"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}]}]}]},{"type":"heading","anchor":"Cost","level":3,"text":"Cost"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}]},{"type":"heading","anchor":"Ordering","level":3,"text":"Ordering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true},{"type":"text","text":" and then "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"type":"text","text":". Setting a component the entity does not have yet delivers "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true},{"type":"text","text":" only, never "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true},{"type":"text","text":" to delegates that subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Comparison-with-flecs","level":3,"text":"Comparison with flecs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every "},{"type":"codeVoice","code":"set"},{"type":"text","text":" and on an explicit "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"FirebladeECS differs on purpose: in-place writes through the nexus emit "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"type":"text","text":" automatically, so there is no "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":" only."}]}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"anchor":"Essentials","generated":true}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"abstract":[{"type":"text","text":"