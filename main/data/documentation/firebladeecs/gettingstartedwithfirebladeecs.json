{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"kind":"article","metadata":{"title":"Getting started with Fireblade ECS","modules":[{"name":"FirebladeECS"}],"role":"article","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}],"type":"paragraph"},{"inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" file or use it to create a new project.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""]},{"inlineContent":[{"type":"text","text":"Coming from FirebladeECS 1? Read "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","isActive":true,"type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"type":"text","text":" "},{"text":"For a more detailed example, see the ","type":"text"},{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"🏛️ Nexus","level":3,"anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","type":"heading"},{"inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","isActive":true,"type":"reference"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"type":"codeVoice","code":"Entities"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"text":" at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Initialize a "},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let nexus = Nexus()"],"type":"codeListing"},{"anchor":"%F0%9F%91%A4-Entities","level":3,"type":"heading","text":"👤 Entities"},{"inlineContent":[{"text":"then create entities by letting the ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" generate them."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"]},{"inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}],"type":"paragraph"},{"code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"and assign values of it to an "},{"type":"codeVoice","code":"Entity"},{"text":" with","type":"text"}],"type":"paragraph"},{"code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}],"type":"paragraph"},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing","syntax":"swift"},{"anchor":"%F0%9F%91%AA-Families","level":3,"type":"heading","text":"👪 Families"},{"inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"inlineContent":[{"type":"text","text":"same component types"}],"type":"strong"},{"text":" may belong to one ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":" has entities as members and component types as family traits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Create a family by calling ","type":"text"},{"code":".family","type":"codeVoice"},{"text":" with a set of traits on the nexus.","type":"text"},{"type":"text","text":" "},{"text":"A family that contains only entities with a ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PlayerInput","type":"codeVoice"},{"text":" component, but no ","type":"text"},{"code":"Texture","type":"codeVoice"},{"text":" component is created by","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"inlineContent":[{"text":"These entities are cached in the nexus for efficient access and iteration.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"code":"forEach(reading:writing:)","type":"codeVoice"},{"type":"text","text":", see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"type":"codeVoice","code":"family.entities"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"text":"🧑 Singles","level":3,"type":"heading","anchor":"%F0%9F%A7%91-Singles"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Single","type":"codeVoice"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" entity with exactly "},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference","isActive":true},{"type":"text","text":" character. Single components must conform to the "},{"type":"codeVoice","code":"SingleComponent"},{"type":"text","text":" protocol and will not be available through regular family iteration."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""]},{"text":"🔗 Serialization","level":3,"type":"heading","anchor":"%F0%9F%94%97-Serialization"},{"inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"references":{"https://developer.apple.com/documentation/swift/sequence":{"titleInlineContent":[{"type":"text","text":"Sequence"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"type":"topic","url":"\/documentation\/firebladeecs\/reactingtonexusevents","title":"Reacting to Nexus events","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}],"type":"topic","abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"NexusEvent","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexusevent","title":"NexusEvent"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","abstract":[{"type":"text","text":"The kinds of events a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"reference","isActive":true},{"type":"text","text":" subscribes to."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"url":"\/documentation\/firebladeecs\/nexuseventmask","title":"NexusEventMask","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventMask"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","abstract":[],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}]},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"titleInlineContent":[{"type":"text","text":"Singleton"}],"type":"link","url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","url":"\/documentation\/firebladeecs","role":"collection","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"kind":"symbol"},"https://en.wiktionary.org/wiki/nexus#Noun":{"titleInlineContent":[{"type":"text","text":"Nexus"}],"type":"link","url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate","title":"NexusEventDelegate","role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"type":"topic","abstract":[{"type":"text","text":"The storage a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" keeps its entities and components in."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"url":"\/documentation\/firebladeecs\/nexus\/storagekind","title":"Nexus.StorageKind"},"https://github.com/fireblade-engine/ecs-demo":{"titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}],"type":"link","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","title":"Fireblade ECS Demo App","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},"doc://FirebladeECS/documentation/FirebladeECS/Benchmarks":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","title":"Benchmarks","url":"\/documentation\/firebladeecs\/benchmarks","role":"article","abstract":[{"type":"text","text":"See how FirebladeECS revisions compare on a shared workload suite, and run the comparison yourself."}],"kind":"article"},"https://en.wikipedia.org/wiki/Entity_component_system":{"titleInlineContent":[{"type":"text","text":"ECS"}],"type":"link","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"type":"topic","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","title":"Migrating to FirebladeECS 2","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","title":"Reading and writing components","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","role":"article","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"type":"topic","url":"\/documentation\/firebladeecs\/savingandloadingscenes","title":"Saving and Loading Scenes","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","title":"Choosing a storage","url":"\/documentation\/firebladeecs\/choosingastorage","role":"article","abstract":[{"text":"Pick the sparse-set or the archetype storage for a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":", and know what changes.","type":"text"}],"kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"type":"topic","url":"\/documentation\/firebladeecs\/componentmacro","title":"Generating components with the component macro","role":"article","kind":"article"}}}