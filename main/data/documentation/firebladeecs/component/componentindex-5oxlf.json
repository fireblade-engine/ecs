mentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","title":"stableIdentifier","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StableComponentIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV"}],"type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"title":"Component","url":"\/documentation\/firebladeecs\/component","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"navigatorTitle":[{"kind":"identifier","text":"Component"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"url":"\/documentation\/firebladeecs","kind":"symbol","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","role":"collection"}}}