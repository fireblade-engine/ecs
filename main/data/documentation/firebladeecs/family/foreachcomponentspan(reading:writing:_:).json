{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"type":"codeVoice","code":"body"},{"type":"text","text":" receives a "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" of the read type and an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableSpan"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}]},{"syntax":"swift","type":"codeListing","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"type":"heading","anchor":"Batches","text":"Batches","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"type":"codeVoice","code":"body"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}]},{"inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"type":"text","text":" "},{"type":"text","text":"the family and has members, in table creation order. Entities with the same component set form one batch, however"},{"text":" ","type":"text"},{"text":"the component set came about, and a family whose members have several component sets gets several calls.","type":"text"}],"type":"paragraph"},{"text":"Rules","level":3,"type":"heading","anchor":"Rules"},{"inlineContent":[{"text":"Every type must be a required component of the family. The spans cannot escape ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Span"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"~Escapable"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the pass runs the nexus is locked like in ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","isActive":true,"type":"reference"},{"text":": structural changes, reading a","type":"text"},{"text":" ","type":"text"},{"text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written","type":"text"},{"text":" ","type":"text"},{"text":"type) stop the process with a message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A delegate subscribed to ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true,"type":"reference"},{"text":" receives one ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"text":" per written type","type":"text"},{"text":" ","type":"text"},{"text":"and call, not one event per batch.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}],"type":"paragraph"}],"style":"note","name":"Complexity"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}]},"externalID":"s:12FirebladeECS6FamilyV20forEachComponentSpan7reading7writing_yqd__m_qd_0_mys0G0Vyqd__G_s07MutableG0Vyqd_0_GztKXEtKAA0F0Rd__AaMRd_0_r0_lF","modules":[{"name":"FirebladeECS"}],"title":"forEachComponentSpan(reading:writing:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","tex