r"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type."}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Receives the span; its result is returned."}]}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The span covers every component of the type in storage order, which is not the creation order once components were","type":"text"},{"text":" ","type":"text"},{"text":"removed. It is zero copy: it views the storage itself. Because ","type":"text"},{"type":"codeVoice","code":"Span"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"~Escapable"},{"text":", it cannot leave ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" ","type":"text"},{"text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Span"},{"text":" is not a ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"text":": loop over ","type":"text"},{"type":"codeVoice","code":"indices"},{"text":". Element access is bounds checked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or","type":"text"},{"text":" ","type":"text"},{"text":"removing components, replacing a component with ","type":"text"},{"type":"codeVoice","code":"set"},{"text":") and writes to the type stop the process with a message,","type":"text"},{"text":" ","type":"text"},{"text":"since they would move or change what the span views. Reading the component through the nexus and reading","type":"text"},{"text":" ","type":"text"},{"text":"the type again are fine. Collect changes and apply them after the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An empty storage (or a type no entity ever had) passes an empty span.","type":"text"}]},{"anchor":"Storage","text":"Storage","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself.","type":"text"},{"text":" ","type":"text"},{"text":"The archetype storage keeps one column per table (one table per component set), so entities with different","type":"text"},{"text":" ","type":"text"},{"text":"component sets are not next to each other. If one table holds all components of the type the span views its column,","type":"text"},{"text":" ","type":"text"},{"text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs","type":"text"},{"text":" ","type":"text"},{"text":"one allocation and O(N) copying per call and is released after ","type":"text"},{"type":"codeVoice","code":"body"},{"text":". Use","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","isActive":true},{"type":"text","text":" to get zero copy spans, one batch per table."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(1) plus ","type":"text"},{"type":"codeVoice","code":"body"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Gives ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" read access to all components of a type as one contiguous ","type":"text"},{"type":"codeVoice","code":"Span"},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/Fireb