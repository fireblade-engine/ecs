xist for"},{"type":"text","text":" "},{"type":"text","text":"0 to 4 read and 0 to 4 written types, and a parameter pack overload covers more."}],"type":"paragraph"},{"code":["entity.components(Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity\/components(_:writing:_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/firebladeecs\/entity\/components(_:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:12FirebladeECS6EntityV10components_7writing_Sbxm_q_myx_q_ztKXEtKAA9ComponentRzAaFR_r0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","title":"components(_:writing:_:)","modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","symbolKind":"method","roleHeading":"Instance Method"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Entity":{"identifier":"doc:\/\/FirebladeECS