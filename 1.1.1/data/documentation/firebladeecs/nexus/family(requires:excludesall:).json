":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"General usage"}],"type":"strong"}],"type":"paragraph"},{"code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"title":"Family","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","type":"topic","navigatorTitle":[{"text":"Family","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/firebladeecs\/family",