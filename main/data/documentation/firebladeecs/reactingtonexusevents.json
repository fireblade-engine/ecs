{"metadata":{"role":"article","title":"Reacting to Nexus events","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":" reports what happens to its entities, components and families to its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Structural events are always delivered:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","type":"reference","isActive":true},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Value change events are opt-in:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":": a component was set on an entity that already had one of that type."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference","isActive":true},{"text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","type":"reference","isActive":true},{"text":" is the number of components the pass could write.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Subscribing","text":"Subscribing"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents"},{"text":" is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural"},{"text":" by default. Return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all"},{"text":" to receive value changes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","isActive":true},{"text":" is an open protocol and later releases add events. Always switch with a ","type":"text"},{"type":"codeVoice","code":"default:"},{"type":"text","text":" case."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The nexus reads "},{"type":"codeVoice","code":"subscribedEvents"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"type":"codeVoice","code":"nexus.delegate = observer"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true,"type":"reference"},{"text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Cost","level":3,"anchor":"Cost"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}]},{"type":"heading","text":"Ordering","level":3,"anchor":"Ordering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"text":" and then ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference"},{"text":". Setting a component the entity does not have yet delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only, never "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":" to delegates that subscribed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"type":"text","text":"."}]},{"anchor":"Comparison-with-flecs","type":"heading","text":"Comparison with flecs","level":3},{"type":"paragraph","inlineContent":[{"text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every ","type":"text"},{"code":"set","type":"codeVoice"},{"text":" and on an explicit ","type":"text"},{"code":"modified()","type":"codeVoice"},{"text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"FirebladeECS differs on purpose: in-place writes through the nexus emit ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true,"type":"reference"},{"text":" automatically, so there is no ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call to forget, and setting a missing component emits ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"text":" only.","type":"text"}]}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask/structural":{"title":"structural","url":"\/documentation\/firebladeecs\/nexuseventmask\/structural","ro