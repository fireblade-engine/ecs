{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexussnapshot"]}],"metadata":{"title":"NexusSnapshot","symbolKind":"struct","externalID":"s:12FirebladeECS13NexusSnapshotV","modules":[{"name":"FirebladeECS"}],"roleHeading":"Structure","navigatorTitle":[{"text":"NexusSnapshot","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}]},"seeAlsoSections":[{"generated":true,"title":"Snapshots","anchor":"Snapshots","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceError"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/FirebladeECS\/s8CopyableP","doc:\/\/FirebladeECS\/SE","doc:\/\/FirebladeECS\/s9EscapableP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","interfaceLanguage":"swift"},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Member"],"generated":true},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/entityIdGenerator","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/members"],"anchor":"Instance-Properties"},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"]},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Encodable-Implementations"],"anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"An encodable view of the entities of a nexus and their serializable components."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}],"languages":["swift"]}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The encoded form starts with the ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","isActive":true,"type":"reference"},{"text":" and lists all entities in ascending identifier order,","type":"text"},{"text":" ","type":"text"},{"text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"entityIdGenerator","type":"codeVoice"},{"type":"text","text":" is present if the generator of the nexus is a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"type":"text","text":" is present for entities that share a component instance with an entity listed before them."},{"type":"text","text":" "},{"type":"text","text":"Components are values since 2.0, so snapshots never write it; it is still read from older data."},{"type":"text","text":" "},{"type":"text","text":"It maps the component type name to the identifier of the entity that encodes the instance."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"1: Entities and their components."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2: Adds "},{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sharedComponents"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation."},{"type":"text","text":" "},{"type":"text","text":"The generator state lists recycled identifiers as "},{"type":"codeVoice","code":"recycledIds"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never used for entities, s