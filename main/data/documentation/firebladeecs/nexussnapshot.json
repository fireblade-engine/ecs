{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The encoded form starts with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","type":"reference"},{"text":" and lists all entities in ascending identifier order,","type":"text"},{"text":" ","type":"text"},{"text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference"},{"text":":","type":"text"}]},{"syntax":"json","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"entityIdGenerator","type":"codeVoice"},{"type":"text","text":" is present if the generator of the nexus is a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"type":"text","text":" is present for entities that share a component instance with an entity listed before them."},{"type":"text","text":" "},{"type":"text","text":"Components are values since 2.0, so snapshots never write it; it is still read from older data."},{"type":"text","text":" "},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Version history:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2: Adds ","type":"text"},{"code":"entityIdGenerator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sharedComponents","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation."},{"type":"text","text":" "},{"type":"text","text":"The generator state lists recycled identifiers as "},{"type":"codeVoice","code":"recycledIds"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot","type":"text"},{"text":" ","type":"text"},{"text":"gets a fresh identifier when the snapshot is r