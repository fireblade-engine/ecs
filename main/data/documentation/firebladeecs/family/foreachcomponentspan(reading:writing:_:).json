,"kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"kind":"keyword","text":"rethrows"}],"symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MutableSpan","preciseIdentifier":"s:s11MutableSpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"code":"body","type":"codeVoice"},{"type":"text","text":" receives a "},{"code":"Span","type":"codeVoice"},{"type":"text","text":" of the read type and an "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"code":"MutableSpan","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}]},{"type":"codeListing","syntax":"swift","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"type":"heading","text":"Batches","anchor":"Batches","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"code":"body","type":"codeVoice"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"type":"text","text":" "},{"type":"text","text":"the family and has members, in table creation order. Entities with the same component set form one batch, however"},{"type":"text","text":" "},{"type":"text","text":"the component set came about, and a family whose members have several component sets gets several calls."}]},{"type":"heading","text":"Rules","anchor":"Rules","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"code":"body","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Span","type":"codeVoice"},{"type":"text","text":" is "},{"code":"~Escapable","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","type":"reference"},{"type":"text","text":": structural changes, reading a"},{"type":"text","text":" "},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"type":"text","text":" "},{"type":"text","text":"type) stop the process with a message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":" receives one "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference"},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}],"type":"paragraph"}],"name":"Complexity"}]}],"sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"abstract":[{"type":"text","text":"Iterates the members of this family in batches, giving "},{"type":"codeVoice","code":"body"},{"type":"text","text":" the components of a batch as contiguous spans."}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"type":"topic","url":"\/documentation\/firebladeecs\/family","navigatorTitle":[{"kind":"identifier","text":"Family"}],"title":"Family","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask/valueChanges":{"kind":"symbol","title":"valueChanges","abstract":[{"type":"text","text":"Changes of component values: "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"valueChanges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS14NexusEventMaskV","text":"NexusEventMask"}],"url":"\/documentation\/firebladeecs\/nexuseventmask\/valuechanges","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:_:)":{"kind":"symbol","title":"forEach(reading:writing:_:)","abstract":[{"type":"text","text":"Iterates the members of this family, reading some of their components and changing others in place."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"