{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"text":" ","type":"text"},{"text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so all nexuses of a process agree on it. Indices are dense (","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"type":"text","text":" "},{"type":"text","text":"use "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","type":"reference","isActive":true},{"type":"text","text":" for persistent data."}],"type":"paragraph"},{"inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro will) as a stored ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"code":"0 ..< 1_048_576","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type.","type":"text"},{"text":" ","type":"text"},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(1)","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"sections":[],"metadata":{"role":"symbol","symbolKind":"property","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"componentIndex","kind":"identifier"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","modules":[{"name":"FirebladeECS"}],"roleHeading":"Type Property","extendedModule":"FirebladeECS","title":"componentIndex"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","url":"\/documentation\/firebladeecs\/component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"abstract":[{"inlineContent":[{"text":"Component","type":"text"}],"type":"strong"}],"role":"symbol","title":"Component","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"role":"symbol","url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","title":"componentIndex","abstract":[{"text":"The dense index of this component type.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"role":"collection","title":"FirebladeECS","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},{"type":"text","text":"."}],"kind":"symbol","title":"stableIdentifier","role":"symbol","type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"kind":"symbol","title":"componentTypeName","role":"symbol","required":true,"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","defaultImplementations":1},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","url":"\/documentation\/firebladeecs\/nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol","title":"Nexus","type":"topic"}}}