{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"type","content":[{"inlineContent":[{"type":"text","text":"The component type."}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"type":"text","text":"Receives the span; its result is returned."}],"type":"paragraph"}]}],"kind":"parameters"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"type":"text","text":"removed. It is zero copy: it views the storage itself. Because "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":", it cannot leave "},{"type":"codeVoice","code":"body"},{"type":"text","text":" "},{"type":"text","text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle."}],"type":"paragraph"},{"syntax":"swift","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"type":"codeListing"},{"inlineContent":[{"code":"Span","type":"codeVoice"},{"type":"text","text":" is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":": loop over "},{"code":"indices","type":"codeVoice"},{"type":"text","text":". Element access is bounds checked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While "},{"code":"body","type":"codeVoice"},{"type":"text","text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or"},{"type":"text","text":" "},{"type":"text","text":"removing components, replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":") and writes to the type stop the process with a message,"},{"type":"text","text":" "},{"type":"text","text":"since they would move or change what the span views. Reading the component through the nexus and reading"},{"type":"text","text":" "},{"type":"text","text":"the type again are fine. Collect changes and apply them after the call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An empty storage (or a type no entity ever had) passes an empty span."}],"type":"paragraph"},{"text":"Storage","type":"heading","anchor":"Storage","level":3},{"inlineContent":[{"text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself.","type":"text"},{"text":" ","type":"text"},{"text":"The archetype storage keeps one column per table (one table per component set), so entities with different","type":"text"},{"text":" ","type":"text"},{"text":"component sets are not next to each other. If one table holds all components of the type the span views its column,","type":"text"},{"text":" ","type":"text"},{"text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs","type":"text"},{"text":" ","type":"text"},{"text":"one allocation and O(N) copying per call and is released after ","type":"text"},{"code":"body","type":"codeVoice"},{"text":". Use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","type":"reference"},{"text":" to get zero copy spans, one batch per table.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) plus "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}]}],"type":"aside","name":"Complexity","style":"note"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Gives "},{"code":"body","type":"codeVoice"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Instance Method","role":"symbol","externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","modules":[{"name":"FirebladeECS"}],"title":"componentSpan(reading:_:)","platforms":[{"name":"iOS","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"visionOS"},{"unavailable":false,"deprecated":false,"introducedAt":"26.0","beta":false,"name":"watchOS"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"}],"extendedModule":"FirebladeECS"},"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","kind":"symbol","abs