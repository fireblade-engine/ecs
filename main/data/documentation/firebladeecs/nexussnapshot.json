{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"NexusSnapshot"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","type":"reference","isActive":true},{"type":"text","text":" and lists all entities in ascending identifier order,"},{"type":"text","text":" "},{"type":"text","text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" is present if the generator of the nexus is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"type":"text","text":" is present for entities that share a component instance with an entity listed before them."},{"type":"text","text":" "},{"type":"text","text":"Components are values since 2.0, so snapshots never write it; it is still read from older data."},{"type":"text","text":" "},{"type":"text","text":"It maps the component type name to the identifier of the entity that encodes the instance."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"1: Entities and their components."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2: Adds "},{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sharedComponents"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation."},{"type":"text","text":" "},{"type":"text","text":"The generator state lists recycled identifiers as "},{"type":"codeVoice","code":"recycledIds"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"text","text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot"},{"type":"text","text":" "},{"text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"All other entities keep their identifiers."}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceError"],"generated":true,"title":"Snapshots","anchor":"Snapshots"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexussnapshot"]}],"metadata":{"modules":[{"name":"FirebladeECS"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"NexusSnapshot"}],"role":"symbol","title":"NexusSnapshot","roleHeading":"Structure","externalID":"s:12FirebladeECS13NexusSnapshotV"},"abstract":[{"type":"text","text":"An encodable view of the entities of a nexus and their serializable components."}],"sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Member"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/entityIdGenerator","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/members"],"generated":true},{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Encodable-I