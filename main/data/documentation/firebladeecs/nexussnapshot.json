"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusSnapshot"}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"},{"type":"text","text":" and lists all entities in ascending identifier order,"},{"type":"text","text":" "},{"type":"text","text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"]},{"items":[{"content":[{"inlineContent":[{"code":"entityIdGenerator","type":"codeVoice"},{"text":" is present if the generator of the nexus is a ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"type":"text","text":" is present for entities that share a component instance with an entity listed before them."},{"type":"text","text":" "},{"type":"text","text":"Components are values since 2.0, so snapshots never write it; it is still read from older data."},{"type":"text","text":" "},{"type":"text","text":"It maps the component type name to the identifier of the entity that encodes the instance."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1: Entities and their components."}]}]},{"content":[{"inlineContent":[{"text":"2: Adds ","type":"text"},{"code":"entityIdGenerator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sharedComponents","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"code":"recycledIds","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot","type":"text"},{"text":" ","type":"text"},{"text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"All other entities keep their identifiers."}],"type":"paragraph"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"NexusSnapshot"}],"symbolKind":"struct","role":"symbol","modules":[{"name":"FirebladeECS"}],"externalID":"s:12Firebl