{"sections":[],"metadata":{"role":"article","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","title":"Generating components with the component macro"},"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The optional ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" product provides the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Protocol"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generated"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enables"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"stable "},{"type":"codeVoice","code":"componentTypeName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"encode(to:)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"nexus.encodeSnapshot(using:handling:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.restoreSnapshot(from:using:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.decodeSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Nexus: Codable"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true}]}],[{"inlineContent":[{"type":"codeVoice","code":"componentProperties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init()"},{"text":" if every stored property has a default value (structs)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"key path assignment, state machines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}],"type":"paragraph"}],[{"inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}]},{"anchor":"Adding-the-product","level":3,"type":"heading","text":"Adding the product"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target. It does not re-export "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":": add the "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" product too and import both modules in every file that uses "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"anchor":"Declaring-components","level":3,"type":"heading","text":"Declaring components"},{"syntax":"swift","type":"codeListing","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"type":"codeVoice","code":"static let componentTypeName"},{"text":" to override it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"text":" takes a ","type":"text"},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"text":" set: ","type":"text"},{"type":"codeVoice","code":".cloneable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".serializable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".inspectable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".defaultInit"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"package"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" itself, and it gets ","type":"text"},{"type":"codeVoice","code":"DefaultInitializable"},{"text":" only if it declares ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The macro stores ","type":"text"},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"type":"codeVoice","code":"componentIndex"},{"text":" to opt out.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Value-types-and-diagnostics","level":3,"type":"heading","text":"Value types and diagnostics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component"},{"type":"text","text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set<Entity>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Key: Entity]"},{"type":"text","text":" is an error with a fix-it that replaces "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" by "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":". An "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference","isActive":true},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}]},{"anchor":"Registering-cloning-and-snapshots","level":3,"type":"heading","text":"Registering, cloning and snapshots"},{"syntax":"swift","type":"codeListing","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference","isActive":true},{"type":"text","text":" starts with a "},{"type":"codeVoice","code":"formatVersion"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","type":"reference","isActive":true},{"type":"text","text":", and rejects snapshots written in a newer format version."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/componentmacro"]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent":{"abstract":[{"type":"text","text":"A component type that can be registered in the component registry of a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent","navigatorTitle":[{"text":"RegistrableComponent","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegistrableComponent","kind":"identifier"}],"title":"RegistrableComponent"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","url":"\/documentation\/firebladeecs\/choosingastorage","type":"topic","kind":"article","title":"Choosing a storage","role":"article","abstract":[{"text":"Pick the sparse-set or the archetype storage for a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"text":", and know what changes.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"url":"\/documentation\/firebladeecs\/component","abstract":[{"inlineContent":[{"text":"Component","type":"text"}],"type":"strong"}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"symbol","role":"symbol","title":"Component","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"navigatorTitle":