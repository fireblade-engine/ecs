{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"metadata":{"role":"symbol","externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","modules":[{"name":"FirebladeECS"}],"title":"componentSpan(reading:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"}],"platforms":[{"deprecated":false,"introducedAt":"26.0","name":"iOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"macOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"tvOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"visionOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"watchOS","unavailable":false,"beta":false}],"roleHeading":"Instance Method","extendedModule":"FirebladeECS","symbolKind":"method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"body","kind":"internalParam"},{"kind":"text","text":": ("},{"preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type.","type":"text"}]}],"name":"type"},{"content":[{"inlineContent":[{"text":"Receives the span; its result is returned.","type":"text"}],"type":"paragraph"}],"name":"body"}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"type":"text","text":"removed. It is zero copy: it views the storage itself. Because "},{"code":"Span","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":", it cannot leave ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" ","type":"text"},{"text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Span","type":"codeVoice"},{"type":"text","text":" is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":": loop over "},{"code":"indices","type":"codeVoice"},{"type":"text","text":". Element access is bounds checked."}]},{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or","type":"text"},{"text":" ","type":"text"},{"text":"removing components, replacing a component with ","type":"text"},{"code":"set","type":"codeVoice"},{"text":") and writes to the type stop the process with a message,","type":"text"},{"text":" ","type":"text"},{"text":"since they would move or change what the span views. Reading the component through the nexus and reading","type":"text"},{"text":" ","type":"text"},{"text":"the type again are fine. Collect changes and apply them after the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An empty storage (or a type no entity ever had) passes an empty span.","type":"text"}]},{"type":"heading","text":"Storage","anchor":"Storage","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself."},{"type":"text","text":" "},{"type":"text","text":"The archetype storage keeps one column per table (one table per component set), so entities with different"},{"type":"text","text":" "},{"type":"text","text":"component sets are not next to each other. If one table holds all components of the type the span views its column,"},{"type":"text","text":" "},{"type":"text","text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs"},{"type":"text","text":" "},{"type":"text","text":"one allocation and O(N) copying per call and is released after "},{"code":"body","type":"codeVoice"},{"type":"text","text":". Use"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)"},{"text":" to get zero copy spans, one batch per table.","type":"text"}]},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) plus "},{"code":"body","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"}]}],"abstract":[{"type":"text","text":"Gives "},{"type":"codeVoice","code":"body"},{"text":" read access to all components of a type as one contiguous ","type":"text"},{"type":"codeVoice","code":"Span"},{"text":".","type":"text"}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","title":"Migrating to FirebladeECS 2","kind":"article","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"kind":"symbol","title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEachComponentSpan(reading:_:)":{"conformance":{"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:_:)","abstract":[{"text":"Iterates the members of this family in batches, reading 1 and writing 0 component types as contiguous spans.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, ("},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text