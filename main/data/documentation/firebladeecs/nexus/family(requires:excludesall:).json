g","level":2},{"type":"paragraph","inlineContent":[{"text":"The family of entities having 1 required components each.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 1 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"type":"codeVoice","code":"LazySequenceProtocol"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"General usage","type":"text"}]}]},{"syntax":"swift","type":"codeListing","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Caveats","type":"text"}]}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Component types must be unique per family"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"O(1) for existi