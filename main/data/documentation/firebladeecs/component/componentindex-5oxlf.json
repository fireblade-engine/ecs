{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"text":" ","type":"text"},{"text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so all nexuses of a process agree on it. Indices are dense (","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true},{"text":" for persistent data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro will) as a stored ","type":"text"},{"type":"codeVoice","code":"static let"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type.","type":"text"},{"text":" ","type":"text"},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(1)","type":"text"}]}],"name":"Complexity"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"]}],"metadata":{"modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","symbolKind":"property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","title":"componentIndex","roleHeading":"Type Property","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","type":"topic","title":"stableIdentifier","role":"symbol","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true},{"type":"text","text":"."}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus","navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}],"title":"Nexus"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs","role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","kind":"symbol","role":"symbol","title":"componentTypeName","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"defaultImplementations":1,"required":true},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"url":"\/documentation\/firebladeecs\/component","abstract":[{"inlineContent":[{"text":"Component","type":"text"}],"type":"strong"}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"symbol","role":"symbol","title":"Component","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"navigatorTitle":[{"kind":"identifier","text":"Component"}]},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","abstract":[{"type":"text","text":"The dense index of this component type."}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","kind":"symbol","role":"symbol","title":"componentIndex","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}}}