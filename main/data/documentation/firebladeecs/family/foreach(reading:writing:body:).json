d":"keyword","text":"rethrows"}],"extendedModule":"FirebladeECS"},"abstract":[{"text":"Iterates the members of this family with any number of read and written component types.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rTypes"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wTypes"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" (repeat each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"), repeat each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"text":" ","kind":"text"},{"kind":"keyword","text":"where"},{"text":" repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"kind":"text","text":", repeat each "}