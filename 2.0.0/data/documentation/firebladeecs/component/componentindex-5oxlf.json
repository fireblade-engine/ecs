{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"extendedModule":"FirebladeECS","role":"symbol","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","modules":[{"name":"FirebladeECS"}],"roleHeading":"Type Property","title":"componentIndex","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"symbolKind":"property"},"kind":"symbol","abstract":[{"type":"text","text":"The dense index of this component type."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"componentIndex"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default implementation assigns indices lazily: the first access of a type takes the next free index"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"code":"0 ..< n","type":"codeVoice"},{"type":"text","text":" for "},{"code":"n","type":"codeVoice"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true},{"type":"text","text":" for persistent data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static."},{"type":"text","text":" "},{"type":"text","text":"Provide your own implementation (the "},{"code":"@Component","type":"codeVoice"},{"type":"text","text":" macro will) as a stored "},{"code":"static let","type":"codeVoice"},{"type":"text","text":" for a plain load,"},{"type":"text","text":" "},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"code":"0 ..< 1_048_576","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1)"}]}],"name":"Complexity"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","title":"Nexus","abstract":[],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}],"url":"\/documentation\/firebladeecs\/nexus"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"kind":"symbol","required":true,"role":"symbol","defaultImplementations":1,"abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","title":"componentTypeName","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The dense index of this component type."}],"title":"componentIndex","role":"symbol","url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf"},"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"url":"\/documentation\/firebladeecs"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","kind":"typeIdentifier","text":"StableComponentIdentifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true},{"type":"text","text":"."}],"title":"stableIdentifier","role":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"url":"\/documentation\/firebladeecs\/component","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"navigatorTitle":[{"kind":"identifier","text":"Component"}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","title":"Component","role":"symbol"}}}