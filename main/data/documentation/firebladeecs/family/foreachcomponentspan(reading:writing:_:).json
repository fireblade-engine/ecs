,{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"role":"symbol","symbolKind":"method","extendedModule":"FirebladeECS","modules":[{"name":"FirebladeECS"}]},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:s11MutableSpanV","kind":"typeIdentifier","text":"MutableSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","text":"Component"}]}],"kind":"declarations"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"type":"codeVoice","code":"body"},{"type":"text","text":" receives a "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" of the read type and an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableSpan"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}],"type":"paragraph"},{"code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Batches","type":"heading","level":3,"text":"Batches"},{"inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"type":"codeVoice","code":"body"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"type":"text","text":" "},{"type":"text","text":"the family and has members, in table creation order. Entities with the same component set form one batch, however"},{"type":"text","text":" "},{"type":"text","text":"the component set came about, and a family whose members have several component sets gets several calls."}],"type":"paragraph"},{"anchor":"Rules","type":"heading","level":3,"text":"Rules"},{"inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"type":"codeVoice","code":"body"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","type":"reference"},{"type":"text","text":": structural changes, reading a"},{"type":"text","text":" "},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"type":"text","text":" "},{"type":"text","text":"type) stop the process with a message."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":" receives one "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference"},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"abstract":[{"type":"text","text":"Iterates the members of this family in batches, giving "},{"code":"body","type":"codeVoice"},{"type":"text","text":" the components of a batch as contiguous spans."}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":", and know what changes."}],"title":"Choosing a storage","kind":"article","role":"article","url":"\/documentation\/firebladeecs\/choosingastorage","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"title":"Migrating to FirebladeECS 2","type":"topic","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","role":"article","kind":"article","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEachComponentSpan(reading:writing:_:)":{"title":"forEachComponentSpan(reading:writing:_:)","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","type":"topic","url":"\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"each C","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Component","type":"codeVoice"},{"type":"text","text":"."}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": ","k