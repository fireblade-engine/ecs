{"kind":"symbol","abstract":[{"text":"Iterates the members of this family, reading some of their components and changing others in place.","type":"text"}],"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to read."}]}],"name":"rType1"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to change in place."}]}],"name":"wType1"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called once per member."}]}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]},{"inlineContent":[{"type":"text","text":"Access is declared like the "},{"type":"codeVoice","code":"in"},{"type":"text","text":" and "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" term modifiers of flecs queries"},{"type":"text","text":" "},{"type":"text","text":"(“Access modifiers” in "},{"type":"reference","identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true},{"type":"text","text":"), whose "},{"type":"codeVoice","code":"each"},{"type":"text","text":" callbacks take "},{"type":"codeVoice","code":"const T&"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"type":"codeVoice","code":"T&"},{"type":"text","text":" for writes: here the labels "},{"type":"codeVoice","code":"reading:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"writing:"},{"type":"text","text":" state it."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every read and written type must be a required component of this family, not an excluded one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"text":" ","type":"text"},{"text":"(for example ","type":"text"},{"code":"entity.get(_:)","type":"codeVoice"},{"text":") traps, too.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":", one "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference"},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}]}]}],"type":"unorderedList"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}],"type":"paragraph"}],"name":"Complexity","style":"note"}]}],"metadata":{"role":"symbol","externalID":"s:12FirebladeECS6FamilyV7forEach7reading7writing_yqd__m_qd_0_myqd___qd_0_ztKXEtKAA9ComponentRd__AaGRd_0_r0_lF","extendedModule":"FirebladeECS","symbolKind":"method","roleHeading":"Instance Method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"forEach(reading:writing:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"modules":[{"name":"FirebladeECS"}]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentReplaced":{"role":"symbol","url":"\/documentation\/firebladeecs\/componentreplaced","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComponentReplaced"}],"kind":"symbol","navigatorTitle":[{"text":"ComponentReplaced","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"topic","abstract":[{"text":"Event triggered when a component is set on an entity that already has a component of that type.","type":"text"}],"title":"ComponentReplaced"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"title":"Reading and writing components","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","kind":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}]},"doc://FirebladeECS/documentation/FirebladeECS/Family":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"}],"title":"Family","role":"symbol","navigatorTitle":[{"text":"Family","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","url":"\/documentation\/firebladeecs\/family","type":"topic","kind":"symbol","abstract":[{"text":"A group of entities that share a common set of component types.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentModified":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ComponentModified"}],"title":"ComponentModified","role":"symbol","navigatorTitle":[{"text":"ComponentModified","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","url":"\/documentation\/firebladeecs\/componentmodified","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Event triggered after a component of one entity was changed in place."}]},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"title":"Migrating to FirebladeECS 2","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","type":"topic","kind":"article","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","t