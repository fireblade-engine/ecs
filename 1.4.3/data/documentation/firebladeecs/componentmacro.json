 or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","final class RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"type":"text","text":" takes a "},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"type":"text","text":" set: "},{"type":"codeVoice","code":".cloneable"},{"type":"text","text":", "},{"type":"codeVoice","code":".serializable"},{"type":"text","text":", "},{"type":"codeVoice","code":".inspectable"},{"type":"text","text":" and "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":". Registration is always implemented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members 