{"sections":[],"kind":"article","metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","title":"Reacting to Nexus events","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Structural events are always delivered:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","isActive":true}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value change events are opt-in:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true,"type":"reference"},{"text":": a component was set on an entity that already had one of that type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference"},{"text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","type":"reference"},{"text":" is the number of components the pass could write.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Every event names its entity with the generational ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true},{"text":", so a stale identifier never matches a later entity in the same slot.","type":"text"}]},{"type":"heading","level":3,"text":"Subscribing","anchor":"Subscribing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference","isActive":true},{"type":"text","text":" is "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" by default. Return "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference","isActive":true},{"type":"text","text":" to receive value changes:"}]},{"type":"codeListing","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent"},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" case."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The nexus reads "},{"type":"codeVoice","code":"subscribedEvents"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"type":"codeVoice","code":"nexus.delegate = observer"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}],"type":"paragraph"}]}]},{"anchor":"Cost","text":"Cost","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created.","type":"text"}]},{"anchor":"Ordering","text":"Ordering","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true},{"type":"text","text":" and then "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"type":"text","text":". Setting a component the entity does not have yet delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only, never "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":" to delegates that subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":"."}]},{"text":"Comparison with flecs","level":3,"anchor":"Comparison-with-flecs","type":"heading"},{"inlineContent":[{"text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every ","type":"text"},{"code":"set","type":"codeVoice"},{"text":" and on an explicit ","type":"text"},{"code":"modified()","type":"codeVoice"},{"text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"FirebladeECS differs on purpose: in-place writes through the nexus emit ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"text":" automatically, so there is no ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call to forget, and setting a missing component emits ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":" only.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Benchmarks":{"role":"article","kind":"article","abstra