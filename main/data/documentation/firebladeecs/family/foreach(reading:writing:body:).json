ations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" (repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"), repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier"},{"text":", repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the fallback for more than 4 read or 4 written types; fewer are served by the overloads with fixed arity,"},{"type":"text","text":" "},{"type":"text","text":"which are faster because their loop specializes. The contract is the one of those overloads (see"},{"type":"text","text":" "},{"type":"text","text":"the overload that reads 1 and writes 1 type), with two differences in shape:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the written components first, as one "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" tuple, then the read components. Swift can not"},{"type":"text","text":" "},{"type":"text","text":"express "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" pack parameters in a closure, and two packs in one closure type can not be inferred."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written components are copied out of the storage into the tuple and back after "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returned, so a"},{"type":"text","text":" "},{"type":"text","text":"write is not visible in the storage before "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns."}]}]}]},{"code":["family.forEach(reading: A.self, B.self, C.self, D.self, E.self, writing: X.self, Y.self) { (written: inout (X, Y), a, b, c, d, e) in","    written.0.value += a.value","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"TypeSubstituter.transformPackElementType","type":"codeVoice"},{"type":"text","text":")."}]},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineC