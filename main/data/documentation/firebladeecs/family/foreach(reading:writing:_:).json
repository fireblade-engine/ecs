{"abstract":[{"type":"text","text":"Iterates the members of this family, reading some of their components and changing others in place."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"]}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"roleHeading":"Instance Method","title":"forEach(reading:writing:_:)","modules":[{"name":"FirebladeECS"}],"symbolKind":"method","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"each C","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Component","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"extendedModule":"FirebladeECS","externalID":"s:12FirebladeECS6FamilyV7forEach7reading7writing_yqd__m_qd_0_myqd___qd_0_ztKXEtKAA9ComponentRd__AaGRd_0_r0_lF","role":"symbol"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type to read."}],"type":"paragraph"}],"name":"rType1"},{"content":[{"inlineContent":[{"type":"text","text":"The component type to change in place."}],"type":"paragraph"}],"name":"wType1"},{"content":[{"inlineContent":[{"type":"text","text":"Called once per member."}],"type":"paragraph"}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"code":"body","type":"codeVoice"},{"text":" receives the read components first (as copies), then the written ones as ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". The writes land","type":"text"},{"text":" ","type":"text"},{"text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a","type":"text"},{"text":" ","type":"text"},{"text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs","type":"text"},{"text":" ","type":"text"},{"text":"a plain loop over the members: no allocation and no dynamic dispatch per member.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]},{"type":"paragraph","inlineContent":[{"text":"Access is declared like the ","type":"text"},{"type":"codeVoice","code":"in"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true,"type":"reference"},{"text":"), whose ","type":"text"},{"type":"codeVoice","code":"each"},{"text":" callbacks take ","type":"text"},{"type":"codeVoice","code":"const T&"},{"text":" ","type":"text"},{"text":"for reads and ","type":"text"},{"type":"codeVoice","code":"T&"},{"text":" for writes: here the labels ","type":"text"},{"type":"codeVoice","code":"reading:"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"writing:"},{"text":" state it.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":", one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"text":" ","type":"text"},{"text":"including the one that threw, stay changed and the events cover them.","type":"text"}]}]}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentReplaced":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComponentReplaced","kind":"identifier"}],"title":"ComponentReplaced","url":"\/documentation\/firebladeecs\/componentreplaced","role":"symbol","navigatorTitle":[{"text":"ComponentReplaced","kind":"identifier"}],"abstract":[{"text":"Event triggered when a component is set on an entity that already has a component of that type.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"url":"\/documentation\/firebladeecs\/readingandwritingcomponents","title":"Reading and writing components","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"role":"article","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}],"kind":"article","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","title":"Migrating to FirebladeECS 2","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"kind":"externalParam","text":"writing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"url":"\/documentation\/firebladeecs\/family\