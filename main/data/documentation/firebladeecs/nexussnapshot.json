{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/FirebladeECS\/s8CopyableP","doc:\/\/FirebladeECS\/SE","doc:\/\/FirebladeECS\/s9EscapableP"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexussnapshot"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"An encodable view of the entities of a nexus and their serializable components."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The encoded form starts with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","type":"reference"},{"text":" and lists all entities in ascending identifier order,","type":"text"},{"text":" ","type":"text"},{"text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"],"type":"codeListing","syntax":"json"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"text":" is present if the generator of the nexus is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sharedComponents"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Version history:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2: Adds ","type":"text"},{"type":"codeVoice","code":"entityIdGenerator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sharedComponents"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"type":"codeVoice","code":"recycledIds"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot","type":"text"},{"text":" ","type":"text"},{"text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier.","type":"text"},{"text":" ","type":"text"},{"text":"All other entities keep their identifiers.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Structure","symbolKind":"struct","role":"symbol","externalID":"s:12FirebladeECS13NexusSnapshotV","title":"NexusSnapshot","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusSnapshot","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"NexusSnapshot"}]},"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Member"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/entityIdGenerator","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/members"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Encodable-Implementations"]}],"seeAlsoSections":[{"generated":true,"title":"Snapshots","anchor":"Snapshots","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","doc:\/\/Fir