":"identifier"}],"abstract":[{"type":"text","text":"An encodable view of the entities of a nexus and their serializable components."}],"role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/DefaultInitializable":{"url":"\/documentation\/firebladeecs\/defaultinitializable","title":"DefaultInitializable","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","navigatorTitle":[{"kind":"identifier","text":"DefaultInitializable"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultInitializable"}],"abstract":[{"text":"Requires initializer with default values.","type":"text"},{"text":" ","type":"text"},{"text":"In case of component - makes sure it can be instantiated by component provider","type":"text"}],"role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent":{"abstract":[{"text":"A component type that can be registered in the component registry of a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"text":".","type":"text"}],"title":"RegistrableComponent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","role":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent","navigatorTitle":[{"text":"RegistrableComponent","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegistrableComponent","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"title":"NexusEventDelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","role":"symbol","url":"\/documentation\/firebladeecs\/nexuseventdelegate","navigatorTitle":[{"text":"NexusEvent