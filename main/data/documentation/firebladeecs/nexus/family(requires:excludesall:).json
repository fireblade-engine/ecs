ap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"type":"codeVoice","code":"LazySequenceProtocol"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"General usage","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"]},{"inlineContent":[{"inlineContent":[{"text":"Caveats","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Component types must be unique per family","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Complexity","content":[{"inlineContent":[{"text":"O(1) for existing families, O(N) where N is the number of entities for new families.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"abstract":[{"type":"text","text":"Create a family of entities (aka members) having 1 required components."}],"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","title":"Family","url":"\/documentation\/firebladeecs\/family","role":"symbol","navigatorTitle":[{"text":"Family","kind":"identifier"}],"abstract":[{"ty