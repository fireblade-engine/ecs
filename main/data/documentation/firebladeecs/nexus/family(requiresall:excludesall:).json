tent","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General usage"}]}],"type":"paragraph"},{"syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self)","\/\/ iterate each entity's components","family.forEach { (comp1: Comp1, comp2: Comp2) in","  ...","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"Caveats","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Component types must be unique per family","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}],"type":"unorderedList"},{"name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","url":"\/documentation