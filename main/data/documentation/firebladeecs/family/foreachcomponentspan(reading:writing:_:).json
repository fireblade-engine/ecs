":[{"code":"each C","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"modules":[{"name":"FirebladeECS"}]},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Iterates the members of this family in batches, giving "},{"type":"codeVoice","code":"body"},{"type":"text","text":" the components of a batch as contiguous spans."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Reads 1 and writes 1 component type: ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" receives a "},{"code":"Span","type":"codeVoice"},{"text":" of the read type and an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MutableSpan"},{"text":" ","type":"text"},{"text":"of the written type. Within one call all spans have the same count and the same order: element ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" of every","type":"text"},{"text":" ","type":"text"},{"text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the","type":"text"},{"text":" ","type":"text"},{"text":"family.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"level":3,"type":"heading","text":"Batches","anchor":"Batches"},{"type":"paragraph","inlineContent":[{"text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a","type":"text"},{"text":" ","type":"text"},{"text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is","type":"text"},{"text":" ","type":"text"},{"text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved","type":"text"},{"text":" ","type":"text"},{"text":"array. Entities that were created together and never had components removed form one big batch; after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"code":"body","type":"codeVoice"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}]},{"type":"paragraph","inlineContent":[{"text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches","type":"text"},{"text":" ","type":"text"},{"text":"the family and has members, in table creation order. Entities with the same component set form one batch, however","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the component set came about, and a family whose members have several component sets gets several calls."}]},{"text":"Rules","anchor":"Rules","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"type":"codeVoice","code":"body"},{"type":"text","text":" ("},{"code":"Span","type":"codeVoice"},{"type":"text","text":" is "},{"code":"~Escapable","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","type":"reference"},{"text":": structural changes, reading a","type":"text"},{"text":" ","type":"text"},{"text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written","type":"text"},{"text":" ","type":"text"},{"text":"type) stop the process with a message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A delegate subscribed to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":" receives one ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"text":"and call, not one event per batch.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"name":"Complexity"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask/valueChanges":{"abstract":[{"type":"text","text":"Changes of component values: "},{"identifie