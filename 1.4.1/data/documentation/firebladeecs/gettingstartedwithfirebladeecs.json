{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"text":").","type":"text"},{"type":"text","text":" "},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" file or use it to create a new project.","type":"text"}],"type":"paragraph"},{"code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"1.2.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"text":" ","type":"text"},{"text":"For a more detailed example, see the ","type":"text"},{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","type":"heading","level":3},{"inlineContent":[{"text":"The core element in the Fireblade ECS is the ","type":"text"},{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"code":"Entities","type":"codeVoice"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"text":"You may use more than one ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Initialize a ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}],"type":"paragraph"},{"code":["let nexus = Nexus()"],"type":"codeListing","syntax":"swift"},{"text":"👤 Entities","anchor":"%F0%9F%91%A4-Entities","type":"heading","level":3},{"inlineContent":[{"text":"then create entities by letting the ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" generate them.","type":"text"}],"type":"paragraph"},{"code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To define components, conform your class to the ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":" protocol","type":"text"}],"type":"paragraph"},{"code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"and assign instances of it to an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" with","type":"text"}],"type":"paragraph"},{"code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}],"type":"paragraph"},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing","syntax":"swift"},{"text":"👪 Families","anchor":"%F0%9F%91%AA-Families","type":"heading","level":3},{"inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"same component types"}]},{"text":" may belong to one ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":" has entities as members and component types as family traits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Create a family by calling ","type":"text"},{"type":"codeVoice","code":".family"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PlayerInput"},{"text":" component, but no ","type":"text"},{"type":"codeVoice","code":"Texture"},{"text":" component is created by","type":"text"}],"type":"paragraph"},{"code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"These entities are cached in the nexus for efficient access and iteration.","type":"text"},{"text":" ","type":"text"},{"text":"Families conform to the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"reference","isActive":true},{"text":" protocol so that members (components)","type":"text"},{"text":" ","type":"text"},{"text":"may be iterated and accessed like any other sequence in Swift.","type":"text"},{"text":"\n","type":"text"},{"text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call ","type":"text"},{"type":"codeVoice","code":"family.entityAndComponents"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"type":"codeVoice","code":"family.entities"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"🧑 Singles","anchor":"%F0%9F%A7%91-Singles","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Single"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" entity with exactly "},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference","isActive":true},{"type":"text","text":" character. Single components must conform to the "},{"type":"codeVoice","code":"SingleComponent"},{"type":"text","text":" protocol and will not be available through regular family iteration."}],"type":"paragraph"},{"code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing","syntax":"swift"},{"text":"🔗 Serialization","anchor":"%F0%9F%94%97-Serialization","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}],"type":"paragraph"},{"code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"]}],"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","title":"Getting started with Fireblade ECS","modules":[{"name":"FirebladeECS"}]},"sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"kind":"article","references":{"https://github.com/fireblade-engine/ecs-demo":{"url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","title":"Fireblade ECS Demo App","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}]},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","titleInlineContent":[{"text":"Singleton","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"url":"\/documentation\/firebladeecs\/savingandloadingscenes","title":"Saving and Loading Scenes","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","abstract":[{"type":"text","text":"Store a whole "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS":{"url":"\/documentation\/firebladeecs","title":"FirebladeECS","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"role":"collection","kind":"symbol"},"https://developer.apple.com/documentation/swift/sequence":{"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","titleInlineContent":[{"text":"Sequence","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"title":"Generating components with the component macro","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","role":"article","url":"\/documentation\/firebladeecs\/componentmacro","type":"topic","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"title":"NexusEventDelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","role":"symbol","url":"\/documentation\/firebladeecs\/nexuseventdelegate","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"url":"\/documentation\/firebladeecs\/nexusevent","title":"NexusEvent","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","navigatorTitle":[{"text":"NexusEvent","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}],"abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"role":"symbol","kind":"symbol"},"https://en.wiktionary.org/wiki/nexus#Noun":{"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","titleInlineContent":[{"text":"Nexus","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol","kind":"symbol"},"https://en.wikipedia.org/wiki/Entity_component_system":{"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","titleInlineContent":[{"text":"ECS","type":"text"}]}}}