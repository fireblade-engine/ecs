{"abstract":[{"type":"text","text":"Create a family of entities (aka members) having 1 required components."}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"comp","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"excludedComponents","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":".Type...) -> ","kind":"text"},{"text":"Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type required by members of this family."}]}],"name":"comp"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}]}],"name":"excludedComponents"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The family of entities having 1 required components each."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the 1 required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."},{"type":"text","text":" "},{"type":"text","text":"A family conforms to the "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":" and therefore can be accessed like any other (lazy) sequence."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General usage"}]}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caveats"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Component types must be unique per family"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Component type order is arbitrary"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}]}],"name":"Complexity"}]}],"metadata":{"externalID":"s:12FirebladeECS5NexusC6family8requires11excludesAllAA6FamilyVyx_QPGxm_AA9Component_pXpdtAaJRzlF","symbolKind":"method","extendedModule":"FirebladeECS","roleHeading":"Instance Method","title":"family(requires:excludesAll:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":".Type...) -> ","kind":"text"},{"text":"Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","modules":[{"name":"FirebladeECS"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requires:excludesAll:)"},"sections":[],"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"type":"topic","url":"\/documentation\/firebladeecs","title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS