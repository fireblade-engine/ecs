each.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 1 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"General usage","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"syntax":"swift"},{"inlineContent":[{"inlineContent":[{"text":"Caveats","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Component types must be unique per family","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}],"type":"aside",