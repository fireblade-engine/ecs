{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Reacting to Nexus events","modules":[{"name":"FirebladeECS"}],"role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Structural events are always delivered:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved"}]}]}]},{"inlineContent":[{"type":"text","text":"Value change events are opt-in:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":": a component was set on an entity that already had one of that type."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"type":"text","text":": a component of one entity was changed in place."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count"},{"type":"text","text":" is the number of components the pass could write."}]}]}]},{"inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Subscribing","text":"Subscribing"},{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference","isActive":true},{"type":"text","text":" is "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" by default. Return "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference","isActive":true},{"type":"text","text":" to receive value changes:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent"},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The nexus reads "},{"type":"codeVoice","code":"subscribedEvents"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"type":"codeVoice","code":"nexus.delegate = observer"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural"},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}]}]}]},{"type":"heading","level":3,"anchor":"Cost","text":"Cost"},{"inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Ordering","text":"Ordering"},{"inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" and then "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":". Setting a component the entity does not have yet delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only, never "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":" to delegates that subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Comparison-with-flecs","text":"Comparison with flecs"},{"inlineContent":[{"type":"text","text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every "},{"code":"set","type":"codeVoice"},{"type":"text","text":" and on an explicit "},{"code":"modified()","type":"codeVoice"},{"type":"text","text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"FirebladeECS differs on purpose: in-place writes through the nexus emit "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":" automatically, so there is no "},{"code":"modified()","type":"codeVoice"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"]}],"kind":"article","abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"type":"topic","kind":"articl