ing","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The read components are passed as copies, the written ones are changed in place in the nexus (see"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity\/modify(_:_:)","type":"reference"},{"type":"text","text":"): "},{"code":"body","type":"codeVoice"},{"type":"text","text":" receives the read components first, then the written ones as "},{"code":"inout","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Nothing runs if the entity lacks one of the components. A "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference"},{"type":"text","text":" event is delivered for each"},{"type":"text","text":" "},{"type":"text","text":"written component. The written types must differ from each other, else the access traps. Overloads exist for"},{"type":"text","text":" "},{"type":"text","text":"0 to 4 read and 0 to 4 written types, and a parameter pack overload covers more."}]},{"type":"codeListing","syntax":"swift","code":["entity.components(Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]}]}],"sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity\/components(_:writing:_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/firebladeecs\/entity\/components(_:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity"]]},"abstract":[{"type":"text","text":"Changes components of this entity in place, reading others."}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"identifier":"doc:\/\/Fireblade