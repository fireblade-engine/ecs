maVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Iterates the members of this family, reading some of their components and changing others in place."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to read.","type":"text"}]}],"name":"rType1"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to change in place."}]}],"name":"wType1"},{"name":"body","content":[{"inlineContent":[{"type":"text","text":"Called once per member."}],"type":"paragraph"}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"text":" ","type":"text"},{"text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs","type":"text"},{"text":" ","type":"text"},{"text":"a plain loop over the members: no allocation and no dynamic dispatch per member.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]},{"type":"paragraph","inlineContent":[{"text":"Access is declared like the ","type":"text"},{"type":"codeVoice","code":"in"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true,"type":"reference"},{"text":"), whose ","type":"text"},{"type":"codeVoice","code":"each"},{"text":" callbacks take ","type":"text"},{"type":"codeVoice","code":"const T&"},{"text":" ","type":"text"},{"text":"for reads and ","type":"text"},{"type":"codeVoice","code":"T&"},{"text":" for writes: here the labels ","type":"text"},{"type":"codeVoice","code":"reading:"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"writing:"},{"text":" state it.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Every read and written type must be a required component of this family, not an excluded one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The written types must be pairwise different and different from the read types, and a pass must not nest","type":"text"},{"text":" ","type":"text"},{"text":"a write access to a type that an enclosing pass or ","type":"text"},{"code":"modify","type":"codeVoice"},{"text":" writes. Violations trap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"code":"body","type":"codeVoice"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"code":"set","type":"codeVoice"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"text":" ","type":"text"},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"type":"text","text":", one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"text":"is delivered after the pass, not one per member. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" throws, the pass ends there, members already visited,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}]}]}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask/valueChanges":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valueChanges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"NexusEventMask","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS14NexusEventMaskV"}],"title":"valueChanges","url":"\/documentation\/firebladeecs\/nexuseventmask\/valuechanges","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChange