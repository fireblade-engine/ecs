bladeECS\/SavingAndLoadingScenes","type":"topic","role":"article","url":"\/documentation\/firebladeecs\/savingandloadingscenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}],"title":"Saving and Loading Scenes","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","type":"topic","role":"article","url":"\/documentation\/firebladeecs\/componentmacro","abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"title":"Generating components with the component macro","kind":"article"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"type":"link","titleInlineContent":[{"type":"text","text":"Singleton"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"title":"Nexus","type":"topic","url":"\/documentation\/firebladeecs\/nexus","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","abstract":[],"role":"symbol"},"https://en.wiktionary.org/wiki/nexus#Noun":{"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","titleInlineContent":[{"type":"text","text":"Nexus"}],"title":"Nexus","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"}}}