{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Iterates the members of this family with any number of read and written component types.","type":"text"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"R"},{"kind":"text","text":", each "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rTypes"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wTypes"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" (repeat each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"), repeat each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This is the fallback for more than 4 read or 4 written types; fewer are served by the overloads with fixed arity,"},{"type":"text","text":" "},{"type":"text","text":"which are faster because their loop specializes. The contract is the one of those overloads (see"},{"type":"text","text":" "},{"type":"text","text":"the overload that reads 1 and writes 1 type), with two differences in shape:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the written components first, as one "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" tuple, then the read components. Swift can not"},{"type":"text","text":" "},{"type":"text","text":"express "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" pack parameters in a closure, and two packs in one closure type can not be inferred."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written components are copied out of the storage into the tuple and back after "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returned, so a"},{"type":"text","text":" "},{"type":"text","text":"write is not visible in the storage before "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns."}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["family.forEach(reading: A.self, B.self, C.self, D.self, E.self, writing: X.self, Y.self) { (written: inout (X, Y), a, b, c, d, e) in","    written.0.value += a.value","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"TypeSubstituter.transformPackElementType","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)"]}],"metadata":{"symbolKind":"method","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"each C","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Component","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" (repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier