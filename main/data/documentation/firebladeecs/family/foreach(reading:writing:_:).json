ch(reading:writing:_:)"]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to read.","type":"text"}]}],"name":"rType1"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to change in place.","type":"text"}]}],"name":"wType1"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Called once per member.","type":"text"}]}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"code":"body","type":"codeVoice"},{"text":" receives the read components first (as copies), then the written ones as ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". The writes land","type":"text"},{"text":" ","type":"text"},{"text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a","type":"text"},{"text":" ","type":"text"},{"text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs","type":"text"},{"text":" ","type":"text"},{"text":"a plain loop over the members: no allocation and no dynamic dispatch per member.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"syntax":"swift"},{"inlineContent":[{"text":"Access is declared like the ","type":"text"},{"code":"in","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"},{"text":"), whose ","type":"text"},{"code":"each","type":"codeVoice"},{"text":" callbacks take ","type":"text"},{"code":"const T&","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for reads and ","type":"text"},{"code":"T&","type":"codeVoice"},{"text":" for writes: here the labels ","type":"text"},{"code":"reading:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"writing:","type":"codeVoice"},{"text":" state it.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The written types must be pairwise different and different from the read types, and a pass must not nest","type":"text"},{"text":" ","type":"text"},{"text":"a write access to a type that an enclosing pass or ","type":"text"},{"type":"codeVoice","code":"modify"},{"text":" writes. Violations trap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"While ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"type":"codeVoice","code":"set"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"text":"changed values through the ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" parameters. Reading a written type through the nexus","type":"text"},{"text":" ","type":"text"},{"text":"(for example ","type":"text"},{"type":"codeVoice","code":"entity.get(_:)"},{"text":") traps, too.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the","type":"text"},{"text":" ","type":"text"},{"text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If the delegate subscribed to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":", one ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"text":" event per written type","type":"text"},{"text":" ","type":"text"},{"text":"is delivered after the pass, not one per member. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" throws, the pass ends there, members already visited,","type":"text"},{"text":" ","type":"text"},{"text":"including the one that threw, stay changed and the events cover them.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"type":"aside","style":"note","name":"Complexity"}]}],"kind":"symbol","sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"url":"\/documentation\/firebladeecs\/family","abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Family"}],"type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","kind":"symbol","title":"Family","navigatorTitle":[{"kind":"identifier","text":"Family"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"url":"\/documentation\/fi