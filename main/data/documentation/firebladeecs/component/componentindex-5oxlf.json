{"abstract":[{"type":"text","text":"The dense index of this component type."}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"text":" ","type":"text"},{"text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so all nexuses of a process agree on it. Indices are dense (","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true,"type":"reference"},{"text":" for persistent data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro will) as a stored ","type":"text"},{"type":"codeVoice","code":"static let"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1)"}]}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"componentIndex","modules":[{"name":"FirebladeECS"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","symbolKind":"property","role":"symbol","roleHeading":"Type Property","extendedModule":"FirebladeECS"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[],"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"required":true,"url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentTypeName","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"componentTypeName","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"topic","defaultImplementations":1},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"role":"symbol","abstract":[{"text":"The stable identifier of this component type, derived from ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stableIdentifier","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier","kind":"typeIdentifier"}],"title":"stableIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","navigatorTitle":[{"text":"Component","kind":"identifier"}],"title":"Component","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/component","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"abstract":[{"type":"text","text":"The dense index of this component type."}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"componentIndex","url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","kind":"symbol","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs","role":"collection"}}}