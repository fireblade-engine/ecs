"identifier"}],"kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","abstract":[{"type":"text","text":"The storage a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" keeps its entities and components in."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"kind":"symbol","title":"Nexus.StorageKind","role":"symbol","url":"\/documentation\/firebladeecs\/nexus\/storagekind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"type":"topic","kind":"article","title":"Generating components with the component macro","role":"article","url":"\/documentation\/firebladeecs\/componentmacro"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","abstract":[{"type":"text","text":"Store a whole "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"type":"topic","kind":"article","title":"Saving and Loading Scenes","role":"article","url":"\/documentation\/firebladeecs\/savingandloadingscenes"},"https://en.wiktionary.org/wiki/nexus#Noun":{"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","titleInlineContent":[{"text":"Nexus","type":"text"}],"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","title":"Nexus"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"type":"topic","kind":"article","title":"Reading and writing components","role":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents"}}}