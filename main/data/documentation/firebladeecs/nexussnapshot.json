{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/FirebladeECS\/s8CopyableP","doc:\/\/FirebladeECS\/SE","doc:\/\/FirebladeECS\/s9EscapableP"],"type":"conformsTo"}],"abstract":[{"text":"An encodable view of the entities of a nexus and their serializable components.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusSnapshot"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"},{"type":"text","text":" and lists all entities in ascending identifier order,"},{"type":"text","text":" "},{"type":"text","text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"],"syntax":"json","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"text":" is present if the generator of the nexus is a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sharedComponents"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"1: Entities and their components.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2: Adds ","type":"text"},{"type":"codeVoice","code":"entityIdGenerator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sharedComponents"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"type":"codeVoice","code":"recycledIds"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"tex