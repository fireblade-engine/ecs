{"metadata":{"roleHeading":"Article","role":"article","title":"Generating components with the component macro","modules":[{"name":"FirebladeECS"}]},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"variants":[{"paths":["\/documentation\/firebladeecs\/componentmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The optional ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" product provides the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"code":"struct","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Protocol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enables","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"encode(to:)"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.encodeSnapshot(using:handling:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.restoreSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.decodeSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Nexus: Codable","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true,"type":"reference"}]}],[{"inlineContent":[{"code":"componentProperties","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init()"},{"text":" if every stored property has a default value (structs)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"key path assignment, state machines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}],"type":"paragraph"},{"text":"Adding the product","level":3,"anchor":"Adding-the-product","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the product to your target. It does not re-export "},{"code":"FirebladeECS","type":"codeVoice"},{"type":"text","text":": add the "},{"code":"FirebladeECS","type":"codeVoice"},{"type":"text","text":" product too and import both modules in every file that uses "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"syntax":"swift"},{"type":"heading","text":"Declaring components","anchor":"Declaring-components","level":3},{"type":"codeListing","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}]}]},{"content":[{"inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" leaves serialization entirely to you.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"package","type":"codeVoice"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" itself, and it gets ","type":"text"},{"code":"DefaultInitializable","type":"codeVoice"},{"text":" only if it declares ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The macro stores "},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"type":"codeVoice","code":"componentIndex"},{"type":"text","text":" to opt out."}],"type":"paragraph"}]}]},{"anchor":"Value-types-and-diagnostics","level":3,"text":"Value types and diagnostics","type":"heading"},{"inlineContent":[{"code":"@Component","type":"codeVoice"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set<Entity>"},{"type":"text","text":" or "},{"code":"[Key: Entity]","type":"codeVoice"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"type":"text","text":". An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity"},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}],"type":"paragraph"},{"anchor":"Registering-cloning-and-snapshots","level":3,"type":"heading","text":"Registering, cloning and snapshots"},{"code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},{"type":"text","text":" starts with a "},{"code":"formatVersion","type":"codeVoice"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver"},{"type":"text","text":", and rejects snapshots written in a newer format version."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","navigatorTitle":[{"text":"Component","kind":"identifier"}],"title":"Component","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/component","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The kinds of events a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"reference","isActive":true},{"type":"text","text":" subscribes to."}],"navigatorTitle":[{"text":"NexusEventMask","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexuseventmask","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventMask","kind":"identifier"}],"title":"NexusEventMask","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/EntityIdentifier":{"title":"EntityIdentifier","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"EntityIdentifier"}]}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","navigatorTitle":[{"kind":"identifier","text":"EntityIdentifier"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityIdentifier