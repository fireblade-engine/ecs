{"abstract":[{"text":"Create a family of entities (aka members) having 1 required components.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"comp","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"excludedComponents","kind":"internalParam"},{"text":": any ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":".Type...) -> ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","text":"Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Component type required by members of this family."}],"type":"paragraph"}],"name":"comp"},{"content":[{"inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}],"type":"paragraph"}],"name":"excludedComponents"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The family of entities having 1 required components each.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 1 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"General usage"}],"type":"strong"}],"type":"paragraph"},{"code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Component types must be unique per family","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}],"type":"aside","name":"Complexity"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requires:excludesAll:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","metadata":{"title":"family(requires:excludesAll:)","modules":[{"name":"FirebladeECS"}],"role":"symbol","symbolKind":"method","externalID":"s:12FirebladeECS5NexusC6family8requires11excludesAllAA6FamilyVyx_QPGxm_AA9Component_pXpdtAaJRzlF","roleHeading":"Instance Method","extendedModule":"FirebladeECS","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":".Type...) -> ","kind":"text"},{"text":"Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"fragments":[{"text":"class","kind":"