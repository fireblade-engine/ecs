omponents and changing others in place."}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"W1"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"W1"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to read.","type":"text"}]}],"name":"rType1"},{"name":"wType1","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to change in place."}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called once per member."}]}]}],"kind":"parameters"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}]},{"code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access is declared like the "},{"type":"codeVoice","code":"in"},{"type":"text","text":" and "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" term modifiers of flecs queries"},{"type":"text","text":" "},{"type":"text","text":"(“Access modifiers” in "},{"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","type":"reference","isActive":true},{"type":"text","text":"), whose "},{"type":"codeVoice","code":"each"},{"type":"text","text":" callbacks take "},{"type":"codeVoice","code":"const T&"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"type":"codeVoice","code":"T&"},{"type":"text","text":" for writes: here the labels "},{"type":"codeVoice","code":"reading:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"writing:"},{"type":"text","text":" state it."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The written types must be pairwise different and different from the read types, and a pass must not nest","type":"text"},{"text":" ","type":"text"},{"text":"a write access to a type that an enclosing pass or ","type":"text"},{"type":"codeVoice","code":"modify"},{"text":" writes. Violations trap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"type":"codeVoice","code":"set"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":", one "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference","isActive":true},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"style":"note","name":"Complexity"}]}],"references":{"https://github.com/SanderMertens/flecs/blob/master/docs/Queries.md":{"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","titleInlineContent":[{"type":"text","text":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"}],"type":"link","url":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","title":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"url":"\/documentation\/firebladeecs\/reading