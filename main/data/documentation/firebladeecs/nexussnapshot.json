entifier","text":"NexusSnapshot"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","type":"reference"},{"type":"text","text":" and lists all entities in ascending identifier order,"},{"type":"text","text":" "},{"type":"text","text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"],"syntax":"json"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"text":" is present if the generator of the nexus is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sharedComponents"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Version history:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2: Adds ","type":"text"},{"type":"codeVoice","code":"entityIdGenerator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sharedComponents"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"type":"codeVoice","code":"recycledIds"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"text","text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot"},{"type":"text","text":" "},{"type":"text","text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier."},{"type":"text","text":" "},{"type":"text","text":"All other entities keep their identifiers."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexussnapshot"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Fireblade