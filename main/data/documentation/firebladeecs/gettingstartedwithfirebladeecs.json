{"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}],"type":"paragraph"},{"inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" file or use it to create a new project.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""],"type":"codeListing"},{"inlineContent":[{"text":"Coming from FirebladeECS 1? Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"type":"reference","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"type":"codeVoice","code":"Entities"},{"text":" at a time.","type":"text"},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}]},{"type":"codeListing","code":["let nexus = Nexus()"],"syntax":"swift"},{"text":"👤 Entities","type":"heading","level":3,"anchor":"%F0%9F%91%A4-Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"type":"codeListing","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"code":"Component","type":"codeVoice"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}]},{"type":"codeListing","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign values of it to an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}]},{"type":"codeListing","code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}]},{"type":"codeListing","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"syntax":"swift"},{"text":"👪 Families","type":"heading","level":3,"anchor":"%F0%9F%91%AA-Families"},{"type":"paragraph","inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"inlineContent":[{"text":"same component types","type":"text"}],"type":"strong"},{"text":" may belong to one ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":" has entities as members and component types as family traits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"type":"codeVoice","code":".family"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PlayerInput"},{"type":"text","text":" component, but no "},{"type":"codeVoice","code":"Texture"},{"type":"text","text":" component is created by"}]},{"code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"type":"codeVoice","code":"forEach(reading:writing:)"},{"type":"text","text":", see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"},{"type":"text","text":"."},{"type":"text","text":"\n"},{"text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call ","type":"text"},{"code":"family.entityAndComponents","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"type":"codeVoice","code":"family.entities"},{"text":".","type":"text"}]},{"syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"🧑 Singles","anchor":"%F0%9F%A7%91-Singles","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Single","type":"codeVoice"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference","isActive":true},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing"},{"level":3,"text":"🔗 Serialization","anchor":"%F0%9F%94%97-Serialization","type":"heading"},{"inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing"}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"FirebladeECS"}],"title":"Getting started with Fireblade ECS","role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://en.wikipedia.org/wiki/Entity_component_system":{"type":"link","title":"ECS","titleInlineContent":[{"text":"ECS","type":"text"}],"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},"https://github.com/fireblade-engine/ecs-demo":{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","title":"Fireblade ECS Demo App","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}]},"https://developer.apple.com/documentation/swift/sequence":{"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","titleInlineContent":[{"text":"Sequence","type":"text"}],"title":"Sequence"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"url":"\/documentation\/firebladeecs\/componentmacro","title":"Generating components with the component macro"},"https://en.wiktionary.org/wiki/nexus#Noun":{"type":"link","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","titleInlineContent":[{"text":"Nexus","type":"text"}],"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus"},"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"title":"FirebladeECS","url":"\/documentation\/firebladeecs"},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"url":"\/documentation\/firebladeecs\/reactingtonexusevents","title":"Reacting to Nexus events"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"url":"\/documentation\/firebladeecs\/nexusevent","abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"topic","kind":"symbol","title":"NexusEvent","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"kind":"symbol","title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","abstract":[{"text":"Store a whole ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}],"title":"Saving and Loading Scenes","url":"\/documentation\/firebladeecs\/savingandloadingscenes"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","title":"Migrating to FirebladeECS 2","kind":"article","type":"topic"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"type":"link","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","titleInlineContent":[{"type":"text","text":"Singleton"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"title":"Nexus.StorageKind","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","url":"\/documentation\/firebladeecs\/nexus\/storagekind","abstract":[{"type":"text","text":"The storage a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" keeps its entities and components in."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}]},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"url":"\/documentation\/firebladeecs\/choosingastorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":", and know what changes."}],"type":"topic","role":"article","kind":"article","title":"Choosing a storage","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"url":"\/documentation\/firebladeecs\/nexuseventmask","abstract":[{"text":"The kinds of events a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"reference","isActive":true},{"text":" subscribes to.","type":"text"}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","navigatorTitle":[{"text":"NexusEventMask","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventMask","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"NexusEventMask"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","abstract":[{"text":"Read a copy, replace a component or change it in place.","type":"text"}],"url":"\/documentation\/firebladeecs\/readingandwritingcomponents","type":"topic","title":"Reading and writing components","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"url":"\/documentation\/firebladeecs\/nexuseventdelegate","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","title":"NexusEventDelegate","type":"topic","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"role":"symbol"}}}