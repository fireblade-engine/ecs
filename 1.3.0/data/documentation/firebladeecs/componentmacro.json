{"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article","title":"Generating components with the component macro"},"kind":"article","sections":[],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" product provides the "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" macro."},{"type":"text","text":" "},{"type":"text","text":"It turns a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"stable "},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.register(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.registeredComponentTypes","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.componentType(named:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"init(cloning:context:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"clone(context:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"entity.clone()","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.clone(entities:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.clone(into:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"encode(to:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.encodeSnapshot(using:handling:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.restoreSnapshot(from:using:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"nexus.decodeSnapshot(from:using:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"Nexus: Codable","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"componentProperties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"init()","type":"codeVoice"},{"type":"text","text":" if every stored property has a default value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"key path assignment, state machines"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}]},{"type":"heading","text":"Adding the product","anchor":"Adding-the-product","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target. It re-exports "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [.product(name: \"FirebladeECSMacros\", package: \"ecs\")])"]},{"type":"heading","text":"Declaring components","anchor":"Declaring-components","level":3},{"type":"codeListing","syntax":"swift","code":["import FirebladeECSMacros","","@Component","final class Transform: @unchecked Sendable {","    var position: SIMD3<Float> = .zero","    var parent: Entity?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","final class RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generated initializers are designated initializers, so the class no longer gets an implicit ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":". Keep ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":" enabled or declare your own initializers.","type":"text"}]}]}]},{"type":"heading","text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots","level":3},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true},{"type":"text","text":" starts with a "},{"type":"codeVoice","code":"formatVersion"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true},{"type":"text","text":", and rejects snapshots written in a newer format version."}]}]}],"variants":[{"paths":["\/documentation\/firebladeecs\/componentmacro"],"traits"