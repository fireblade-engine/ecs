{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Gives "},{"code":"body","type":"codeVoice"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"}],"role":"symbol","platforms":[{"introducedAt":"26.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"26.0","name":"watchOS","deprecated":false,"unavailable":false,"beta":false}],"extendedModule":"FirebladeECS","title":"componentSpan(reading:_:)","modules":[{"name":"FirebladeECS"}],"externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","symbolKind":"method","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"Receives the span; its result is returned."}],"type":"paragraph"}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"type":"text","text":"removed. It is zero copy: it views the storage itself. Because "},{"code":"Span","type":"codeVoice"},{"type":"text","text":" is "},{"code":"~Escapable","type":"codeVoice"},{"type":"text","text":", it cannot leave "},{"code":"body","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle."}]},{"code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Span","type":"codeVoice"},{"type":"text","text":" is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":": loop over "},{"code":"indices","type":"codeVoice"},{"type":"text","text":". Element access is bounds checked."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"code":"body","type":"codeVoice"},{"type":"text","text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or"},{"type":"text","text":" "},{"type":"text","text":"removing components, replacing a component with "},{"code":"set","type":"codeVoice"},{"type":"text","text":") and writes to the type stop the process with a message,"},{"type":"text","text":" "},{"type":"text","text":"since they would move or change what the span views. Reading the component through the nexus and reading"},{"type":"text","text":" "},{"type":"text","text":"the type again are fine. Collect changes and apply them after the call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty storage (or a type no entity ever had) passes an empty span."}]},{"type":"heading","level":3,"text":"Storage","anchor":"Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself."},{"type":"text","text":" "},{"type":"text","text":"The archetype storage keeps one column per table (one table per component set), so entities with different"},{"type":"text","text":" "},{"type":"text","text":"component sets are not next to each other. If one table holds all components of the type the span views its column,"},{"type":"text","text":" "},{"type":"text","text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs"},{"type":"text","text":" "},{"type":"text","text":"one allocation and O(N) copying per call and is released after "},{"code":"body","type":"codeVoice"},{"type":"text","text":". Use"},{"type":"text","text":" "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","type":"reference","isActive":true},{"type":"text","text":" to get zero copy spans, one batch per table."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(1) plus ","type":"text"},{"code":"body","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note","name":"Complexity"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"title":"Component","navigatorTitle":[{"kind":"identifier","text":"Component"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"url":"\/documentation\/firebladeecs\/component","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"title":"Reading and writing components","type":"topic","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","role":"article","kind":"article","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/componentSpan(reading:_:)":{"abstract":[{"type":"text","text":"Gives "},{"code":"body","type":"codeVoice"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"}],"type":"topic","title":"componentSpan(reading:_:)","url":"\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"title":"FirebladeECS","kind":"symbol","role":"collection","url":"\/documentation\/firebladeecs","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":", and know what changes."}],"title":"Choosing a storage","kind":"article","role":"article","url":"\/documentation\/firebladeecs\/choosingastorage","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"title":"Migrating to FirebladeECS 2","type":"topic","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","role":"article","kind":"article","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"title":"Nexus","type":"topic","url":"\/documentation\/firebladeecs\/nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[],"navigatorTitle":[{"text":"Nexus","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEachComponentSpan(reading:_:)":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","title":"forEachComponentSpan(reading:_:)","type":"topic","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"each C"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":".","type":"text"}]},"kind":"symbol","abstract":[{"text":"Iterates the members of this family in batches, reading 1 and writing 0 component types as contiguous spans.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"url":"\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:_:)"}}}