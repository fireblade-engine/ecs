embers of this family.","type":"text"}],"type":"paragraph"}]},{"name":"comp7","content":[{"inlineContent":[{"text":"Component type 7 required by members of this family.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}],"type":"paragraph"}],"name":"excludedComponents"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The family of entities having 7 required components each.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 7 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"General usage","type":"text"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self, Comp3.self, Comp4.self, Comp5.self, Comp6.self, Comp7.self)","\/\/ iterate each entity's components","family.forEach { (comp1, comp2, comp3, comp4, comp5, comp6, comp7) in","  ...","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"Caveats","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Component types must be unique per family","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"O(1) for existing families, O(N) where N is the number of entities for new families.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requiresAll:_:_:_:_:_:_:excludesAll:)"},"abstract":[{"text":"Create a family of entities (aka members) having 7 required components.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/family(requiresall:_:_:_:_:_:_:excludesall:)"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"metadata":{"externalID":"s:12FirebladeECS5NexusC6family11requiresAll______08excludesF0AA6FamilyVyAA9Requires7Vyxq_q0_q1_q2_q3_q4_GGxm_q_mq0_mq1_mq2_mq3_mq4_mAA9Component_pXpdtAaMRzAaMR_AaMR0_AaMR1_AaMR2_AaMR3_AaMR4_r5_lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"family"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Comp1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Comp2"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Comp3"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Comp4"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"