ion/FirebladeECS/Nexus":{"navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"kind":"symbol","type":"topic","abstract":[],"title":"Nexus","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","url":"\/documentation\/firebladeecs\/nexus","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stableIdentifier","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StableComponentIdentifier","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV"}],"kind":"symbol","title":"stableIdentifier","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference"},{"type":"text","text":"."}],"url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"role":"collection","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","title":"FirebladeECS","type":"topic"}}}