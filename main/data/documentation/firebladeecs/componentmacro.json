 by hand without the macro.","type":"text"}]},{"anchor":"Adding-the-product","text":"Adding the product","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":": add the ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":".","type":"text"}]},{"syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"type":"codeListing"},{"anchor":"Declaring-components","text":"Declaring components","level":3,"type":"heading"},{"syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"type":"text","text":" takes a "},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"type":"text","text":" set: "},{"type":"codeVoice","code":".cloneable"},{"type":"text","text":", "},{"type":"codeVoice","code":".serializable"},{"type":"text","text":", "},{"type":"codeVoice","code":".inspectable"},{"type":"text","text":" and "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":". Registration is always implemented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" leaves serialization entirely to you."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A "},{"type":"codeVoice","code":"public"},{"type":"text","text":" or "},{"type":"codeVoice","code":"package"},{"type":"text","text":" struct, and a struct that declares initializers, gets a generated "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" in its body (the implicit "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" itself, and it gets "},{"type":"codeVoice","code":"DefaultInitializable"},{"type":"text","text":" only if it declares "},{"type":"codeVoice","code":"init()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The macro stores "},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"type":"codeVoice","code":"componentIndex"},{"type":"text","text":" to opt out."}],"type":"paragraph"}]}]},{"anchor":"Value-types-and-diagnostics","text":"Value types and diagnostics","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property spelled ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Entity?"},{"text":", ","type":"text"},{"type":"codeVoice","code":"[Entity]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Set<Entity>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[Key: Entity]"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" by ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"text":". An ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference","isActive":true},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}]},{"anchor":"Registering-cloning-and-snapshots","text":"Registering, cloning and snapshots","level":3,"type":"heading"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference","isActive":true},{"text":" starts with a ","type":"text"},{"type":"codeVoice","code":"formatVersion"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documen