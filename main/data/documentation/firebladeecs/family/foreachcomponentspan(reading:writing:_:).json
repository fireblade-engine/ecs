t":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)"},"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableSpan","preciseIdentifier":"s:s11MutableSpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Reads 1 and writes 1 component type: ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" receives a ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" of the read type and an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"code":"MutableSpan","type":"codeVoice"},{"text":" ","type":"text"},{"text":"of the written type. Within one call all spans have the same count and the same order: element ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" of every","type":"text"},{"text":" ","type":"text"},{"text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the","type":"text"},{"text":" ","type":"text"},{"text":"family.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"text":"Batches","anchor":"Batches","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a","type":"text"},{"text":" ","type":"text"},{"text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is","type":"text"},{"text":" ","type":"text"},{"text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved","type":"text"},{"text":" ","type":"text"},{"text":"array. Entities that were created together and never had components removed form one big batch; after","type":"text"},{"text":" ","type":"text"},{"text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case.","type":"text"},{"text":" ","type":"text"},{"text":"Write ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" so that it is correct for any batch size, and do not rely on the number of calls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches","type":"text"},{"text":" ","type":"text"},{"text":"the family and has members, in table creation order. Entities with the same component set form one batch, however","type":"text"},{"text":" ","type":"text"},{"text":"the component set came about, and a family whose members have several component sets gets several calls.","type":"text"}]},{"text":"Rules","anchor":"Rules","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Every type must be a required component of the family. The spans cannot escape ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the pass runs the nexus is locked like in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},{"text":": structural changes, reading a","type":"text"},{"text":" ","type":"text"},{"text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written","type":"text"},{"text":" ","type":"text"},{"text":"type) stop the process with a message.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A delegate subscribed to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":" receives one ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"text":" per written type","type":"text"},{"text":" ","type":"text"},{"text":"and call, not one event per batch.","type":"text"}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"name":"Complexity"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"kind":"symbol","sections":[],"abstract":[{"text":"Iterates the members of this family in batches, giving ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" the components of a batch as contiguous spans.","type":"text"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"url":"\/documentation\/firebladeecs\/readingandwritingcomponents","type":"top