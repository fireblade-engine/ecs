xt":"requiresAll"},{"kind":"text","text":" "},{"kind":"internalParam","text":"componentTypes"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"excludesAll"},{"kind":"text","text":" "},{"kind":"internalParam","text":"excludedComponents"},{"kind":"text","text":": any "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":".Type...) -> "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV","text":"Family"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"componentTypes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types required by members of this family."}]}]},{"name":"excludedComponents","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The family of entities having the required components."}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General usage"}]}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self)","\/\/ iterate each entity's components","family.forEach { (comp1: Comp1, comp2: Comp2) in","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caveats"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Component types must be unique per family"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Component type order is arbitrary"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}]}]}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","abstract":[],"kind":"symbol","type":"topic","url":"\/docume