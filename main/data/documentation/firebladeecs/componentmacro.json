or "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Protocol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enables","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent"}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"type":"codeVoice","code":"componentTypeName"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clone(context:)"}]}],[{"inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.clone(into:)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent"}]}],[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.encodeSnapshot(using:handling:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.restoreSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"text":", ","type":"text"},{"code":"Nexus: Codable","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"componentProperties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable"}],"type":"paragraph"}],[{"inlineContent":[{"code":"init()","type":"codeVoice"},{"text":" if every stored property has a default value (structs)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"key path assignment, state machines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"type":"paragraph"}],[{"inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The core ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" library stays dependency free. Only ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" depends on ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}],"type":"paragraph"},{"text":"Adding the product","level":3,"anchor":"Adding-the-product","type":"heading"},{"inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":": add the ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"text":"Declaring components","level":3,"type":"heading","anchor":"Declaring-components"},{"type":"codeListing","syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" or ","type":"text"},{"code":"package","type":"codeVoice"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" itself, and it gets ","type":"text"},{"type":"codeVoice","code":"DefaultInitializable"},{"text":" only if it declares ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The macro stores ","type":"text"},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"type":"codeVoice","code":"componentIndex"},{"text":" to opt out.","type":"text"}]}]}]},{"anchor":"Value-types-and-diagnostics","level":3,"type":"heading","text":"Value types and diagnostics"},{"inlineContent":[{"type":"codeVoice","code":"@Component"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property spelled ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Entity?"},{"text":", ","type":"text"},{"type":"codeVoice","code":"[Entity]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Set<Entity>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[Key: Entity]"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"text":". An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}],"type":"paragraph"},{"anchor":"Registering-cloning-and-snapshots","level":3,"type":"heading","text":"Registering, cloning and snapshots"},{"code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},{"text":" starts with a ","type":"text"},{"type":"codeVoice","code":"formatVersion"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/SerializableComponent":{"url":"\/documentation\/firebladeecs\/serializablecomponent","abstract":[{"text":"A registrable component that can be encoded and decoded by its stable type name.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerializableComponent","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","kind":"symbol","title":"SerializableComponent","navigatorTitle":[{"text":"SerializableComponent","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/CloneableComponent":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","navigatorTitle":[{"kind":"identifier","text":"CloneableComponent"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloneableComponent"}],"url":"\/documentation\/firebladeecs\/cloneablecomponent","title":"CloneableComponent","abstract":[{"text":"A component that can create a copy of itself for another entity.","type":"text"}],"role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","role":"article","type":"topic","title":"Migrating to FirebladeECS 2"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate"