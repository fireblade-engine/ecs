 generation 0. A slot whose generation reaches "},{"code":"UInt32.max","type":"codeVoice"},{"type":"text","text":" is retired and never provided again."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Furthermore it respects order of entity ids on initialization, meaning the provided ids on initialization will be provided in order"},{"type":"text","text":" "},{"type":"text","text":"until all are in use. After that the free entities start at the lowest available id increasing linearly skipping already in-use entity ids."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/EntityCreated":{"url":"\/documentation\/firebladeecs\/entitycreated","abstract":[{"text":"Event triggered when an entity is created.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCreated","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","kind":"symbol","title":"EntityCreated","navigatorTitle":[{"text":"EntityCreated","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/DefaultEntityIdGenerator":{"url":"\/documentation\/firebladeecs\/defaultentityidgenerator","abstract":[{"text":"A default entity identifier generator implementation.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultEntityIdGenerator"}],"navigatorTitle":[{"kind":"identifier","text":"DefaultEntityIdGenerator"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultEntityIdGenerator","role":"symbol","type":"topic","title":"DefaultEntityIdGenerator"},"doc://FirebladeECS/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/FirebladeECS\/s8SendableP"},"doc://FirebladeECS/documentation/FirebladeECS/LinearIncrementingEntityIdGenerator/Encodable-Implementations":{"identifier":