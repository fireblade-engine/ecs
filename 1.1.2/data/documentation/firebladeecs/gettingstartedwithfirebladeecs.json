{"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article","title":"Getting started with Fireblade ECS"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" file or use it to create a new project."}],"type":"paragraph"},{"code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"0.17.7\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus"},{"inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Initialize a "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" with"}],"type":"paragraph"},{"code":["let nexus = Nexus()"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"👤 Entities","anchor":"%F0%9F%91%A4-Entities"},{"inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}],"type":"paragraph"},{"code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To define components, conform your class to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol"}],"type":"paragraph"},{"code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"and assign instances of it to an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}],"type":"paragraph"},{"code":["let position = Position(x: 1, y: 2)","entity.assign(position)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}],"type":"paragraph"},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"👪 Families","anchor":"%F0%9F%91%AA-Families"},{"inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"inlineContent":[{"text":"same component types","type":"text"}],"type":"strong"},{"text":" may belong to one ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":" has entities as members and component types as family traits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Create a family by calling ","type":"text"},{"code":".family","type":"codeVoice"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PlayerInput","type":"codeVoice"},{"text":" component, but no ","type":"text"},{"code":"Texture","type":"codeVoice"},{"text":" component is created by","type":"text"}],"type":"paragraph"},{"code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"These entities are cached in the nexus for efficient access and iteration.","type":"text"},{"text":" ","type":"text"},{"text":"Families conform to the ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"reference"},{"text":" protocol so that members (components)","type":"text"},{"text":" ","type":"text"},{"text":"may be iterated and accessed like any other sequence in Swift.","type":"text"},{"text":"\n","type":"text"},{"text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call ","type":"text"},{"code":"family.entityAndComponents","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"code":"family.entities","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"🧑 Singles","level":3,"anchor":"%F0%9F%A7%91-Singles","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Single","type":"codeVoice"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"type":"text","text":" entity with exactly "},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference"},{"type":"text","text":" character. Single components must conform to the "},{"code":"SingleComponent","type":"codeVoice"},{"type":"text","text":" protocol and will not be available through regular family iteration."}],"type":"paragraph"},{"syntax":"swift","code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing"},{"text":"🔗 Serialization","level":3,"anchor":"%F0%9F%94%97-Serialization","type":"heading"},{"inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","references":{"https://developer.apple.com/documentation/swift/sequence":{"titleInlineContent":[{"text":"Sequence","type":"text"}],"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence"},"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","title":"FirebladeECS","role":"collection","abstract":[{"text":"Seamlessly, consistently, and asynchronously replicate data.","type":"text"}],"url":"\/documentation\/firebladeecs","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"abstract":[],"url":"\/documentation\/firebladeecs\/nexus","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","title":"Nexus","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","title":"NexusEventDelegate","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}]},"https://github.com/fireblade-engine/ecs-demo":{"titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}],"url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","title":"Fireblade ECS Demo App"},"https://en.wikipedia.org/wiki/Entity_component_system":{"titleInlineContent":[{"text":"ECS","type":"text"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"url":"\/documentation\/firebladeecs\/nexusevent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","title":"NexusEvent","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}]},"https://en.wiktionary.org/wiki/nexus#Noun":{"titleInlineContent":[{"text":"Nexus","type":"text"}],"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"titleInlineContent":[{"text":"Singleton","type":"text"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton"}}}