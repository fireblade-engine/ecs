are be part of this family will have at least the 1 required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}]},{"type":"paragraph","inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."},{"text":" ","type":"text"},{"type":"text","text":"A family conforms to the "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":" and therefore can be accessed like any other (lazy) sequence."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"General usage","type":"text"}]}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caveats"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","role":"collection","title":"FirebladeECS",