":[{"type":"text","text":"EntityIdentifier"}]}],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs\/entityidentifier","navigatorTitle":[{"text":"EntityIdentifier","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityIdentifier","kind":"identifier"}],"title":"EntityIdentifier"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","url":"\/documentation\/firebladeecs\/nexusevent","type":"topic","kind":"symbol","title":"NexusEvent","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"abstract":[{"type":"text","text":"The kinds of events a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","isActive":true},{"type":"text","text":" subscribes to."}],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs\/nexuseventmask","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventMask"}],"title":"NexusEventMask"},"doc://FirebladeECS/documentation/FirebladeECS/GettingStartedWithFirebladeECS":{"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"type":"topic","kind":"article","url":"\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs","role":"article","identifier":"doc:\/\/Fireblad