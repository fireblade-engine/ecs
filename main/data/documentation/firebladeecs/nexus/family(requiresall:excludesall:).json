t":"requiresAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"componentTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"excludedComponents"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":".Type...) -> "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS6FamilyV","text":"Family"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"componentTypes","content":[{"inlineContent":[{"text":"Component types required by members of this family.","type":"text"}],"type":"paragraph"}]},{"name":"excludedComponents","content":[{"inlineContent":[{"text":"All component types that must not be assigned to an entity in this family.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The family of entities having the required components."}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"text":" ","type":"text"},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"General usage","type":"text"}],"type":"strong"}]},{"syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self)","\/\/ iterate each entity's components","family.forEach { (comp1: Comp1, comp2: Comp2) in","  ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Component types must be unique per family"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Component type order is arbitrary"}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Complexity"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"role":"symbol","url":"\/documentation\/firebladeecs\/component","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","title":"Reading and writing components","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","title":"Migrating to FirebladeECS 2","type":"topic","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","kind":"article","role":"article","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"type":"topic","url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"role":"collection","title":"FirebladeECS","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"url":"\/documentation\/firebladeecs","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS"},"doc://FirebladeECS/docum