{"text":"Span","kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MutableSpan","preciseIdentifier":"s:s11MutableSpanV"},{"text":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"kind":"keyword","text":"rethrows"}],"conformance":{"constraints":[{"code":"each C","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"extendedModule":"FirebladeECS","roleHeading":"Instance Method","title":"forEachComponentSpan(reading:writing:_:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"text":"R1","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableSpan","preciseIdentifier":"s:s11MutableSpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Reads 1 and writes 1 component type: ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" receives a ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" of the read type and an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"code":"MutableSpan","type":"codeVoice"},{"text":" ","type":"text"},{"text":"of the written type. Within one call all spans have the same count and the same order: element ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" of every","type":"text"},{"text":" ","type":"text"},{"text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the","type":"text"},{"text":" ","type":"text"},{"text":"family.","type":"text"}]},{"type":"codeListing","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"],"syntax":"swift"},{"type":"heading","text":"Batches","anchor":"Batches","level":3},{"type":"paragraph","inlineContent":[{"text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a","type":"text"},{"text":" ","type":"text"},{"text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is","type":"text"},{"text":" ","type":"text"},{"text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved","type":"text"},{"text":" ","type":"text"},{"text":"array. Entities that were created together and never had components removed form one big batch; after","type":"text"},{"text":" ","type":"text"},{"text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case.","type":"text"},{"text":" ","type":"text"},{"text":"Write ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" so that it is correct for any batch size, and do not rely on the number of calls.","type":"text"}]},{"inlineContent":[{"text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches","type":"text"},{"text":" ","type":"text"},{"text":"the family and has members, in table creation order. Entities with the same component set form one batch, however","type":"text"},{"text":" ","type":"text"},{"text":"the component set came about, and a family whose members have several component sets gets several calls.","type":"text"}],"type":"paragraph"},{"anchor":"Rules","level":3,"text":"Rules","type":"heading"},{"inlineContent":[{"text":"Every type must be a required component of the family. The spans cannot escape ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Span"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"~Escapable"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the pass runs the nexus is locked like in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","type":"reference"},{"text":": structural changes, reading a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"text":" ","type":"text"},{"type":"text","text":"type) stop the process with a message."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":" receives one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":