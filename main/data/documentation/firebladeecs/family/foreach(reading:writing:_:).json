{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"rType1","content":[{"type":"paragraph","inlineContent":[{"text":"The component type to read.","type":"text"}]}]},{"name":"wType1","content":[{"type":"paragraph","inlineContent":[{"text":"The component type to change in place.","type":"text"}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"text":"Called once per member.","type":"text"}]}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}]},{"syntax":"swift","type":"codeListing","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access is declared like the "},{"type":"codeVoice","code":"in"},{"type":"text","text":" and "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" term modifiers of flecs queries"},{"type":"text","text":" "},{"type":"text","text":"(“Access modifiers” in "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"},{"type":"text","text":"), whose "},{"type":"codeVoice","code":"each"},{"type":"text","text":" callbacks take "},{"type":"codeVoice","code":"const T&"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"type":"codeVoice","code":"T&"},{"type":"text","text":" for writes: here the labels "},{"type":"codeVoice","code":"reading:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"writing:"},{"type":"text","text":" state it."}]},{"items":[{"content":[{"inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"code":"set","type":"codeVoice"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"text":"changed values through the ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" parameters. Reading a written type through the nexus","type":"text"},{"text":" ","type":"text"},{"text":"(for example ","type":"text"},{"code":"entity.get(_:)","type":"codeVoice"},{"text":") traps, too.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the","type":"text"},{"text":" ","type":"text"},{"text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If the delegate subscribed to ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true,"type":"reference"},{"text":", one ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true,"type":"reference"},{"text":" event per written type","type":"text"},{"text":" ","type":"text"},{"text":"is delivered after the pass, not one per member. If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" throws, the pass ends there, members already visited,","type":"text"},{"text":" ","type":"text"},{"text":"including the one that threw, stay changed and the events cover them.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"style":"note","type":"aside"}]}],"abstract":[{"text":"Iterates the members of this family, reading some of their components and changing others in place.","type":"text"}],"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Compone