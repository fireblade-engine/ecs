xus/StorageKind":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"type":"topic","abstract":[{"type":"text","text":"The storage a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" keeps its entities and components in."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"url":"\/documentation\/firebladeecs\/nexus\/storagekind","title":"Nexus.StorageKind"},"doc://FirebladeECS/documentation/FirebladeECS/EntityIdentifier":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","abstract":[{"inlineContent":[{"type":"text","text":"EntityIdentifier"}],"type":"strong"}],"type":"topic","navigatorTitle":[{"text":"EntityIdentifier","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/entityidentifier","title":"EntityIdentifier","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityIdentifier","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","url":"\/documentation\/firebladeecs","role":"collection","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Benchmarks":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","title":"Benchmarks","url":"\/documentation\/firebladeecs\/benchmarks","role":"article","abstract":[{"type":"text","text":"See how FirebladeECS revisions compare on a shared workload suite, and run the comparison yourself."}],"kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"iden