ition\": 1 } }","  ]","}"],"syntax":"json"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"text":" is present if the generator of the nexus is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sharedComponents"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Version history:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2: Adds ","type":"text"},{"type":"codeVoice","code":"entityIdGenerator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sharedComponents"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"type":"codeVoice","code":"recycledIds"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never used for entities, so an entity with 