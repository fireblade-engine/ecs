s":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wTypes","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" (repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"), repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":", repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This is the fallback for more than 4 read or 4 written types; fewer are served by the overloads with fixed arity,","type":"text"},{"text":" ","type":"text"},{"text":"which are faster because their loop specializes. The contract is the one of those overloads (see","type":"text"},{"text":" ","type":"text"},{"text":"the overload that reads 1 and writes 1 type), with two differences in shape:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the written components first, as one "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" tuple, then the read components. Swift can not"},{"type":"text","text":" "},{"type":"text","text":"express "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" pack parameters in a closure, and two packs in one closure type can not be inferred."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written components are copied out of the storage into the tuple and back after "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returned, so a"},{"type":"text","text":" "},{"type":"text","text":"write is not visible in the storage before "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns."}]}]}]},{"code":["family.forEach(reading: A.self, B.self, C.self, D.self, E.self, writing: X.self, Y.self) { (written: inout (X, Y), a, b, c, d, e) in","    written.0.value += a.value","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TypeSubstituter.transformPackElementType"},{"text":").","type":"text"}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"name":"Complexity","type":"aside"}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Iterates the members of this family with any number of read and written component types."}],"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"title":"Component","url":"\/documentation\/firebladeecs\/component","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"navigatorTitle":[{"kind":"identifier","text":"Component"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family":{"url":"\/documentation\/firebladeecs\/family","abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"title":"Family","type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"}],"navigatorTitle":[{"text":"Family","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:body:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"