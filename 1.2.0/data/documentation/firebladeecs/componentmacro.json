:"init()","type":"codeVoice"},{"type":"text","text":" if every stored property has a default value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"key path assignment, state machines"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}]},{"type":"heading","text":"Adding the product","anchor":"Adding-the-product","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target. It re-exports "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":"."}]},{"type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [.product(name: \"FirebladeECSMacros\", package: \"ecs\")])"],"syntax":"swift"},{"type":"heading","text":"Declaring components","anchor":"Declaring-components","level":3},{"type":"codeListing","code":["import FirebladeECSMacros","","@Component","final class Transform: @unchecked Sendable {","    var position: SIMD3<Float> = .zero","    var parent: Entity?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","final class RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}],"typ