{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Generating components with the component macro","modules":[{"name":"FirebladeECS"}],"role":"article"},"kind":"article","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" product provides the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"type":"codeVoice","code":"struct"},{"type":"text","text":" or "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Protocol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"stable "},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.register(_:)","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"encode(to:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Nexus: Codable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"componentProperties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init()"},{"type":"text","text":" if every stored property has a default value (structs)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"key path assignment, state machines"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}]}]]]},{"inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}],"type":"paragraph"},{"level":3,"anchor":"Adding-the-product","type":"heading","text":"Adding the product"},{"inlineContent":[{"type":"text","text":"Add the product to your target. It does not re-export "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":": add the "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" product too and import both modules in every file that uses "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"level":3,"anchor":"Declaring-components","type":"heading","text":"Declaring components"},{"syntax":"swift","type":"codeListing","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"package","type":"codeVoice"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":" in its body (the implicit ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" itself, and it gets ","type":"text"},{"code":"DefaultInitializable","type":"codeVoice"},{"text":" only if it declares ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The macro stores ","type":"text"},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"code":"componentIndex","type":"codeVoice"},{"text":" to opt out.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Value-types-and-diagnostics","type":"heading","text":"Value types and diagnostics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component"},{"type":"text","text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set<Entity>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Key: Entity]"},{"type":"text","text":" is an error with a fix-it that replaces "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" by "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference"},{"type":"text","text":". An "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference"},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}]},{"level":3,"anchor":"Registering-cloning-and-snapshots","type":"heading","text":"Registering, cloning and snapshots"},{"syntax":"swift","type":"codeListing","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true,"type":"reference"},{"type":"text","text":" starts with a "},{"type":"codeVoice","code":"formatVersion"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true},{"type":"text","text":", and rejects snapshots written in a newer format version."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/componentmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A component type that can be registered in the component registry of a "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegistrableComponent"}],"navigatorTitle":[{"kind":"identifier","text":"RegistrableComponent"}],"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent","title":"RegistrableComponent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"url":"\/documentation\/firebladeecs\/readingandwritingcomponents","title":"Reading and writing components","type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","kind":"article","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"url":"\/documentation\/firebladeecs\/nexusevent","title":"NexusEvent","type":"topic","abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}]},"d