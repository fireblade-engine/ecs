{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/componentmacro"]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"metadata":{"modules":[{"name":"FirebladeECS"}],"title":"Generating components with the component macro","roleHeading":"Article","role":"article"},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The optional ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" product provides the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"code":"struct","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Protocol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"stable "},{"type":"codeVoice","code":"componentTypeName"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entity.clone()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.clone(entities:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.clone(into:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Nexus: Codable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"componentProperties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"init()","type":"codeVoice"},{"text":" if every stored property has a default value (structs)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"key path assignment, state machines","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}]}],[{"type":"paragraph","inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"The core ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" library stays dependency free. Only ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" depends on ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}]},{"type":"heading","anchor":"Adding-the-product","level":3,"text":"Adding the product"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":": add the ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"text":"Declaring components","type":"heading","level":3,"anchor":"Declaring-components"},{"syntax":"swift","type":"codeListing","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"code":"static let componentTypeName","type":"codeVoice"},{"type":"text","text":" to override it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"text":" takes a ","type":"text"},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"text":" set: ","type":"text"},{"type":"codeVoice","code":".cloneable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".serializable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".inspectable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".defaultInit"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"code":"init(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A "},{"code":"public","type":"codeVoice"},{"type":"text","text":" or "},{"code":"package","type":"codeVoice"},{"type":"text","text":" struct, and a struct that declares initializers, gets a generated "},{"code":"init()","type":"codeVoice"},{"type":"text","text":" in its body (the implicit "},{"code":"init()","type":"codeVoice"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" itself, and it gets "},{"code":"DefaultInitializable","type":"codeVoice"},{"type":"text","text":" only if it declares "},{"code":"init()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The macro stores ","type":"text"},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"code":"componentIndex","type":"codeVoice"},{"text":" to opt out.","type":"text"}],"type":"paragraph"}]}]},{"text":"Value types and diagnostics","type":"heading","level":3,"anchor":"Value-types-and-diagnostics"},{"inlineContent":[{"type":"codeVoice","code":"@Component"},{"type":"text","text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set<Entity>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Key: Entity]"},{"type":"text","text":" is an error with a fix-it that replaces "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" by "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true},{"type":"text","text":". An "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","isActive":true},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}],"type":"paragraph"},{"level":3,"anchor":"Registering-cloning-and-snapshots","type":"heading","text":"Registering, cloning and snapshots"},{"syntax":"swift","type":"codeListing","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","type":"reference"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"type":"paragraph"}]}],"references":{"https://github.com/swiftlang/swift-syntax":{"type":"link","title":"swift-syntax","titleInlineContent":[{"type":"text","text":"swift-syntax"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","url":"https:\/\/github.com\/swiftlang\/swift-syntax"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"url":"\/documentation\/firebladeecs\/nexusevent","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"kind":"symbol","abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","title":"NexusEvent"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"url":"\/documentation\/firebladeecs\/choosingastorage","title":"Choosing a storage","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":", and know what changes."}]},"doc://FirebladeECS/documentation/FirebladeECS/SerializableComponent":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SerializableComponent"}],"title":"SerializableComponent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","url":"\/documentation\/firebladeecs\/s