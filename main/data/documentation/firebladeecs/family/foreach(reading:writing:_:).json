 member."}],"type":"paragraph"}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"code":"body","type":"codeVoice"},{"text":" receives the read components first (as copies), then the written ones as ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". The writes land","type":"text"},{"text":" ","type":"text"},{"text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a","type":"text"},{"text":" ","type":"text"},{"text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs","type":"text"},{"text":" ","type":"text"},{"text":"a plain loop over the members: no allocation and no dynamic dispatch per member.","type":"text"}]},{"type":"codeListing","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Access is declared like the ","type":"text"},{"code":"in","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","type":"reference"},{"text":"), whose ","type":"text"},{"code":"each","type":"codeVoice"},{"text":" callbacks take ","type":"text"},{"code":"const T&","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"for reads and "},{"type":"codeVoice","code":"T&"},{"type":"text","text":" for writes: here the labels "},{"type":"codeVoice","code":"reading:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"writing:"},{"type":"text","text":" state it."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The written types must be pairwise different and different from the read types, and a pass must not nest","type":"text"},{"text":" ","type":"text"},{"text":"a write access to a type that an enclosing pass or ","type":"text"},{"code":"modify","type":"codeVoice"},{"type":"text","text":" writes. Violations trap."}]}]},{"content":[{"inlineContent":[{"text":"While ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"code":"set","type":"codeVoice"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"text":"changed values through the ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" parameters. Reading a written type through the nexus","type":"text"},{"text":" ","type":"text"},{"text":"(for example ","type":"text"},{"code":"entity.get(_:)","type":"codeVoice"},{"text":") traps, too.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the","type":"text"},{"text":" ","type":"text"},{"text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the delegate subscribed to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"text":", one ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"text":" event per written type","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"text":" throws, the pass ends there, members already visited,","type":"text"},{"type":"text","text":" "},{"text":"including the one that threw, stay changed and the events cover them.","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Iterates the members of this family, reading some of their components and changing others in place.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","url":"\/documentation\/firebladeecs","kind":"symbol","role":"collection","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:_:)":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","conformance":{"availabilityPrefix":[{"type":"text"