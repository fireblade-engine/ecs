{"metadata":{"title":"Generating components with the component macro","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The optional ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" product provides the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"code":"struct","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"enum"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Protocol","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}]}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent"}],"type":"paragraph"}],[{"inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Nexus: Codable"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"componentProperties"}]}],[{"inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init()"},{"type":"text","text":" if every stored property has a default value (structs)"}]}],[{"type":"paragraph","inlineContent":[{"text":"key path assignment, state machines","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The core ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" library stays dependency free. Only ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" depends on ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Adding the product","anchor":"Adding-the-product","type":"heading"},{"inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":": add the ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"type":"codeListing"},{"level":3,"text":"Declaring components","anchor":"Declaring-components","type":"heading"},{"syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stable type name defaults to the fully qualified type name. Declare ","type":"text"},{"type":"codeVoice","code":"static let componentTypeName"},{"text":" to override it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"After renaming a persisted type, list its former names in ","type":"text"},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"text":" so existing snapshots keep loading. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"text":" takes a ","type":"text"},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"text":" set: ","type":"text"},{"type":"codeVoice","code":".cloneable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".serializable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".inspectable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".defaultInit"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members you declare yourself are not generated. Declaring any of ","type":"text"},{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"package"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" itself, and it gets ","type":"text"},{"type":"codeVoice","code":"DefaultInitializable"},{"text":" only if it declares ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The macro stores ","type":"text"},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"type":"codeVoice","code":"componentIndex"},{"text":" to opt out.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"Value types and diagnostics","anchor":"Value-types-and-diagnostics","type":"heading"},{"inlineContent":[{"code":"@Component","type":"codeVoice"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property spelled ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Entity?","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[Entity]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Set<Entity>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Key: Entity]","type":"codeVoice"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"text":". An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots","type":"heading"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/F