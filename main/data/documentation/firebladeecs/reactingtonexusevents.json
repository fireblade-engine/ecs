{"metadata":{"role":"article","modules":[{"name":"FirebladeECS"}],"title":"Reacting to Nexus events","roleHeading":"Article"},"sections":[],"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"text":" reports what happens to its entities, components and families to its ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Structural events are always delivered:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","type":"reference","isActive":true}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Value change events are opt-in:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":": a component was set on an entity that already had one of that type."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference","isActive":true},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","type":"reference","isActive":true},{"type":"text","text":" is the number of components the pass could write."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Every event names its entity with the generational ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"text":", so a stale identifier never matches a later entity in the same slot.","type":"text"}],"type":"paragraph"},{"anchor":"Subscribing","level":3,"type":"heading","text":"Subscribing"},{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference","isActive":true},{"text":" is ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"text":" by default. Return ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference","isActive":true},{"text":" to receive value changes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"reference","isActive":true},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The nexus reads "},{"type":"codeVoice","code":"subscribedEvents"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"type":"codeVoice","code":"nexus.delegate = observer"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}]}]}],"type":"unorderedList"},{"anchor":"Cost","level":3,"type":"heading","text":"Cost"},{"inlineContent":[{"text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created.","type":"text"}],"type":"paragraph"},{"anchor":"Ordering","level":3,"type":"heading","text":"Ordering"},{"inlineContent":[{"text":"Modifying a component that is missing, with a default value, delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"text":" and then ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"text":". Setting a component the entity does not have yet delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"text":" only, never ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"text":". Setting a component the entity already has replaces it and delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"text":" to delegates that subscribed to ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Comparison-with-flecs","type":"heading","text":"Comparison with flecs"},{"inlineContent":[{"text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every ","type":"text"},{"type":"codeVoice","code":"set"},{"text":" and on an explicit ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"FirebladeECS differs on purpose: in-place writes through the nexus emit ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"text":" automatically, so there is no ","type":"text"},{"code":"modified()","type":"codeVoice"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus","navigatorTitle":[{"