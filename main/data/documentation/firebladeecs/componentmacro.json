":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"componentProperties"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"init()"},{"type":"text","text":" if every stored property has a default value (structs)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"key path assignment, state machines"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The core ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" library stays dependency free. Only ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" depends on ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}]},{"type":"heading","level":3,"anchor":"Adding-the-product","text":"Adding the product"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":": add the ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Declaring-components","text":"Declaring components"},{"type":"codeListing","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"code":"static let componentTypeName","type":"codeVoice"},{"type":"text","text":" to override it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"type":"text","text":" so existing snapshots keep loading. See "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"type":"text","text":" takes a "},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"type":"text","text":" set: "},{"code":".cloneable","type":"codeVoice"},{"type":"text","text":", "},{"code":".serializable","type":"codeVoice"},{"type":"text","text":", "},{"code":".inspectable","type":"codeVoice"},{"type":"text","text":" and "},{"code":".defaultInit","type":"codeVoice"},{"type":"text","text":". Registration is always implemented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"code":"let","type":"codeVoice"},{"type":"text","text":" constants with an initial value are not serialized."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"code":"CodingKeys","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" leaves serialization entirely to you."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A "},{"code":"public","type":"codeVoice"},{"type":"text","text":" or "},{"code":"package","type":"codeVoice"},{"type":"text","text":" struct, and a struct that declares initializers, gets a generated "},{"code":"init()","type":"codeVoice"},{"type":"text","text":" in its body (the implicit "},{"code":"init()","type":"codeVoice"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" itself, and it gets "},{"code":"DefaultInitializable","type":"codeVoice"},{"type":"text","text":" only if it declares "},{"code":"init()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro stores "},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"code":"componentIndex","type":"codeVoice"},{"type":"text","text":" to opt out."}]}]}]},{"type":"heading","level":3,"anchor":"Value-types-and-diagnostics","text":"Value types and diagnostics"},{"type":"paragraph","inlineContent":[{"code":"@Component","type":"codeVoice"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property spelled ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Entity?","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[Entity]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Set<Entity>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Key: Entity]","type":"codeVoice"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference"},{"text":". An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}]},{"type":"heading","level":3,"anchor":"Registering-cloning-and-snapshots","text":"Registering, cloning and snapshots"},{"type":"codeListing","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","type":"reference"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/componentmacro"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"FirebladeECS"}],"title":"Generating comp