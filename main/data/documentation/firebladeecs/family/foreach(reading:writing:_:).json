{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:12FirebladeECS6FamilyV7forEach7reading7writing_yqd__m_qd_0_myqd___qd_0_ztKXEtKAA9ComponentRd__AaGRd_0_r0_lF","modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"title":"forEach(reading:writing:_:)","role":"symbol","roleHeading":"Instance Method","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"each C","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Component","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"abstract":[{"text":"Iterates the members of this family, reading some of their components and changing others in place.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"rType1","content":[{"type":"paragraph","inlineContent":[{"text":"The component type to read.","type":"text"}]}]},{"name":"wType1","content":[{"type":"paragraph","inlineContent":[{"text":"The component type to change in place.","type":"text"}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"text":"Called once per member.","type":"text"}]}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"code":"body","type":"codeVoice"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"code":"inout","type":"codeVoice"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}]},{"type":"codeListing","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access is declared like the "},{"code":"in","type":"codeVoice"},{"type":"text","text":" and "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" term modifiers of flecs queries"},{"type":"text","text":" "},{"type":"text","text":"(“Access modifiers” in "},{"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true,"type":"reference"},{"type":"text","text":"), whose "},{"code":"each","type":"codeVoice"},{"type":"text","text":" callbacks take "},{"code":"const T&","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"code":"T&","type":"codeVoice"},{"type":"text","text":" for writes: here the labels "},{"code":"reading:","type":"codeVoice"},{"type":"text","text":" and "},{"code":"writing:","type":"codeVoice"},{"type":"text","text":" state it."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every read and written type must be a required component of this family, not an excluded one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true,"type":"reference"},{"type":"text","text":", one "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true,"type":"reference"},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}]}]}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"role":"symbol","title":"Family","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"url":"\/documentation\/firebladeecs\/family","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Family","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","navigatorTitle":[{"text":"Family","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentModified":{"type":"