{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/savingandloadingscenes"]}],"sections":[],"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article","title":"Saving and Loading Scenes"},"abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"generated":true}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A nexus encodes as a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true},{"type":"text","text":": every entity with its original identifier, the components conforming to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent"},{"type":"text","text":", and the state of the entity identifier generator."},{"type":"text","text":" "},{"type":"text","text":"The snapshot works with any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" format, such as JSON, property lists or YAML."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Make-components-serializable","text":"Make components serializable"},{"inlineContent":[{"type":"text","text":"Conform each component you want to persist to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent"},{"type":"text","text":", or annotate it with "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Give each persisted type an explicit, stable name. The default name is the fully qualified Swift type name, which changes when you rename the type or its module:"}],"type":"paragraph"},{"type":"codeListing","code":["final class Position: SerializableComponent {","    static let componentTypeName = \"Position\"","    var x: Double","    var y: Double","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you rename a type later, list its former names, so existing scene files keep loading:"}],"type":"paragraph"},{"type":"codeListing","code":["final class Health: SerializableComponent {","    static let componentTypeName = \"Health\"","    static let componentTypeNameAliases = [\"HitPoints\"]","    var value: Int","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Components referencing other entities can store an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","isActive":true},{"type":"text","text":" or an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true},{"type":"text","text":". Both are restored correctly."}],"type":"paragraph"},{"anchor":"Save-and-load-a-nexus-with-Codable","level":3,"type":"heading","text":"Save and load a nexus with Codable"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so it can be part of your own scene type:"}],"type":"paragraph"},{"type":"codeListing","code":["struct Scene: Codable {","    var name: String","    var nexus: Nexus","}","","let data = try JSONEncoder().encode(Scene(name: \"Level 1\", nexus: nexus))","","let decoder = JSONDecoder()","decoder.userInfo[.nexusComponentTypes] = [Position.self, Health.self, Parent.self] as [any SerializableComponent.Type]","decoder.userInfo[.nexusEntityResolver] = EntityReferenceResolver(mapping: [:]) \/\/ needed for `Entity` properties","let scene = try decoder.decode(Scene.self, from: data)"],"syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Encoding throws "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError\/notSerializable(typeName:)","type":"reference","isActive":true},{"type":"text","text":" for components that are not serializable."},{"type":"text","text":" "},{"type":"text","text":"To leave runtime-only components out instead, set "},{"type":"codeVoice","code":"encoder.userInfo[.nexusNonSerializableComponentHandling]"},{"type":"text","text":" to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling\/skip","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding needs all component types of the scene in "},{"type":"codeVoice","code":"userInfo[.nexusComponentTypes]"},{"type":"text","text":". Unknown names throw "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRegistryError\/unknownTypeName(_:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The decoded nexus has the same entity identifiers and creates new entities with the identifiers the original nexus would have used next."}]}]}],"type":"unorderedList"},{"anchor":"Load-into-an-existing-nexus","level":3,"type":"heading","text":"Load into an existing nexus"},{"inlineContent":[{"type":"text","text":"To keep a configured nexus, for example one with a delegate, families or a custom generator, use the snapshot API directly:"}],"type":"paragraph"},{"type":"codeListing","code":["var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .throwError)","","let restored = Nexus()","try restored.register([Position.self, Health.self, Parent.self])","var decoder = JSONDecoder()","try restored.restoreSnapshot(from: data, using: &decoder)"],"syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/restoreSnapshot(from:using:)","type":"reference","isActive":true},{"type":"text","text":" keeps the entity identifiers. It requires a nexus without entities and emits the usual entity and component events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/decodeSnapshot(from:using:)","type":"reference","isActive":true},{"type":"text","text":" adds the snapshot as new entities to a populated nexus, for example for prefabs, and returns the mapping from saved to new identifiers."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both roll back all changes if decoding fails."}],"type":"paragraph"},{"anchor":"Use-other-formats","level":3,"type":"heading","text":"Use other formats"},{"inlineContent":[{"type":"text","text":"The snapshot API accepts any coder conforming to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelEncoder","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelDecoder","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PropertyListEncoder"},{"type":"text","text":" and their decoders conform out of the box."},{"type":"text","text":" "},{"type":"text","text":"For other formats, add the conformance in your project. For example, with "},{"type":"reference","identifier":"https:\/\/github.com\/jpsim\/Yams","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["import Yams","","struct YAMLSceneEncoder: TopLevelEncoder {","    var userInfo: [CodingUserInfoKey: UserInfoValue] = [:]","    func encode<T: Encodable>(_ value: T) throws -> String {","        try YAMLEncoder().encode(value, userInfo: userInfo)","    }","}","","struct YAMLSceneDecoder: TopLevelDecoder {","    var userInfo: [CodingUserInfoKey: UserInfoValue] = [:]","    func decode<T: Decodable>(_ type: T.Type, from yaml: String) throws -> T {","        try YAMLDecoder().decode(type, from: yaml, userInfo: userInfo)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"Nexus: Codable"},{"type":"text","text":" works with any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" coder directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For deterministic output, for example for scene files under version control, sort the keys, e.g. with "},{"type":"codeVoice","code":"JSONEncoder.OutputFormatting.sortedKeys"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"What-a-snapshot-contains","level":3,"type":"heading","text":"What a snapshot contains"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every entity, including entities without components, with its original identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every serializable component. A component instance shared by several entities is stored once and shared again after loading."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The entity identifier generator state, if the generator conforms to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","type":"reference","isActive":true},{"type":"text","text":". "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/LinearIncrementingEntityIdGenerator","type":"reference","isActive":true},{"type":"text","text":" does."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Not contained are components that are not serializable, families (they are derived from the components) and the nexus delegate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The format is versioned by "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","isActive":true},{"type":"text","text":". Newer versions of FirebladeECS keep loading older snapshots and reject snapshots written by a newer version."}],"type":"paragraph"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/TopLevelDecoder":{"navigatorTitle":[{"text":"TopLevelDecoder","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/topleveldecoder","title":"TopLevelDecoder","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelDecoder","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TopLevelDecoder","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A type that can decode values from a native format.","type":"text"}],"type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/NexusSnapshot/formatVersion":{"url":"\/documentation\/firebladeecs\/nexussnapshot\/formatversion","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"formatVersion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"}],"abstract":[{"type":"text","text":"The version of the encoded snapshot format written by this library."}],"title":"formatVersion","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"},"doc://FirebladeECS/documentation/FirebladeECS/NonSerializableComponentHandling/skip":{"kind":"symbol","type":"topic","title":"NonSerializableComponentHandling.skip","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"skip","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nonserializablecomponenthandling\/skip","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling\/skip","abstract":[{"type":"text","text":"Leave non-serializable components out of the snapshot, e.g. runtime-only components."}],"role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"role":"symbol","kind":"symbol","title":"NexusEventDelegate","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}],"abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate"},"doc://FirebladeECS/documentation/FirebladeECS/SerializableComponent":{"url":"\/documentation\/firebladeecs\/serializablecomponent","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SerializableComponent"}],"abstract":[{"text":"A registrable c