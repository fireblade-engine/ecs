lineContent":[{"text":"Component type 1 required by members of this family.","type":"text"}]}],"name":"comp1"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 2 required by members of this family.","type":"text"}]}],"name":"comp2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 3 required by members of this family.","type":"text"}]}],"name":"comp3"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 4 required by members of this family.","type":"text"}]}],"name":"comp4"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 5 required by members of this family.","type":"text"}]}],"name":"comp5"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 6 required by members of this family.","type":"text"}]}],"name":"comp6"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 7 required by members of this family.","type":"text"}]}],"name":"comp7"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Component type 8 required by members of this family.","type":"text"}]}],"name":"comp8"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All component types that must not be assigned to an entity in this family.","type":"text"}]}],"name":"excludedComponents"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The family of entities having 8 required components each."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the 8 required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."},{"type":"text","text":" "},{"type":"text","text":"A family conforms to the "},{"code":"LazySequenceProtocol","type":"codeVoice"},{"type":"text","text":" and therefore can be accessed like any other (lazy) sequence."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"General usage","type":"text"}]}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self, Comp3.self, Comp4.self, Comp5.self, Comp6.self, Comp7.self, Comp8.self)","\/\/ iterate each entity's components","family.forEach { (comp1, comp2, comp3, comp4, comp5, comp6, comp7, comp8) in","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Caveats","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Component types must be unique per family","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Component type order is arbitrary","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(1) for existing families, O(N) where N is the number of entities for new families.","type":"text"}]}]}],"kind":"content"}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/family(requiresall:_:_:_:_:_:_:_:excludesall:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requiresA