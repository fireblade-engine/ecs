tProperties"}]}],[{"type":"paragraph","inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init()"},{"text":" if every stored property has a default value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"key path assignment, state machines","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}],"type":"paragraph"},{"text":"Adding the product","level":3,"anchor":"Adding-the-product","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the product to your target. It re-exports "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [.product(name: \"FirebladeECSMacros\", package: \"ecs\")])"],"type":"codeListing"},{"text":"Declaring components","level":3,"anchor":"Declaring-components","type":"heading"},{"syntax":"swift","code":["import FirebladeECSMacros","","@Component","final class Transform: @unchecked Sendable {","    var position: SIMD3<Float> = .zero","    var parent: Entity?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","final class RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"type":"text","text":" takes a "},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"type":"text","text":" set: "},{"type":"codeVoice","code":".cloneable"},{"type":"text","text":", "},{"type":"codeVoice","code":".serializable"},{"type":"text","text":", "},{"type":"codeVoice","code":".inspectable"},{"type":"text","text":" and "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":". Registration is always implemented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" leaves serialization entirely to you."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The generated initializers are designated initializers, so the class no longer gets an implicit "},{"type":"codeVoice","code":"init()"},{"type":"text","text":". Keep "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":" enabled or declare your own initializers."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Registering, cloning and snapshots","level":3,"anchor":"Registering-cloning-and-snapshots","type":"heading"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true},{"type":"text","text":" starts with a "},{"type":"codeVoice","code":"formatVersion"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true},{"type":"text","text":", and rejects snapshots written in a newer format version."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/firebladeecs\/componentmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/SerializableComponent":{"abstract":[{"text":"A registrable component that can be encoded and decoded by its stable type name.","type":"text"}],"title":"SerializableComponent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","role":"symbol","url":"\/documentation\/firebladeecs\/serializablecomponent","navigatorTitle":[{"text":"SerializableComponent","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerializableComponent","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/GettingStartedWithFirebladeECS":{"url":"\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs","title":"Getting started with Fireblade ECS","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/EntityReferenceResolver":{"abstract":[{"text":"Resolves encoded entity identifiers to entities of