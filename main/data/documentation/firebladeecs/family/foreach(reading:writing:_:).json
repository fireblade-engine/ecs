anging others in place."}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"text":"rType1","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to read."}]}],"name":"rType1"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to change in place.","type":"text"}]}],"name":"wType1"},{"content":[{"inlineContent":[{"type":"text","text":"Called once per member."}],"type":"paragraph"}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"code":"inout","type":"codeVoice"},{"text":". The writes land","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}],"type":"paragraph"},{"code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Access is declared like the "},{"type":"codeVoice","code":"in"},{"type":"text","text":" and "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" term modifiers of flecs queries"},{"type":"text","text":" "},{"type":"text","text":"(“Access modifiers” in "},{"type":"reference","identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true},{"type":"text","text":"), whose "},{"type":"codeVoice","code":"each"},{"type":"text","text":" callbacks take "},{"type":"codeVoice","code":"const T&"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"code":"T&","type":"codeVoice"},{"text":" for writes: here the labels ","type":"text"},{"code":"reading:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"writing:","type":"codeVoice"},{"text":" state it.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Every read and written type must be a required component of this family, not an excluded one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"code":"modify","type":"codeVoice"},{"type":"text","text":" writes. Violations trap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"code":"set","type":"codeVoice"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"text":"changed values through the ","type":"text"},{"code":"inout","type":"codeVoice"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"text":"(for example ","type":"text"},{"type":"codeVoice","code":"entity.get(_:)"},{"text":") traps, too.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the","type":"text"},{"text":" ","type":"text"},{"text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":", one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"style":"note"}]}],"sections":[],"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"role":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","title":"Reading and writing components","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"kind":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"kind":"