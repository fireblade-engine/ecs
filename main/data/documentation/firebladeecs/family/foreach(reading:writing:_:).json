"}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Access is declared like the ","type":"text"},{"type":"codeVoice","code":"in"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"},{"text":"), whose ","type":"text"},{"type":"codeVoice","code":"each"},{"text":" callbacks take ","type":"text"},{"type":"codeVoice","code":"const T&"},{"text":" ","type":"text"},{"text":"for reads and ","type":"text"},{"type":"codeVoice","code":"T&"},{"text":" for writes: here the labels ","type":"text"},{"type":"codeVoice","code":"reading:"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"writing:"},{"text":" state it.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Every read and written type must be a required component of this family, not an excluded one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":", one "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference"},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}],"type":"paragraph"}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"style":"note","name":"Complexity"}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","extendedModule":"FirebladeECS","externalID":"s:12FirebladeECS6FamilyV7forEach7reading7writing_yqd__m_qd_0_myqd___qd_0_ztKXEtKAA9ComponentRd__AaGRd_0_r0_lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"}