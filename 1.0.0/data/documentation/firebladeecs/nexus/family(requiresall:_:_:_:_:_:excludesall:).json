collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 6 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"General usage"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","code":["let family = nexus.family(requiresAll: Comp1.self, Comp2.self, Comp3.self, Comp4.self, Comp5.self, Comp6.self)","\/\/ iterate each entity's components","family.forEach { (comp1, comp2, comp3, comp4, comp5, comp6) in","  ...","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"