{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","symbolKind":"property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"roleHeading":"Type Property","role":"symbol","title":"componentIndex"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"text":" ","type":"text"},{"text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so all nexuses of a process agree on it. Indices are dense (","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true,"type":"reference"},{"text":" for persistent data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro will) as a stored ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"code":"0 ..< 1_048_576","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type.","type":"text"},{"text":" ","type":"text"},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1)"}],"type":"paragraph"}],"name":"Complexity"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"]}],"sections":[],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"kind":"symbol","references":{"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"type":"topic","abstract":[{"type":"text","text":"The dense index of this component type."}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","title":"componentIndex","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS":{"role":"collection","title":"FirebladeECS","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"url":"\/documentation\/firebladeecs","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"type":"topic","url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"defaultImplementations":1,"title":"componentTypeName","abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"required":true,"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","title":"stableIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"stableIdentifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier","kind":"typeIdentifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"role":"symbol","url":"\/documentation\/firebladeecs\/component","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}}}