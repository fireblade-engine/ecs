{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" file or use it to create a new project."}]},{"type":"codeListing","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Coming from FirebladeECS 1? Read "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","text":"🏛️ Nexus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize a "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" with"}]},{"type":"codeListing","code":["let nexus = Nexus()"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%91%A4-Entities","text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"type":"codeListing","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}]},{"type":"codeListing","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign values of it to an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}]},{"type":"codeListing","code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"type":"codeListing","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%91%AA-Families","text":"👪 Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"type":"strong","inlineContent":[{"type":"text","text":"same component types"}]},{"type":"text","text":" may belong to one "},{"type":"codeVoice","code":"Family"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"Family"},{"type":"text","text":" has entities as members and component types as family traits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"type":"codeVoice","code":".family"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PlayerInput"},{"type":"text","text":" component, but no "},{"type":"codeVoice","code":"Texture"},{"type":"text","text":" component is created by"}]},{"type":"codeListing","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"type":"codeVoice","code":"forEach(reading:writing:)"},{"type":"text","text":", see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}]},{"type":"codeListing","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%A7%91-Singles","text":"🧑 Singles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Single"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" entity with exactly "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},{"type":"text","text":" character. Single components must conform to the "},{"type":"codeVoice","code":"SingleComponent"},{"type":"text","text":" protocol and will not be available through regular family iteration."}]},{"type":"codeListing","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%94%97-Serialization","text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}]},{"type":"codeListing","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"anchor":"Essentials","generated":true}],"metadata":{"title":"Getting started with Fireblade ECS","roleHeading":"Article","modules":[{"name":"FirebladeECS"}],"role":"article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://developer.apple.com/documentation/swift/sequence":{"title":"Sequence","url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","titleInlineContent":[{"type":"text","text":"Sequence"}]},"https://github.com/fireblade-engine/ecs-demo":{"title":"Fireblade ECS Demo App","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"title":"NexusEvent","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","kind":"symbol","url":"\/documentation\/firebladeecs\/nexusevent","type":"topic","abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}]},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"title":"Reacting to Nexus events","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","kind":"article","url":"\/documentation\/firebladeecs\/reactingtonexusevents","type":"topic","abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"title":"Nexus","role":"symbol","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus","type":"topic","abstract":[]},"https://en.wiktionary.org/wiki/nexus#Noun":{"title":"Nexus","url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","titleInlineContent":[{"type":"text","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"title":"Reading and writing components","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","kind":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}]},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"title":"Saving and Loading Scenes","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","kind":"article","url":"\/documentation\/firebladeecs\/savingandloadingscenes","type":"topic","abstract":[{"type":"text","text":"Store a whole "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}]},"https://en.wikipedia.org/wiki/Entity_component_system":{"title":"ECS","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","titleInlineContent":[{"type":"text","text":"ECS"}]},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"title":"Choosing a storage","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","url":"\/documentation\/firebladeecs\/choosingastorage","type":"topic","kind":"article","abstract":[{"text":"Pick the sparse-set or the archetype storage for a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":", and know what changes.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"title":"Nexus.StorageKind","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus\/storagekind","type":"topic","abstract":[{"type":"text","text":"The storage a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" keeps its entities and components in."}]},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"title":"Singleton","url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","titleInlineContent":[{"type":"text","text":"Singleton"}]},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"title":"Migrating to FirebladeECS 2","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","type":"topic","kind":"article","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventMask"}],"title":"NexusEventMask","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","kind":"symbol","url":"\/documentation\/firebladeecs\/nexuseventmask","type":"topic","abstract":[{"type":"text","text":"The kinds of events a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","isActive":true},{"type":"text","text":" subscribes to."}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"title":"Generating components with the component macro","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","url":"\/documentation\/firebladeecs\/componentmacro","type":"topic","kind":"article","abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"role":"collection","url":"\/documentation\/firebladeecs","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","type":"topic","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}],"title":"NexusEventDelegate","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","kind":"symbol","url":"\/documentation\/firebladeecs\/nexuseventdelegate","type":"topic","abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}]}}}