 at least the 1 required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."},{"type":"text","text":" "},{"type":"text","text":"A family conforms to the "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":" and therefore can be accessed like any other (lazy) sequence."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"General usage","type":"text"}]}],"type":"paragraph"},{"code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}]}]}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Nexus/family(requires:excludesAll:)":{"role":"symbol","abstract":[{"text":"Create a family of entities (aka members) having 1 required components.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requir