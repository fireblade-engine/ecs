{"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"metadata":{"title":"Getting started with Fireblade ECS","role":"article","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true,"type":"reference"},{"text":").","type":"text"},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"text":" file or use it to create a new project.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""]},{"type":"paragraph","inlineContent":[{"text":"Coming from FirebladeECS 1? Read ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","isActive":true,"type":"reference"},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"type":"text","text":" "},{"text":"For a more detailed example, see the ","type":"text"},{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"isActive":true,"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"text":" at a time.","type":"text"},{"type":"text","text":"\n"},{"text":"You may use more than one ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize a "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" with"}]},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()"]},{"anchor":"%F0%9F%91%A4-Entities","level":3,"type":"heading","text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign values of it to an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}]},{"type":"codeListing","syntax":"swift","code":["let position = Position(x: 1, y: 2)","entity.set(position)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""]},{"anchor":"%F0%9F%91%AA-Families","level":3,"type":"heading","text":"👪 Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"type":"strong","inlineContent":[{"type":"text","text":"same component types"}]},{"type":"text","text":" may belong to one "},{"code":"Family","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A "},{"code":"Family","type":"codeVoice"},{"type":"text","text":" has entities as members and component types as family traits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"code":".family","type":"codeVoice"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" and "},{"code":"PlayerInput","type":"codeVoice"},{"type":"text","text":" component, but no "},{"code":"Texture","type":"codeVoice"},{"type":"text","text":" component is created by"}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"reference","isActive":true},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"code":"forEach(reading:writing:)","type":"codeVoice"},{"type":"text","text":", see "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"code":"family.entityAndComponents","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"code":"family.entities","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"level":3,"text":"🧑 Singles","type":"heading","anchor":"%F0%9F%A7%91-Singles"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Single"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","isActive":true,"type":"reference"},{"text":" character. Single components must conform to the ","type":"text"},{"type":"codeVoice","code":"SingleComponent"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""]},{"anchor":"%F0%9F%94%97-Serialization","level":3,"type":"heading","text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""]}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}],"title":"NexusEventDelegate","url":"\/documentation\/firebladeecs\/nexuseventdelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"kind":"symbol","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"type":"topic","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","role":"article","title":"Saving and Loading Scenes","url":"\/documentation\/firebladeecs\/savingandloadingscenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"url":"\/documentation\/firebladeecs\/componentmacro","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"title":"Generating components with the component macro","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"url":"\/documentation\/firebladeecs\/nexuseventmask","abstract":[{"type":"text","text":"The kinds of events a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"},{"text":" subscribes to.","type":"text"}],"title":"NexusEventMask","type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventMask","kind":"identifier"}],"navigatorTitle":[{"text":"NexusEventMask","kind":"identifier"}]},"https://github.com/fireblade-engine/ecs-demo":{"titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}],"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","title":"Fireblade ECS Demo App"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"title":"Nexus.StorageKind","url":"\/documentation\/firebladeecs\/nexus\/storagekind","abstract":[{"text":"The storage a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"text":" keeps its entities and components in.","type":"text"}],"navigatorTitle":[{"text":"StorageKind","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Benchmarks":{"type":"topic","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","role":"article","title":"Benchmarks","url":"\/documentation\/firebladeecs\/benchmarks","abstract":[{"text":"See how FirebladeECS revisions compare on a shared workload suite, and run the comparison yourself.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"url":"\/documentation\/firebladeecs\/reactingtonexusevents","abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"title":"Reacting to Nexus events","type":"topic","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"url":"\/documentation\/firebladeecs\/choosingastorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"type":"text","text":", and know what changes."}],"title":"Choosing a storage","type":"topic","role":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","kind":"article"},"https://en.wikipedia.org/wiki/Entity_component_system":{"titleInlineContent":[{"text":"ECS","type":"text"}],"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","title":"ECS"},"https://en.wiktionary.org/wiki/nexus#Noun":{"titleInlineContent":[{"text":"Nexus","type":"text"}],"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","title":"Nexus"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Nexus"}],"title":"Nexus","url":"\/documentation\/firebladeecs\/nexus","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"type":"topic","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"title":"NexusEvent","url":"\/documentation\/firebladeecs\/nexusevent","abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"type":"topic","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","role":"article","title":"Reading and writing components","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","abstract":[{"text":"Read a copy, replace a component or change it in place.","type":"text"}]},"https://developer.apple.com/documentation/swift/sequence":{"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","titleInlineContent":[{"type":"text","text":"Sequence"}],"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence","type":"link"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}],"title":"Migrating to FirebladeECS 2","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"url":"\/documentation\/firebladeecs","kind":"symbol","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","role":"collection"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","titleInlineContent":[{"text":"Singleton","type":"text"}],"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","type":"link"}}}