{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to read."}]}],"name":"rType1"},{"name":"wType1","content":[{"type":"paragraph","inlineContent":[{"text":"The component type to change in place.","type":"text"}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"text":"Called once per member.","type":"text"}]}]}],"kind":"parameters"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the read components first (as copies), then the written ones as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". The writes land"},{"type":"text","text":" "},{"type":"text","text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a"},{"type":"text","text":" "},{"type":"text","text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs"},{"type":"text","text":" "},{"type":"text","text":"a plain loop over the members: no allocation and no dynamic dispatch per member."}],"type":"paragraph"},{"syntax":"swift","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access is declared like the "},{"type":"codeVoice","code":"in"},{"text":" and ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md","isActive":true},{"type":"text","text":"), whose "},{"type":"codeVoice","code":"each"},{"type":"text","text":" callbacks take "},{"type":"codeVoice","code":"const T&"},{"type":"text","text":" "},{"type":"text","text":"for reads and "},{"type":"codeVoice","code":"T&"},{"type":"text","text":" for writes: here the labels "},{"type":"codeVoice","code":"reading:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"writing:"},{"type":"text","text":" state it."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The written types must be pairwise different and different from the read types, and a pass must not nest","type":"text"},{"text":" ","type":"text"},{"text":"a write access to a type that an enclosing pass or ","type":"text"},{"type":"codeVoice","code":"modify"},{"text":" writes. Violations trap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" runs, structural changes trap: creating or destroying entities, adding or removing","type":"text"},{"text":" ","type":"text"},{"text":"components, and replacing a component with ","type":"text"},{"type":"codeVoice","code":"set"},{"text":". Collect them and apply them after the pass, and write","type":"text"},{"text":" ","type":"text"},{"text":"changed values through the ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" parameters. Reading a written type through the nexus","type":"text"},{"text":" ","type":"text"},{"text":"(for example ","type":"text"},{"type":"codeVoice","code":"entity.get(_:)"},{"text":") traps, too.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the","type":"text"},{"text":" ","type":"text"},{"text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":", one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}]}]}],"type":"unorderedList"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreach(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Iterates the members of this family, reading some of their components and changing others in place.","type":"text"}],"metadata":{"title":"forEach(reading:writing:_:)","roleHeading":"Instance Method","externalID":"s:12FirebladeECS6FamilyV7forEach7reading7writing_yqd__m_qd_0_myqd___qd_0_