{"abstract":[{"type":"text","text":"Gives "},{"type":"codeVoice","code":"body"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"type":"codeVoice","code":"Span"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Instance Method","extendedModule":"FirebladeECS","modules":[{"name":"FirebladeECS"}],"title":"componentSpan(reading:_:)","role":"symbol","externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, ("},{"preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"}],"symbolKind":"method","platforms":[{"name":"iOS","beta":false,"introducedAt":"26.0","deprecated":false,"unavailable":false},{"name":"macOS","beta":false,"introducedAt":"26.0","deprecated":false,"unavailable":false},{"name":"tvOS","beta":false,"introducedAt":"26.0","deprecated":false,"unavailable":false},{"name":"visionOS","beta":false,"introducedAt":"26.0","deprecated":false,"unavailable":false},{"name":"watchOS","beta":false,"introducedAt":"26.0","deprecated":false,"unavailable":false}]},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Span","kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"Receives the span; its result is returned."}],"type":"paragraph"}],"name":"body"}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"type":"text","text":"removed. It is zero copy: it views the storage itself. Because "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":", it cannot leave "},{"type":"codeVoice","code":"body"},{"text":" ","type":"text"},{"type":"text","text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle."}]},{"code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Span","type":"codeVoice"},{"type":"text","text":" is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":": loop over "},{"type":"codeVoice","code":"indices"},{"type":"text","text":". Element access is bounds checked."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"code":"body","type":"codeVoice"},{"type":"text","text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or"},{"type":"text","text":" "},{"type":"text","text":"removing components, replacing a component with "},{"code":"set","type":"codeVoice"},{"type":"text","text":") and writes to the type stop the process with a message,"},{"type":"text","text":" "},{"type":"text","text":"since they would move or change what the span views. Reading the component through the nexus and reading"},{"type":"text","text":" "},{"type":"text","text":"the type again are fine. Collect changes and apply them after the call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty storage (or a type no entity ever had) passes an empty span."}]},{"text":"Storage","level":3,"type":"heading","anchor":"Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself."},{"type":"text","text":" "},{"type":"text","text":"The archetype storage keeps one column per table (one table per component set), so entities with different"},{"type":"text","text":" "},{"type":"text","text":"component sets are not next to each other. If one table holds all components of the type the span views its column,"},{"type":"text","text":" "},{"type":"text","text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs"},{"type":"text","text":" "},{"type":"text","text":"one allocation and O(N) copying per call and is released after "},{"code":"body","type":"codeVoice"},{"type":"text","text":". Use"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)"},{"type":"text","text":" to get zero copy spans, one batch per table."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) plus "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)","interfaceLanguage":"swift"},"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"role":"collection","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"type":"topic","kind":"article","title":"Reading and writing components","role":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/componentSpan(reading:_:)":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)","abstract":[{"type":"text","text":"Gives "},{"code":"body","type":"codeVoice"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","title":"componentSpan(reading:_:)","role":"symbol","url":"\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, ("},{"preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","abstract":[],"type":"topic","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"kind":"symbol","title":"Nexus","role":"symbol","url":"\/documentation\/firebladeecs\/nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"role":"article","title":"Choosing a storage","type":"topic","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":", and know what changes."}],"url":"\/documentation\/firebladeecs\/choosingastorage","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"type":"topic","kind":"article","title":"Migrating to FirebladeECS 2","role":"article","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2"},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEachComponentSpan(reading:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"type":"topic","title":"forEachComponentSpan(reading:_:)","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","url":"\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:_:)","abstract":[{"type":"text","text":"Iterates the members of this family in batches, reading 1 and writing 0 component types as contiguous spans."}],"role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"type":"topic","title":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","url":"\/documentation\/firebladeecs\/component","abstract":[{"type":"strong","inlineContent":[{"text":"Component","type":"text"}]}],"role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"kind":"symbol"}}}