e":"visionOS","introducedAt":"26.0","beta":false,"unavailable":false},{"deprecated":false,"name":"watchOS","introducedAt":"26.0","beta":false,"unavailable":false}],"role":"symbol","externalID":"s:12FirebladeECS6FamilyV20forEachComponentSpan7reading7writing_yqd__m_qd_0_mys0G0Vyqd__G_s07MutableG0Vyqd_0_GztKXEtKAA0F0Rd__AaMRd_0_r0_lF","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"],"kind":"mentions"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"code":"body","type":"codeVoice"},{"type":"text","text":" receives a "},{"code":"Span","type":"codeVoice"},{"type":"text","text":" of the read type and an "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"code":"MutableSpan","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}]},{"type":"codeListing","syntax":"swift","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"type":"heading","anchor":"Batches","level":3,"text":"Batches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"type":"codeVoice","code":"body"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"type":"text","text":" "},{"type":"text","text":"the family and has members, in table creation order. Entities with the same component set form one batch, however"},{"type":"text","text":" "},{"type":"text","text":"the component set came about, and a family whose members have several component sets gets several calls."}]},{"type":"heading","anchor":"Rules","level":3,"text":"Rules"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"type":"codeVoice","code":"body"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","isActive":true},{"type":"text","text":": structural changes, reading a"},{"type":"text","text":" "},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"type":"text","text":" "},{"type":"text","text":"type) stop the process with a message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"type":"text","text":" receives one "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}]},{"content":[{"inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"]}],"kind":"symbol","abstract":[{"text":"Iterates the members of this family in batches, giving ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" the components of a batch as contiguous spans.","type":"text"}],"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentsModified":{"abstract":[{"type":"text","text":"Event triggered once after a bulk write pass over al