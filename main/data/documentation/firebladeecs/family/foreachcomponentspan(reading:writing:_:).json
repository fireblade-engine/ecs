{"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"sections":[],"abstract":[{"type":"text","text":"Iterates the members of this family in batches, giving "},{"type":"codeVoice","code":"body"},{"type":"text","text":" the components of a batch as contiguous spans."}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MutableSpan","preciseIdentifier":"s:s11MutableSpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"type":"codeVoice","code":"body"},{"type":"text","text":" receives a "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" of the read type and an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableSpan"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"text":"Batches","level":3,"type":"heading","anchor":"Batches"},{"inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"type":"codeVoice","code":"body"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"text":" ","type":"text"},{"text":"the family and has members, in table creation order. Entities with the same component set form one batch, however","type":"text"},{"text":" ","type":"text"},{"text":"the component set came about, and a family whose members have several component sets gets several calls.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Rules","level":3,"anchor":"Rules"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"type":"codeVoice","code":"body"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)"},{"type":"text","text":": structural changes, reading a"},{"type":"text","text":" "},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"type":"text","text":" "},{"type":"text","text":"type) stop the process with a message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":" receives one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}]}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","externalID":"s:12FirebladeECS6FamilyV20forEachComponentSpan7reading7writing_yqd__m_qd_0_mys0G0Vyqd__G_s07MutableG0Vyqd_0_GztKXEtKAA0F0Rd__AaMRd_0_r0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"role":"symbol","title":"forEachComponentSpan(reading:writing:_:)","modules":[{"name":"FirebladeECS"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"each C","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"platforms":[{"beta":false,"introducedAt":"26.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"26.0","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"26.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"26.0","deprecated":false,"name":"visionOS","unavailable":false},{"beta":false,"introducedAt":"26.0","deprecated":false,"name":"watchOS","unavailable":false}],"extendedModule":"FirebladeECS","roleHeading":"Instance Method"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask/valueChanges":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMas