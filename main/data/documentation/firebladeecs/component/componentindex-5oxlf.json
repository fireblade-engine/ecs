{"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"abstract":[{"text":"The dense index of this component type.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default implementation assigns indices lazily: the first access of a type takes the next free index"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","type":"reference"},{"type":"text","text":" for persistent data."}]},{"inlineContent":[{"type":"text","text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static."},{"type":"text","text":" "},{"type":"text","text":"Provide your own implementation (the "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" macro will) as a stored "},{"type":"codeVoice","code":"static let"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"code":"0 ..< 1_048_576","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(1)"}],"type":"paragraph"}],"name":"Complexity"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"metadata":{"modules":[{"name":"FirebladeECS"}],"title":"componentIndex","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"extendedModule":"FirebladeECS","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","role":"symbol","symbolKind":"property","roleHeading":"Type Property"},"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"title":"FirebladeECS","url":"\/documentation\/firebladeecs"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","abstract":[{"text":"The dense index of this component type.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"componentIndex","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"url":"\/documentation\/firebladeecs\/component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"kind":"symbol","title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"abstract":[],"role":"symbol"},"doc://FirebladeECS/documentation/Fi