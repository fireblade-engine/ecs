{"kind":"symbol","sections":[],"abstract":[{"text":"Gives ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" read access to all components of a type as one contiguous ","type":"text"},{"type":"codeVoice","code":"Span"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type.","type":"text"}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Receives the span; its result is returned.","type":"text"}]}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"text":"removed. It is zero copy: it views the storage itself. Because ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":", it cannot leave ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"]},{"type":"paragraph","inlineContent":[{"code":"Span","type":"codeVoice"},{"text":" is not a ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":": loop over "},{"type":"codeVoice","code":"indices"},{"type":"text","text":". Element access is bounds checked."}]},{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or","type":"text"},{"text":" ","type":"text"},{"text":"removing components, replacing a component with ","type":"text"},{"type":"codeVoice","code":"set"},{"text":") and writes to the type stop the process with a message,","type":"text"},{"text":" ","type":"text"},{"text":"since they would move or change what the span views. Reading the component through the nexus and reading","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the type again are fine. Collect changes and apply them after the call."}]},{"inlineContent":[{"type":"text","text":"An empty storage (or a type no entity ever had) passes an empty span."}],"type":"paragraph"},{"level":3,"text":"Storage","anchor":"Storage","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself.","type":"text"},{"type":"text","text":" "},{"text":"The archetype storage keeps one column per table (one table per component set), so entities with different","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"component sets are not next to each other. If one table holds all components of the type the span views its column,"},{"text":" ","type":"text"},{"text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"one allocation and O(N) copying per call and is released after "},{"type":"codeVoice","code":"body"},{"text":". Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","type":"reference","isActive":true},{"type":"text","text":" to get zero copy spans, one batch per table."}]},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(1) plus ","type":"text"},{"type":"codeVoice","code":"body"},{"text":".","type":"text"}]}],"type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"