,{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"type":"codeVoice","code":"LazySequenceProtocol"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General usage"}]}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caveats"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}]}],"name":"Complexity"}]}],"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requires:excludesAll:)"},"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/firebladeecs","role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\