{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"]}],"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article","title":"Reacting to Nexus events"},"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Structural events are always delivered:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","type":"reference","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Value change events are opt-in:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true},{"type":"text","text":": a component was set on an entity that already had one of that type."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","isActive":true},{"type":"text","text":" is the number of components the pass could write."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Every event names its entity with the generational ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"text":", so a stale identifier never matches a later entity in the same slot.","type":"text"}]},{"text":"Subscribing","anchor":"Subscribing","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents"},{"text":" is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural"},{"text":" by default. Return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all"},{"text":" to receive value changes:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"reference"},{"text":" is an open protocol and later releases add events. Always switch with a ","type":"text"},{"code":"default:","type":"codeVoice"},{"type":"text","text":" case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The nexus reads "},{"code":"subscribedEvents","type":"codeVoice"},{"text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: ","type":"text"},{"code":"nexus.delegate = observer","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true,"type":"reference"},{"text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Cost","anchor":"Cost","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}],"type":"paragraph"},{"text":"Ordering","anchor":"Ordering","type":"heading","level":3},{"inlineContent":[{"text":"Modifying a component that is missing, with a default value, delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"text":" and then ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true,"type":"reference"},{"text":". Setting a component the entity does not have yet delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"text":" only, never ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true,"type":"reference"},{"text":". Setting a component the entity already has replaces it and delivers ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true,"type":"reference"},{"text":" to delegates that subscribed to ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Comparison with flecs","anchor":"Comparison-with-flecs","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every "},{"code":"set","type":"codeVoice"},{"type":"text","text":" and on an explicit "},{"code":"modified()","type":"codeVoice"},{"type":"text","text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"FirebladeECS differs on purpose: in-place writes through the nexus emit "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference"},{"type":"text","text":" automatically, so there is no "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":" only."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"url":"\/documentation\/fireblade