{"topicSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Member"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/entityIdGenerator","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/members"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion"],"title":"Type Properties","anchor":"Type-Properties","generated":true},{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/Encodable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceError"],"title":"Snapshots","anchor":"Snapshots","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/FirebladeECS\/s8CopyableP","doc:\/\/FirebladeECS\/SE","doc:\/\/FirebladeECS\/s9EscapableP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusSnapshot"}]}]},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","type":"reference","isActive":true},{"type":"text","text":" and lists all entities in ascending identifier order,"},{"type":"text","text":" "},{"type":"text","text":"each with its original identifier (the raw value, here with generation 0) and its components keyed by their stable "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"formatVersion\": 3,","  \"entityIdGenerator\": { \"nextFreshId\": 3, \"recycledIds\": [] },","  \"entities\": [","    { \"id\": 1, \"components\": { \"MyGame.Position\": { \"x\": 1, \"y\": 2 } } },","    { \"id\": 2, \"components\": {}, \"sharedComponents\": { \"MyGame.Position\": 1 } }","  ]","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" is present if the generator of the nexus is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sharedComponents"},{"type":"text","text":" is present for entities that share a component instance with an entity listed before them."},{"type":"text","text":" "},{"type":"text","text":"Components are values since 2.0, so snapshots never write it; it is still read from older data."},{"type":"text","text":" "},{"type":"text","text":"It maps the component type name to the identifier of the entity that encodes the instance."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"1: Entities and their components."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2: Adds "},{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sharedComponents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation."},{"type":"text","text":" "},{"type":"text","text":"The generator state lists recycled identifiers as "},{"type":"codeVoice","code":"recycledIds"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"text","text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot"},{"type":"text","text":" "},{"type":"text","text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier."},{"type":"text","text":" "},{"type":"text","text":"All other entities keep their identifiers."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexussnapshot"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"kind":"symbol","metadata":{"symbolKind":"struct","modules":[{"name":"FirebladeECS"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusSnapshot"}],"title":"NexusS