{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"title":"Essentials","anchor":"Essentials"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" file or use it to create a new project.","type":"text"}],"type":"paragraph"},{"code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"0.17.7\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"text":" ","type":"text"},{"text":"For a more detailed example, see the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"🏛️ Nexus","level":3,"anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","type":"heading"},{"inlineContent":[{"text":"The core element in the Fireblade ECS is the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"type":"codeVoice","code":"Entities"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"text":"You may use more than one ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Initialize a ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}],"type":"paragraph"},{"code":["let nexus = Nexus()"],"syntax":"swift","type":"codeListing"},{"text":"👤 Entities","level":3,"anchor":"%F0%9F%91%A4-Entities","type":"heading"},{"inlineContent":[{"text":"then create entities by letting the ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" generate them.","type":"text"}],"type":"paragraph"},{"code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To define components, conform your class to the ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":" protocol","type":"text"}],"type":"paragraph"},{"code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"and assign instances of it to an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" with","type":"text"}],"type":"paragraph"},{"code":["let position = Position(x: 1, y: 2)","entity.assign(position)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}],"type":"paragraph"},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"syntax":"swift","type":"codeListing"},{"text":"👪 Families","level":3,"anchor":"%F0%9F%91%AA-Families","type":"heading"},{"inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"type":"strong","inlineContent":[{"text":"same component types","type":"text"}]},{"text":" may belong to one ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":" has entities as members and component types as family traits.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"type":"codeVoice","code":".family"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PlayerInput"},{"type":"text","text":" component, but no "},{"type":"codeVoice","code":"Texture"},{"type":"text","text":" component is created by"}]},{"syntax":"swift","type":"codeListing","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"text":"🧑 Singles","anchor":"%F0%9F%A7%91-Singles","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Single"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference"},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"syntax":"swift","type":"codeListing"},{"text":"🔗 Serialization","level":3,"anchor":"%F0%9F%94%97-Serialization","type":"heading"},{"inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}],"type":"paragraph"},{"code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","title":"Getting started with Fireblade ECS","role":"article","modules":[{"name":"FirebladeECS"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"kind":"article","references":{"https://developer.apple.com/documentation/swift/sequence":{"title":"Sequence","titleInlineContent":[{"text":"Sequence","type":"text"}],"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"abstract":[],"type":"topic","url":"\/documentation\/firebladeecs\/nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","kind":"symbol","fragments":[{"text":"class","kind":"k