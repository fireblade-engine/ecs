{"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" file or use it to create a new project."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"1.2.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus"},{"type":"paragraph","inlineContent":[{"text":"The core element in the Fireblade ECS is the ","type":"text"},{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"type":"codeVoice","code":"Entities"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"text":"You may use more than one ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" at a time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" with","type":"text"}]},{"code":["let nexus = Nexus()"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%91%A4-Entities","text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your class to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol"}]},{"code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign instances of it to an "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" with"}]},{"code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"%F0%9F%91%AA-Families","text":"👪 Families"},{"type":"paragraph","inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"type":"strong","inlineContent":[{"text":"same component types","type":"text"}]},{"text":" may belong to one ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":" has entities as members and component types as family traits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Create a family by calling ","type":"text"},{"type":"codeVoice","code":".family"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PlayerInput"},{"text":" component, but no ","type":"text"},{"type":"codeVoice","code":"Texture"},{"text":" component is created by","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"level":3,"text":"🧑 Singles","type":"heading","anchor":"%F0%9F%A7%91-Singles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Single","type":"codeVoice"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" entity with exactly "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","isActive":true,"type":"reference"},{"type":"text","text":" character. Single components must conform to the "},{"code":"SingleComponent","type":"codeVoice"},{"type":"text","text":" protocol and will not be available through regular family iteration."}]},{"code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing","syntax":"swift"},{"text":"🔗 Serialization","type":"heading","level":3,"anchor":"%F0%9F%94%97-Serialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}]},{"code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"metadata":{"title":"Getting started with Fireblade ECS","role":"article","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"kind":"article","references":{"https://en.wiktionary.org/wiki/nexus#Noun":{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","titleInlineContent":[{"text":"Nexus","type":"text"}],"type":"link","title":"Nexus"},"https://en.wikipedia.org/wiki/Entity_component_system":{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","titleInlineContent":[{"type":"text","text":"ECS"}]},"https://github.com/fireblade-engine/ecs-demo":{"titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}],"title":"Fireblade ECS Demo App","type":"link","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},"doc://FirebladeECS/documentation/FirebladeECS":{"title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","role":"collection","url":"\/documentation\/firebladeecs","type":"topic","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"kind":"symbol"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","title":"Singleton","titleInlineContent":[{"text":"Singleton","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"kind":"symbol","title":"NexusEvent","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"url":"\/documentation\/firebladeecs\/nexusevent","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"NexusEvent"}],"abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"title":"NexusEventDelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}],"type":"topic","url":"\/documentation\/firebladeecs\/nexuseventdelegate","abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"kind":"symbol"},"https://developer.apple.com/documentation/swift/sequence":{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence","url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","titleInlineContent":[{"type":"text","text":"Sequence"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","title":"Nexus","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexus","type":"topic","abstract":[],"navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"role":"article","title":"Saving and Loading Scenes","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"topic","abstract":[{"type":"text","text":"Store a whole "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"kind":"article","url":"\/documentation\/firebladeecs\/savingandloadingscenes"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"role":"article","kind":"article","abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","title":"Generating components with the component macro","url":"\/documentation\/firebladeecs\/componentmacro","type":"topic"}}}