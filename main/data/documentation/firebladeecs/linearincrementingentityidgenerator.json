{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinearIncrementingEntityIdGenerator","kind":"identifier"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This entity id generator creates linearly incrementing entity ids","type":"text"},{"text":" ","type":"text"},{"text":"unless an entity is marked as unused then the marked id is returned next in a FIFO order","type":"text"},{"text":" ","type":"text"},{"text":"with an increased generation.","type":"text"},{"text":" ","type":"text"},{"text":"The slot index 0 is reserved and never provided; slots start at generation 0. A slot whose generation reaches ","type":"text"},{"type":"codeVoice","code":"UInt32.max"},{"text":" is retired and never provided again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Furthermore it respects order of entity ids on initialization, meaning the provided ids on initialization will be provided in order","type":"text"},{"text":" ","type":"text"},{"text":"until all are in use. After that the free entities start at the lowest available id increasing linearly skipping already in-use entity ids.","type":"text"}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityComponentHash","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifierGenerator","doc:\/\/FirebladeECS\/docume