{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A nexus encodes as a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","type":"reference"},{"text":": every entity with its original identifier (slot index and generation), the components conforming to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","type":"reference"},{"text":", and the state of the entity identifier generator.","type":"text"},{"text":" ","type":"text"},{"text":"The snapshot works with any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" format, such as JSON, property lists or YAML.","type":"text"}],"type":"paragraph"},{"anchor":"Make-components-serializable","level":3,"type":"heading","text":"Make components serializable"},{"inlineContent":[{"text":"Conform each component you want to persist to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","type":"reference"},{"text":", or annotate it with ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Give each persisted type an explicit, stable name. The default name is the fully qualified Swift type name, which changes when you rename the type or its module:","type":"text"}],"type":"paragraph"},{"code":["struct Position: SerializableComponent {","    static let componentTypeName = \"Position\"","    var x: Double","    var y: Double","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If you rename a type later, list its former names, so existing scene files keep loading:","type":"text"}],"type":"paragraph"},{"code":["struct Health: SerializableComponent {","    static let componentTypeName = \"Health\"","    static let componentTypeNameAliases = [\"HitPoints\"]","    var value: Int","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Components referencing other entities can store an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference"},{"text":" or an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference"},{"text":". Both are restored correctly.","type":"text"}],"type":"paragraph"},{"anchor":"Save-and-load-a-nexus-with-Codable","level":3,"type":"heading","text":"Save and load a nexus with Codable"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"text":" conforms to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so it can be part of your own scene type:","type":"text"}],"type":"paragraph"},{"code":["struct Scene: Codable {","    var name: String","    var nexus: Nexus","}","","let data = try JSONEncoder().encode(Scene(name: \"Level 1\", nexus: nexus))","","let decoder = JSONDecoder()","decoder.userInfo[.nexusComponentTypes] = [Position.self, Health.self, Parent.self] as [any SerializableComponent.Type]","decoder.userInfo[.nexusEntityResolver] = EntityReferenceResolver(mapping: [:]) \/\/ needed for `Entity` properties","let scene = try decoder.decode(Scene.self, from: data)"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Encoding throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError\/notSerializable(typeName:)"},{"type":"text","text":" for components that are not serializable."},{"text":" ","type":"text"},{"text":"To leave runtime-only components out instead, set ","type":"text"},{"type":"codeVoice","code":"encoder.userInfo[.nexusNonSerializableComponentHandling]"},{"text":" to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling\/skip"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Decoding needs all component types of the scene in ","type":"text"},{"type":"codeVoice","code":"userInfo[.nexusComponentTypes]"},{"text":". Unknown names throw ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRegistryError\/unknownTypeName(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The decoded nexus has the same entity identifiers and creates new entities with the identifiers the original nexus would have used next.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Load-into-an-existing-nexus","level":3,"type":"heading","text":"Load into an existing nexus"},{"inlineContent":[{"text":"To keep a configured nexus, for example one with a delegate, families or a custom generator, use the snapshot API directly:","type":"text"}],"type":"paragraph"},{"code":["var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .throwError)","","let restored = Nexus()","try restored.register([Position.self, Health.self, Parent.self])","var decoder = JSONDecoder()","try restored.restoreSnapshot(from: data, using: &decoder)"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/restoreSnapshot(from:using:)","isActive":true,"type":"reference"},{"text":" keeps the entity identifiers, including their generations. It requires a nexus without entities and emits the usual entity and component events.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/decodeSnapshot(from:using:)","isActive":true,"type":"reference"},{"text":" adds the snapshot as new entities to a populated nexus, for example for prefabs, and returns the mapping from saved to new identifiers.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both roll back all changes if decoding fails.","type":"text"}],"type":"paragraph"},{"anchor":"Use-other-formats","level":3,"type":"heading","text":"Use other formats"},{"inlineContent":[{"text":"The snapshot API accepts any coder conforming to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelEncoder"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelDecoder","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PropertyListEncoder","type":"codeVoice"},{"text":" and their decoders conform out of the box.","type":"text"},{"text":" ","type":"text"},{"text":"For other formats, add the conformance in your project. For example, with ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/jpsim\/Yams"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import Yams","","struct YAMLSceneEncoder: TopLevelEncoder {","    var userInfo: [CodingUserInfoKey: UserInfoValue] = [:]","    func encode<T: Encodable>(_ value: T) throws -> String {","        try YAMLEncoder().encode(value, userInfo: userInfo)","    }","}","","struct YAMLSceneDecoder: TopLevelDecoder {","    var userInfo: [CodingUserInfoKey: UserInfoValue] = [:]","    func decode<T: Decodable>(_ type: T.Type, from yaml: String) throws -> T {","        try YAMLDecoder().decode(type, from: yaml, userInfo: userInfo)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Nexus: Codable","type":"codeVoice"},{"text":" works with any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" coder directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For deterministic output, for example for scene files under version control, sort the keys, e.g. with ","type":"text"},{"type":"codeVoice","code":"JSONEncoder.OutputFormatting.sortedKeys"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"What-a-snapshot-contains","level":3,"type":"heading","text":"What a snapshot contains"},{"items":[{"content":[{"inlineContent":[{"text":"Every entity, including entities without components, with its original identifier. Identifiers of destroyed entities stay stale after loading.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Every serializable component. Components are values, so each entity stores its own copy. Snapshots of format versions 1 and 2 that list a shared component load as one copy per entity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The entity identifier generator state including the generations of recycled slots, if the generator conforms to ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/LinearIncrementingEntityIdGenerator","isActive":true,"type":"reference"},{"text":" does.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Not contained are components that are not serializable, families (they are derived from the components) and the nexus delegate.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The format is versioned by ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot\/formatVersion","isActive":true,"type":"reference"},{"text":". Newer versions of FirebladeECS keep loading older snapshots and reject snapshots written by a newer version.","type":"text"}],"type":"paragraph"},{"text":"Load snapshots of older versions","level":3,"anchor":"Load-snapshots-of-older-versions","type":"heading"},{"inlineContent":[{"text":"Format version 3 stores entity identifiers as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"Snapshots of format versions 1 and 2 (written by FirebladeECS 1.x) contain 32 bit indices only. They still load, with these rules:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Every identifier decodes with generation 0, the first generation of a slot."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The slot index 0 is reserved and never used for entities, so that "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier\/invalid"},{"text":" is unique. An entity with index 0 in an older snapshot therefore gets a fresh identifier on loading. Entity references and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"text":" properties pointing to it are remapped to that identifier.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/restoreSnapshot(from:using:)","type":"reference","isActive":true},{"type":"text","text":" keeps the identifiers of all other entities. The remapped entity takes the next identifier of the restored generator, so it is not necessarily the first one the original nexus would have provided."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/decodeSnapshot(from:using:)"},{"type":"text","text":" lists the entity that had index 0 under "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier\/invalid"},{"type":"text","text":" in the returned mapping."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Generator state of older versions loads with its recycled indices at generation 0.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Saving the loaded nexus writes format version 3.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"FirebladeECS"}],"role":"article","title":"Saving and Loading Scenes"},"kind":"article","abstract":[{"type":"text","text":"Store a whole "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/savingandloadingscenes"]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/EntityIdentifier/invalid":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier\/invalid","title":"invalid","url":"\/documentation\/firebladeecs\/entityidentifier\/invalid","role":"symbol","abstract":[{"text":"Invalid entity identifier","type":"text"}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"invalid"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS16EntityIdentifierV","text":"EntityIdentifier","kind":"typeIdentifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/TopLevelEncoder":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelEncoder","title":"TopLevelEncoder","url":"\/documentation\/firebladeecs\/toplevelencoder","role":"symbol","navigatorTitle":[{"text":"TopLevelEncoder","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A type that can encode values into a native format."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TopLevelEncoder","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","abstract":[{"type":"text","text":"The kinds of events a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"reference","isActive":true},{"type":"text","text":" subscribes to."}],"type":"topic","navigatorT