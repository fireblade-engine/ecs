text":"A component type that can be registered in the component registry of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":"."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"RegistrableComponent"}],"url":"\/documentation\/firebladeecs\/registrablecomponent","title":"RegistrableComponent","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegistrableComponent"}]},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}],"type":"topic","url":"\/documentation\/firebladeecs\/savingandloadingscenes","title":"Saving and Loading Scenes","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","abstract":[{"type":"text","text":"The kinds of events a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"reference","isActive":true},{"type":"text","text":" subscribes to."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"url":"\/documentation\/firebladeecs\/nexuseventmask","title":"NexusEventMask","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventMask"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"type":"topic","url":"\/documentation\/firebladeecs\/reactingtonexusevents","title":"Reacting to Nexus events","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate","title":"NexusEventDelegate","role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/CloneableComponent":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloneableComponent"}],"type":"topic","abstract":[{"type":"text","text":"A component that can create a copy of itself for another entity."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloneableComponent"}],"url":"\/documentation\/firebladeecs\/cloneablecomponent","title":"CloneableComponent"},"doc://FirebladeECS/documentation/FirebladeECS/EntityReferenceResolver":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityReferenceResolver","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Resolves encoded entity identifiers to entities of a target nexus while decoding."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"EntityReferenceResolver","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/entityreferenceresolver","ti