{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" file or use it to create a new project."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Coming from FirebladeECS 1? Read "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","type":"reference"},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"isActive":true,"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"reference"},{"type":"text","text":"."}]},{"type":"heading","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","level":3,"text":"🏛️ Nexus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"isActive":true,"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize a "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" with"}]},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()"]},{"type":"heading","anchor":"%F0%9F%91%A4-Entities","level":3,"text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign values of it to an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}]},{"type":"codeListing","syntax":"swift","code":["let position = Position(x: 1, y: 2)","entity.set(position)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""]},{"type":"heading","anchor":"%F0%9F%91%AA-Families","level":3,"text":"👪 Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"type":"strong","inlineContent":[{"text":"same component types","type":"text"}]},{"type":"text","text":" may belong to one "},{"type":"codeVoice","code":"Family"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"Family"},{"type":"text","text":" has entities as members and component types as family traits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"type":"codeVoice","code":".family"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PlayerInput"},{"type":"text","text":" component, but no "},{"type":"codeVoice","code":"Texture"},{"type":"text","text":" component is created by"}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"reference"},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"type":"codeVoice","code":"forEach(reading:writing:)"},{"type":"text","text":", see "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","type":"reference"},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"type":"heading","anchor":"%F0%9F%A7%91-Singles","level":3,"text":"🧑 Singles"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Single","type":"codeVoice"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference"},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""]},{"type":"heading","anchor":"%F0%9F%94%97-Serialization","level":3,"text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""]}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"FirebladeECS"}],"title":"Getting started with Fireblade ECS","role":"article","roleHeading":"Article"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"references":{"https://github.com/fireblade-engine/ecs-demo":{"title":"Fireblade ECS Demo App","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}],"url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},"https://en.wikipedia.org/wiki/Entity_component_system":{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","title":"ECS","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","titleInlineContent":[{"text":"ECS","type":"text"}]},"https://developer.apple.com/documentation/swift/sequence":{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","title":"Sequence","url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","titleInlineContent":[{"text":"Sequence","type":"text"}]},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"title":"Singleton","titleInlineContent":[{"type":"text","text":"Singleton"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"type":"topic","kind":"article","title":"Reacting to Nexus events","role":"article","url":"\/documentation\/firebladeecs\/reactingtonexusevents"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"kind":"symbol","title":"NexusEvent","role":"symbol","url":"\/documentation\/firebladeecs\/nexusevent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}],"type":"topic","title":"NexusEventDelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","url":"\/documentation\/firebladeecs\/nexuseventdelegate","abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"role":"symbol","navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"role":"collection","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"role":