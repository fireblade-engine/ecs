{"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" file or use it to create a new project."}],"type":"paragraph"},{"code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Coming from FirebladeECS 1? Read "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","isActive":true},{"text":" first.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"type":"text","text":"."}]},{"text":"🏛️ Nexus","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"isActive":true,"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"code":"Entities","type":"codeVoice"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" with","type":"text"}]},{"syntax":"swift","code":["let nexus = Nexus()"],"type":"codeListing"},{"text":"👤 Entities","anchor":"%F0%9F%91%A4-Entities","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"then create entities by letting the ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" generate them."}]},{"syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}]},{"syntax":"swift","type":"codeListing","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"]},{"type":"paragraph","inlineContent":[{"text":"and assign values of it to an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" with","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let position = Position(x: 1, y: 2)","entity.set(position)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""]},{"anchor":"%F0%9F%91%AA-Families","level":3,"type":"heading","text":"👪 Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"inlineContent":[{"text":"same component types","type":"text"}],"type":"strong"},{"type":"text","text":" may belong to one "},{"code":"Family","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A "},{"code":"Family","type":"codeVoice"},{"type":"text","text":" has entities as members and component types as family traits."}]},{"type":"paragraph","inlineContent":[{"text":"Create a family by calling ","type":"text"},{"type":"codeVoice","code":".family"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PlayerInput"},{"type":"text","text":" component, but no "},{"type":"codeVoice","code":"Texture"},{"type":"text","text":" component is created by"}]},{"code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","isActive":true},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"type":"codeVoice","code":"forEach(reading:writing:)"},{"type":"text","text":", see "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","isActive":true},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"%F0%9F%A7%91-Singles","type":"heading","text":"🧑 Singles"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Single","type":"codeVoice"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" entity with exactly "},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference","isActive":true},{"type":"text","text":" character. Single components must conform to the "},{"type":"codeVoice","code":"SingleComponent"},{"type":"text","text":" protocol and will not be available through regular family iteration."}],"type":"paragraph"},{"syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing"},{"text":"🔗 Serialization","level":3,"anchor":"%F0%9F%94%97-Serialization","type":"heading"},{"inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing"}]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"FirebladeECS"}],"role":"article","title":"Getting started with Fireblade ECS","roleHeading":"Article"},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"title":"Choosing a storage","url":"\/documentation\/firebladeecs\/choosingastorage","role":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":", and know what changes."}],"kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}],"title":"NexusEvent","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"NexusEvent","kind":"identifier"}],"type":"topic","url":"\/documentation\/firebladeecs\/nexusevent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}]},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"link","titleInlineContent":[{"type":"text","text":"Singleton"}],"title":"Singleton","url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"https://developer.apple.com/documentation/swift/sequence":{"titleInlineContent":[{"type":"text","text":"Sequence"}],"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"link","title":"Sequence"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StorageKind"}],"abstract":[{"type":"text","text":"The storage a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"text":" keeps its entities and components in.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","type":"topic","url":"\/documentation\/firebladeecs\/nexus\/storagekind","navigatorTitle":[{"text":"StorageKind","kind":"identifier"}],"title":"Nexus.StorageKind","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"role":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","title":"Reading and writing components","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","url":"\/documentation\/firebladeecs\/savingandloadingscenes","type":"topic","role":"article","kind":"article","title":"Saving and Loading Scenes"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"type":"topic","url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","title":"Migrating to FirebladeECS 2","role":"article","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventMask","kind":"identifier"}],"abstract":[{"type":"text","text":"The kinds of events a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","isActive":true},{"type":"text","text":" subscribes to."}],"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","url":"\/documentation\/firebladeecs\/nexuseventmask","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"title":"NexusEventMask","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"url":"\/documentation\/firebladeecs\/componentmacro","title":"Generating components with the component macro"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","url":"\/documentation\/firebladeecs\/nexuseventdelegate","type":"topic","role":"symbol","kind":"symbol","title":"NexusEventDelegate","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"role":"article","kind":"article","title":"Reacting to Nexus events","url":"\/documentation\/firebladeecs\/reactingtonexusevents","type":"topic"},"https://en.wikipedia.org/wiki/Entity_component_system":{"type":"link","url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","titleInlineContent":[{"type":"text","text":"ECS"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","type":"topic","role":"collection","kind":"symbol","title":"FirebladeECS"},"https://github.com/fireblade-engine/ecs-demo":{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}],"title":"Fireblade ECS Demo App","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},"https://en.wiktionary.org/wiki/nexus#Noun":{"titleInlineContent":[{"type":"text","text":"Nexus"}],"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","type":"link","title":"Nexus"}