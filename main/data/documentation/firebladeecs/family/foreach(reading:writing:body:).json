 c, d, e) in","    written.0.value += a.value","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TypeSubstituter.transformPackElementType","type":"codeVoice"},{"text":").","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"FirebladeECS"}],"title":"forEach(reading:writing:body:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" (repeat each ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"), repeat each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"extendedModule":"FirebladeECS",