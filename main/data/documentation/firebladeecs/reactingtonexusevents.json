{"kind":"article","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"metadata":{"role":"article","title":"Reacting to Nexus events","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"sections":[],"abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Structural events are always delivered:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Value change events are opt-in:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"text":": a component was set on an entity that already had one of that type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"text":": a component of one entity was changed in place.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified"},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count"},{"type":"text","text":" is the number of components the pass could write."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}],"type":"paragraph"},{"text":"Subscribing","level":3,"anchor":"Subscribing","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference","isActive":true},{"type":"text","text":" is "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" by default. Return "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference","isActive":true},{"type":"text","text":" to receive value changes:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"reference","isActive":true},{"text":" is an open protocol and later releases add events. Always switch with a ","type":"text"},{"code":"default:","type":"codeVoice"},{"text":" case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The nexus reads ","type":"text"},{"type":"codeVoice","code":"subscribedEvents"},{"text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: ","type":"text"},{"type":"codeVoice","code":"nexus.delegate = observer"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it.","type":"text"}],"type":"paragraph"}]}]},{"text":"Cost","level":3,"anchor":"Cost","type":"heading"},{"inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}],"type":"paragraph"},{"text":"Ordering","level":3,"anchor":"Ordering","type":"heading"},{"inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":" and then "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"type":"text","text":". Setting a component the entity does not have yet delivers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":" only, never "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"type":"text","text":" to delegates that subscribed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Comparison with flecs","level":3,"anchor":"Comparison-with-flecs","type":"heading"},{"inlineContent":[{"type":"text","text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every "},{"type":"codeVoice","code":"set"},{"type":"text","text":" and on an explicit "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"FirebladeECS differs on purpose: in-place writes through the nexus emit "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"type":"text","text":" automatically, so there is no "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"type":"text","text":" only."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentsModified":{"type":"topic","abstract":[{"type