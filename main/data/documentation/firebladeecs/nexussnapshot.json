","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Version history:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2: Adds "},{"code":"entityIdGenerator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sharedComponents","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation."},{"type":"text","text":" "},{"type":"text","text":"The generator state lists recycled identifiers as "},{"type":"codeVoice","code":"recycledIds"},{"type":"text","text":"."}]}]}]},{"inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"text","text":"The slot index 0 is reserved and never used for entities, so an entity with index 0 in an older snapshot"},{"type":"text","text":" "},{"type":"text","text":"gets a fresh identifier when the snapshot is restored, and references to it are remapped to that identifier."},{"type":"text","text":" "},{"type":"text","text":"All other entities keep their identifiers."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"An encodable view of the entities of 