{"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" file or use it to create a new project."}]},{"type":"codeListing","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Coming from FirebladeECS 1? Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"text":" ","type":"text"},{"text":"For a more detailed example, see the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"text":".","type":"text"}]},{"anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","type":"heading","text":"🏛️ Nexus","level":3},{"type":"paragraph","inlineContent":[{"text":"The core element in the Fireblade ECS is the ","type":"text"},{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"code":"Entities","type":"codeVoice"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"text":"You may use more than one ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" at a time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}]},{"code":["let nexus = Nexus()"],"type":"codeListing","syntax":"swift"},{"anchor":"%F0%9F%91%A4-Entities","type":"heading","level":3,"text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your struct or enum to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy."}]},{"code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign values of it to an "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" with"}]},{"code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}]},{"code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing","syntax":"swift"},{"anchor":"%F0%9F%91%AA-Families","type":"heading","level":3,"text":"👪 Families"},{"type":"paragraph","inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"same component types"}]},{"text":" may belong to one ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"Family"},{"text":" has entities as members and component types as family traits.","type":"text"}]},{"inlineContent":[{"text":"Create a family by calling ","type":"text"},{"type":"codeVoice","code":".family"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PlayerInput"},{"text":" component, but no ","type":"text"},{"type":"codeVoice","code":"Texture"},{"text":" component is created by","type":"text"}],"type":"paragraph"},{"code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","isActive":true},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with "},{"type":"codeVoice","code":"forEach(reading:writing:)"},{"type":"text","text":", see "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","isActive":true},{"type":"text","text":"."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"type":"codeVoice","code":"family.entityAndComponents"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"type":"codeVoice","code":"family.entities"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"%F0%9F%A7%91-Singles","type":"heading","text":"🧑 Singles"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Single","type":"codeVoice"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","isActive":true,"type":"reference"},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""]},{"type":"heading","level":3,"anchor":"%F0%9F%94%97-Serialization","text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""]}]}],"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"metadata":{"role":"article","title":"Getting started with Fireblade ECS","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://github.com/fireblade-engine/ecs-demo":{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","type":"link","title":"Fireblade ECS Demo App","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}]},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"role":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","title":"Reading and writing components","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"kind":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents"},"https://developer.apple.com/documentation/swift/sequence":{"type":"link","titleInlineContent":[{"type":"text","text":"Sequence"}],"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence"},"https://en.wiktionary.org/wiki/nexus#Noun":{"type":"link","titleInlineContent":[{"type":"text","text":"Nexus"}],"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","type":"topic","abstract":[{"type":"text","text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus."}],"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","title":"Migrating to FirebladeECS 2","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"abstract":[{"text":"The kinds of events a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"},{"text":" subscribes to.","type":"text"}],"kind":"symbol","url":"\/documentation\/firebladeecs\/nexuseventmask","title":"NexusEventMask","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEventMask"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventMask"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"type":"link","titleInlineContent":[{"type":"text","text":"Singleton"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"kind":"symbol","url":"\/documentation\/firebladeecs","title":"FirebladeECS","role":"collection","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"kind":"article","title":"Reacting to Nexus events","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"url":"\/documentation\/firebladeecs\/reactingtonexusevents","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"title":"Nexus.StorageKind","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/firebladeecs\/nexus\/storagekind","abstract":[{"type":"text","text":"The storage a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"type":"text","text":" keeps its entities and components in."}]},"doc://FirebladeECS/documentation/FirebladeECS/Benchmarks":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","kind":"article","abstract":[{"type":"text","text":"See how FirebladeECS revisions compare on a shared workload suite, and run the comparison yourself."}],"title":"Benchmarks","url":"\/documentation\/firebladeecs\/benchmarks","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"kind":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"type":"text","text":", and know what changes."}],"title":"Choosing a storage","url":"\/documentation\/firebladeecs\/choosingastorage","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","kind":"article","abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"title":"Generating components with the component macro","url":"\/documentation\/firebladeecs\/componentmacro","role":"article"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"kind":"symbol","title":"NexusEvent","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","abstract":[{"type":"text","text":"A marker protocol for all Nexus events."}],"url":"\/documentation\/firebladeecs\/nexusevent","role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","type":"topic","abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate","title":"NexusEventDelegate","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}]},"https://en.wikipedia.org/wiki/Entity_component_system":{"type":"link","titleInlineContent":[{"type":"text","text":"ECS"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"url":"\/documentation\/firebladeecs\/nexus","title":"Nexus","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"title":"Saving and Loading Scenes","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"topic","kind":"article","role":"article","url":"\/documentation\/firebladeecs\/savingandloadingscenes","abstract":[{"type":"text","text":"Store a whole "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":" on disk and load it again with the same entities, components and entity identifiers."}]}}}