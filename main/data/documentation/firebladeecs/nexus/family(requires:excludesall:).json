ternalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"excludedComponents","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier"},{"text":".Type...) -> ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS6FamilyV","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","text":"Family","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type required by members of this family."}]}],"name":"comp"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}]}],"name":"excludedComponents"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The family of entities having 1 required components each."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the 1 required c