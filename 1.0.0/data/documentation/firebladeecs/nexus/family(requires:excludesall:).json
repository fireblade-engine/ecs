":"paragraph"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(1) for existing families, O(N) where N is the number of entities for new families.","type":"text"}]}]}]}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requires:excludesAll:)"},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Comp1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":": any ","kind":"text"},{"kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"kind":"text","text":".Type...) -> "},{"kind":"typeIdentifier","text":"Family1","preciseIdentifier":"s:12FirebladeECS7Family1a"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Comp1"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","modules":[{"name":"FirebladeECS"}],"title":"family(requires:excludesAll:)","role":"symbol","externalID":"s:12FirebladeECS5NexusC6family8requires11excludesAllAA6FamilyVyAA9Requires1VyxGGxm_AA9Component_pXpdtAaMRzlF","symbolKind":"method","extendedModule":"FirebladeECS"},"abstract":[{"text":"Create a family of entities (aka members) having 1 required components.","type":"text"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"url":"\/documentation\/firebladeecs\/component","title":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","abstract":[{"inlineContent":[{"text":"Component","type":"text"}