{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"FirebladeECS"}],"title":"Getting started with Fireblade ECS","role":"article","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" file or use it to create a new project.","type":"text"}]},{"type":"codeListing","code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"0.17.7\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus","text":"🏛️ Nexus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize a "},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" with"}]},{"type":"codeListing","code":["let nexus = Nexus()"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"%F0%9F%91%A4-Entities","text":"👤 Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"code":"Nexus","type":"codeVoice"},{"type":"text","text":" generate them."}]},{"type":"codeListing","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your class to the "},{"code":"Component","type":"codeVoice"},{"type":"text","text":" protocol"}]},{"type":"codeListing","code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"and assign instances of it to an "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" with"}]},{"type":"codeListing","code":["let position = Position(x: 1, y: 2)","entity.assign(position)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can be more efficient by assigning components while creating an entity."}]},{"type":"codeListing","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"syntax":"swift"},{"type":"heading","level":3,"anchor":"%F0%9F%91%AA-Families","text":"👪 Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"inlineContent":[{"text":"same component types","type":"text"}],"type":"strong"},{"type":"text","text":" may belong to one "},{"code":"Family","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A "},{"code":"Family","type":"codeVoice"},{"type":"text","text":" has entities as members and component types as family traits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a family by calling "},{"code":".family","type":"codeVoice"},{"type":"text","text":" with a set of traits on the nexus."},{"type":"text","text":" "},{"type":"text","text":"A family that contains only entities with a "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" and "},{"code":"PlayerInput","type":"codeVoice"},{"type":"text","text":" component, but no "},{"code":"Texture","type":"codeVoice"},{"type":"text","text":" component is created by"}]},{"type":"codeListing","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These entities are cached in the nexus for efficient access and iteration."},{"type":"text","text":" "},{"type":"text","text":"Families conform to the "},{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","type":"reference","isActive":true},{"type":"text","text":" protocol so that members (components)"},{"type":"text","text":" "},{"type":"text","text":"may be iterated and accessed like any other sequence in Swift."},{"type":"text","text":"\n"},{"type":"text","text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call "},{"code":"family.entityAndComponents","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you are only interested in a family’s entities call "},{"code":"family.entities","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"%F0%9F%A7%91-Singles","text":"🧑 Singles"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Single","type":"codeVoice"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","type":"reference"},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"type":"codeListing","code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"syntax":"swift"},{"type":"heading","level":3,"anchor":"%F0%9F%94%97-Serialization","text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}]},{"type":"codeListing","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"abstract":[{"type":"text","text":"Learn the API and key types Fireblade provides to compose your game or app logic."}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"]}],"references":{"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","type":"link","titleInlineContent":[{"type":"text","text":"Singleton"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"https://developer.apple.com/documentation/swift/sequence":{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","title":"Sequence","type":"link","titleInlineContent":[{"type":"text","text":"Sequence"}],"url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"title":"Nexus","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"role":"symbol","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus","abstract":[],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEventDelegate"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"NexusEventDelegate"}],"url":"\/documentation\/firebladeecs\/nexuseventdelegate","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","abstract":[{"type":"text","text":"A delegate for receiving Nexus events and errors."}],"title":"NexusEventDelegate","kind":"symbol","role":"symbol"},"https://en.wikipedia.org/wiki/Entity_component_system":{"identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","type":"link","titleInlineContent":[{"type":"text","text":"ECS"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"kind":"symbol","role":"symbol","title":"NexusEvent","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","navigatorTitle":[{"text":"NexusEvent","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEvent","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexusevent","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS":{"title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/firebladeecs","abstract":[{"type":"text","text":"Seamlessly, consistently, and asynchronously replicate data."}]},"https://en.wiktionary.org/wiki/nexus#Noun":{"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus","type":"link","titleInlineContent":[{"type":"text","text":"Nexus"}],"url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},"https://github.com/fireblade-engine/ecs-demo":{"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","title":"Fireblade ECS Demo App","type":"link","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}],"url":"https:\/\/github.com\/fireblade-engine\/ecs-demo"}}}