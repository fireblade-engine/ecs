{"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Structural events are always delivered:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","type":"reference"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value change events are opt-in:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference"},{"type":"text","text":": a component was set on an entity that already had one of that type."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","type":"reference","isActive":true},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","type":"reference","isActive":true},{"type":"text","text":" is the number of components the pass could write."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}]},{"text":"Subscribing","anchor":"Subscribing","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference"},{"type":"text","text":" is "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference"},{"type":"text","text":" by default. Return "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference"},{"type":"text","text":" to receive value changes:"}]},{"code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","type":"reference","isActive":true},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"code":"default:","type":"codeVoice"},{"type":"text","text":" case."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The nexus reads "},{"code":"subscribedEvents","type":"codeVoice"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"code":"nexus.delegate = observer","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Cost","type":"heading","level":3,"text":"Cost"},{"inlineContent":[{"text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created.","type":"text"}],"type":"paragraph"},{"anchor":"Ordering","type":"heading","level":3,"text":"Ordering"},{"inlineContent":[{"text":"Modifying a component that is missing, with a default value, delivers ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":" and then ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"text":". Setting a component the entity does not have yet delivers ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":" only, never ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"text":". Setting a component the entity already has replaces it and delivers ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced"},{"text":" to delegates that subscribed to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Comparison-with-flecs","type":"heading","level":3,"text":"Comparison with flecs"},{"inlineContent":[{"text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every ","type":"text"},{"type":"codeVoice","code":"set"},{"text":" and on an explicit ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"FirebladeECS differs on purpose: in-place writes through the nexus emit ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified"},{"text":" automatically, so there is no ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call to forget, and setting a missing component emits ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded"},{"text":" only.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","role":"article","title":"Reacting to Nexus events"},"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"title":"Essentials","anchor":"Essentials","generated":true}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"identifier":"doc:\/\/FirebladeECS\/docum