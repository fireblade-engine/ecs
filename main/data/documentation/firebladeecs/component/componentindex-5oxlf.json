{"sections":[],"metadata":{"title":"componentIndex","symbolKind":"property","extendedModule":"FirebladeECS","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","modules":[{"name":"FirebladeECS"}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"roleHeading":"Type Property"},"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storages address their per-type state and the per-entity component bitset by this value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default implementation assigns indices lazily: the first access of a type takes the next free index"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","type":"reference","isActive":true},{"type":"text","text":" for persistent data."}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro will) as a stored ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}]},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(1)","type":"text"}]}],"style":"note"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","abstract":[{"type":"text","text":"The dense index of this component type."}],"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","title":"componentIndex"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","type":"topic","role":"collection","kind":"symbol","title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","url":"\/documentation\/firebladeecs\/component","navigatorTitle":[{"kind":"identifier","text":"Component"}],"title":"Component","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","url":"\/documentation\/firebladeecs\/nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"title":"Nexus","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/Fi