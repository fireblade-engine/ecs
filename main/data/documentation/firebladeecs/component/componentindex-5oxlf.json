{"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"metadata":{"roleHeading":"Type Property","extendedModule":"FirebladeECS","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"modules":[{"name":"FirebladeECS"}],"role":"symbol","symbolKind":"property","title":"componentIndex"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Storages address their per-type state and the per-entity component bitset by this value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"text":" ","type":"text"},{"text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier"},{"type":"text","text":" for persistent data."}]},{"inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Provide your own implementation (the "},{"code":"@Component","type":"codeVoice"},{"text":" macro will) as a stored ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"code":"0 ..< 1_048_576","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(1)"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}]}],"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},{"type":"text","text":"."}],"url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StableComponentIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV"}],"role":"symbol","kind":"symbol","title":"stableIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The dense index of this component type.","type":"text"}],"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","kind":"symbol","role":"symbol","type":"topic","title":"componentIndex"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","kind":"symbol","abstract":[],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"title":"Nexus","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS