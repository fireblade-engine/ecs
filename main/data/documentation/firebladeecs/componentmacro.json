{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro"},"abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/componentmacro"]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The optional "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" product provides the "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" macro."},{"type":"text","text":" "},{"type":"text","text":"It turns a "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" or "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"stable "},{"type":"codeVoice","code":"componentTypeName"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.register(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.registeredComponentTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.componentType(named:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(cloning:context:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"clone(context:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"encode(to:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Nexus: Codable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"componentProperties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"generic inspection, e.g. in editors"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init()"},{"type":"text","text":" if every stored property has a default value (structs)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"key path assignment, state machines"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The core "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" library stays dependency free. Only "},{"type":"codeVoice","code":"FirebladeECSMacros"},{"type":"text","text":" depends on "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"All protocols can also be implemented by hand without the macro."}],"type":"paragraph"},{"level":3,"text":"Adding the product","anchor":"Adding-the-product","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the product to your target. It does not re-export "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":": add the "},{"type":"codeVoice","code":"FirebladeECS"},{"type":"text","text":" product too and import both modules in every file that uses "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":"."}],"type":"paragraph"},{"code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Declaring components","anchor":"Declaring-components","type":"heading"},{"code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"type":"text","text":" takes a "},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"type":"text","text":" set: "},{"type":"codeVoice","code":".cloneable"},{"type":"text","text":", "},{"type":"codeVoice","code":".serializable"},{"type":"text","text":", "},{"type":"codeVoice","code":".inspectable"},{"type":"text","text":" and "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":". Registration is always implemented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" leaves serialization entirely to you."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A "},{"type":"codeVoice","code":"public"},{"type":"text","text":" or "},{"type":"codeVoice","code":"package"},{"type":"text","text":" struct, and a struct that declares initializers, gets a generated "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" in its body (the implicit "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" itself, and it gets "},{"type":"codeVoice","code":"DefaultInitializable"},{"type":"text","text":" only if it declares "},{"type":"codeVoice","code":"init()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro stores "},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"type":"codeVoice","code":"componentIndex"},{"type":"text","text":" to opt out."}]}]}],"type":"unorderedList"},{"level":3,"text":"Value types and diagnostics","anchor":"Value-types-and-diagnostics","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@Component"},{"type":"text","text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property spelled "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Entity?"},{"type":"text","text":", "},{"type":"codeVoice","code":"[Entity]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set<Entity>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Key: Entity]"},{"type":"text","text":" is an error with a fix-it that replaces "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" by "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true},{"type":"text","text":". An "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","isActive":true},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}],"type":"paragraph"},{"level":3,"text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots","type":"heading"},{"code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true},{"type":"text","text":" starts with a "},{"type":"codeVoice","code":"formatVersion"},{"type":"text","text":" and keeps the original entity identifiers."},{"type":"text","text":" "},{"type":"text","text":"Decoding creates new entities, remaps entity references to them through an "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true},{"type":"text","text":", and rejects snapshots written in a newer format version."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials"}],"metadata":{"modules":[{"name":"FirebladeECS"}],"roleHeading":"Article","title":"Generating components with the component macro","role":"article"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"type":"topic","kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","role":"article","title":"Saving and Loading Scenes","url":"\/documentation\/firebladeecs\/savingandloadingscenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference"},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","abstract":[{"type":"text","text":"A component type that can be registered in the component registry of a "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RegistrableComponent"}],"url":"\/documentation\/firebladeecs\/registrablecomponent","title":"RegistrableComponent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegistrableComponent"}],"type":"topic"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}],"title":"Migrating to FirebladeECS 2","type":"topic","role":"artic