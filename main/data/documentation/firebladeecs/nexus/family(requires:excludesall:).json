{"abstract":[{"type":"text","text":"Create a family of entities (aka members) having 1 required components."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"comp","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"excludedComponents","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":".Type...) -> ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS6FamilyV","text":"Family","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"comp","content":[{"inlineContent":[{"type":"text","text":"Component type required by members of this family."}],"type":"paragraph"}]},{"name":"excludedComponents","content":[{"inlineContent":[{"type":"text","text":"All component types that must not be assigned to an entity in this family."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The family of entities having 1 required components each.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A family is a collection of entities with uniform component types per entity.","type":"text"},{"text":" ","type":"text"},{"text":"Entities that are be part of this family will have at least the 1 required components,","type":"text"},{"text":" ","type":"text"},{"text":"but may have more components assigned.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A family is just a view on (component) data, creating them is cheap.","type":"text"},{"text":" ","type":"text"},{"text":"Use them to iterate efficiently over entities with the same components assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Families with the same requirements provide a view on the same collection of entities (aka members).","type":"text"},{"text":" ","type":"text"},{"text":"A family conforms to the ","type":"text"},{"code":"LazySequenceProtocol","type":"codeVoice"},{"text":" and therefore can be accessed like any other (lazy) sequence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"General usage"}],"type":"strong"}]},{"type":"codeListing","code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Caveats"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Component types must be unique per family"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Component type order is arbitrary"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"ty