,"}"],"type":"codeListing","syntax":"json"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entityIdGenerator"},{"type":"text","text":" is present if the generator of the nexus is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/PersistableEntityIdentifierGenerator"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sharedComponents","type":"codeVoice"},{"text":" is present for entities that share a component instance with an entity listed before them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are values since 2.0, so snapshots never write it; it is still read from older data.","type":"text"},{"text":" ","type":"text"},{"text":"It maps the component type name to the identifier of the entity that encodes the instance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Version history:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"1: Entities and their components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2: Adds ","type":"text"},{"code":"entityIdGenerator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sharedComponents","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"3: Entity identifiers are encoded as 64 bit raw values holding the slot index and generation.","type":"text"},{"text":" ","type":"text"},{"text":"The generator state lists recycled identifiers as ","type":"text"},{"code":"recycledIds","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snapshots of versions 1 and 2 still load. Their identifiers decode with generation 0."},{"type":"text","text":" "},{"type":"text","text":"The slot index 0 is reserved and never used for entities, so a