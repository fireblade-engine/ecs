{"kind":"article","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents"},"metadata":{"role":"article","roleHeading":"Article","title":"Reacting to Nexus events","modules":[{"name":"FirebladeECS"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"text":" reports what happens to its entities, components and families to its ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Structural events are always delivered:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","isActive":true,"type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Value change events are opt-in:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true,"type":"reference"},{"text":": a component was set on an entity that already had one of that type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true,"type":"reference"},{"text":": a component of one entity was changed in place.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true,"type":"reference"},{"text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","isActive":true,"type":"reference"},{"text":" is the number of components the pass could write.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Every event names its entity with the generational ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true,"type":"reference"},{"text":", so a stale identifier never matches a later entity in the same slot.","type":"text"}]},{"anchor":"Subscribing","level":3,"text":"Subscribing","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference"},{"text":" is ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"type":"text","text":" by default. Return "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","isActive":true},{"text":" to receive value changes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","isActive":true,"type":"reference"},{"text":" is an open protocol and later releases add events. Always switch with a ","type":"text"},{"code":"default:","type":"codeVoice"},{"text":" case.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The nexus reads ","type":"text"},{"code":"subscribedEvents","type":"codeVoice"},{"text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: ","type":"text"},{"code":"nexus.delegate = observer","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true,"type":"reference"},{"text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Cost","level":3,"text":"Cost","type":"heading"},{"inlineContent":[{"text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created.","type":"text"}],"type":"paragraph"},{"anchor":"Ordering","level":3,"text":"Ordering","type":"heading"},{"inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"text":" and then ","type":"text"},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"text":". Setting a component the entity does not have yet delivers ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"text":" only, never ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference"},{"text":". Setting a component the entity already has replaces it and delivers ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference"},{"text":" to delegates that subscribed to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Comparison with flecs","type":"heading","anchor":"Comparison-with-flecs"},{"inlineContent":[{"text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every ","type":"text"},{"type":"codeVoice","code":"set"},{"text":" and on an explicit ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"FirebladeECS differs on purpose: in-place writes through the nexus emit ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference"},{"text":" automatically, so there is no ","type":"text"},{"type":"codeVoice","code":"modified()"},{"text":" call to forget, and setting a missing component emits ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference"},{"text":" only.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentRemoved":{"identifier":"doc:\/\/FirebladeECS\