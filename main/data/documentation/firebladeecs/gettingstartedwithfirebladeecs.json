{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"An ECS comprises entities composed from components of data, with systems which operate on the components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Extend the following lines in your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" file or use it to create a new project.","type":"text"}]},{"syntax":"swift","code":["\/\/ swift-tools-version:6.2","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"2.0.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [","                .product(name: \"FirebladeECS\", package: \"ecs\")","                \/\/ optional: .product(name: \"FirebladeECSMacros\", package: \"ecs\"),","                \/\/           .product(name: \"FirebladeFSM\", package: \"ecs\")","            ])","    ]",")",""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Coming from FirebladeECS 1? Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This article introduces you to the key concepts of Fireblade ECS’s API.","type":"text"},{"text":" ","type":"text"},{"text":"For a more detailed example, see the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"text":".","type":"text"}]},{"text":"🏛️ Nexus","level":3,"type":"heading","anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus"},{"type":"paragraph","inlineContent":[{"text":"The core element in the Fireblade ECS is the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It acts as a centralized way to store, access and manage entities and their components.","type":"text"},{"text":" ","type":"text"},{"text":"A single ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" may (theoretically) hold up to 4294967295 ","type":"text"},{"code":"Entities","type":"codeVoice"},{"text":" at a time.","type":"text"},{"text":"\n","type":"text"},{"text":"You may use more than one ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" at a time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" with","type":"text"}]},{"syntax":"swift","code":["let nexus = Nexus()"],"type":"codeListing"},{"text":"👤 Entities","level":3,"type":"heading","anchor":"%F0%9F%91%A4-Entities"},{"type":"paragraph","inlineContent":[{"text":"then create entities by letting the ","type":"text"},{"code":"Nexus","type":"codeVoice"},{"text":" generate them.","type":"text"}]},{"syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"To define components, conform your struct or enum to the ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":" protocol. Components are value types: the nexus stores them by value and reading one returns a copy.","type":"text"}]},{"syntax":"swift","code":["struct Position: Component {","    var x: Int = 0","    var y: Int = 0","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"and assign values of it to an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" with","type":"text"}]},{"syntax":"swift","code":["let position = Position(x: 1, y: 2)","entity.set(position)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}]},{"syntax":"swift","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""],"type":"codeListing"},{"text":"👪 Families","level":3,"type":"heading","anchor":"%F0%9F%91%AA-Families"},{"type":"paragraph","inlineContent":[{"text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them.","type":"text"},{"text":"\n","type":"text"},{"text":"Entities with the ","type":"text"},{"inlineContent":[{"type":"text","text":"same component types"}],"type":"strong"},{"text":" may belong to one ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":" has entities as members and component types as family traits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Create a family by calling ","type":"text"},{"code":".family","type":"codeVoice"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PlayerInput","type":"codeVoice"},{"text":" component, but no ","type":"text"},{"code":"Texture","type":"codeVoice"},{"text":" component is created by","type":"text"}]},{"syntax":"swift","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"These entities are cached in the nexus for efficient access and iteration.","type":"text"},{"text":" ","type":"text"},{"text":"Families conform to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"text":" protocol so that members (components)","type":"text"},{"text":" ","type":"text"},{"text":"may be iterated and accessed like any other sequence in Swift. Iteration yields copies; update components in place with ","type":"text"},{"code":"forEach(reading:writing:)","type":"codeVoice"},{"text":", see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents"},{"text":".","type":"text"},{"text":"\n","type":"text"},{"text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call ","type":"text"},{"code":"family.entityAndComponents","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"code":"family.entities","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        \/\/ read-only iteration yields copies of the components","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            _ = mov.position","            _ = input.command","        }","    }","","    func move() {","        \/\/ to write, state the access: reads arrive as copies, writes as `inout`","        family.forEach(reading: PlayerInput.self, writing: Movement.self) { input, mov in","            mov.position.x += input.command.dx","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"],"type":"codeListing"},{"text":"🧑 Singles","level":3,"type":"heading","anchor":"%F0%9F%A7%91-Singles"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Single","type":"codeVoice"},{"text":" on the other hand is a special kind of family that holds exactly ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" entity with exactly ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},{"text":" character. Single components must conform to the ","type":"text"},{"code":"SingleComponent","type":"codeVoice"},{"text":" protocol and will not be available through regular family iteration.","type":"text"}]},{"syntax":"swift","code":["struct GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        \/\/ `component` is a copy; write with `set` or `modify`","        gameState.modify { $0.quitGame = true }","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""],"type":"codeListing"},{"text":"🔗 Serialization","level":3,"type":"heading","anchor":"%F0%9F%94%97-Serialization"},{"type":"paragraph","inlineContent":[{"text":"To serialize\/deserialize entities you must conform their assigned components to the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":"\n","type":"text"},{"text":"Conforming components can then be serialized per family like this:","type":"text"}]},{"syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Getting started with Fireblade ECS","modules":[{"name":"FirebladeECS"}]},"variants":[{"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentMacro":{"url":"\/documentation\/firebladeecs\/componentmacro","abstract":[{"text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","role":"article","type":"topic","title":"Generating components with the component macro"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventDelegate":{"url":"\/documentation\/firebladeecs\/nexuseventdelegate","abstract":[{"text":"A delegate for receiving Nexus events and errors.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventDelegate","kind":"identifier"}],"navigatorTitle":[{"text":"NexusEventDelegate","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","role":"symbol","type":"topic","title":"NexusEventDelegate"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/StorageKind":{"url":"\/documentation\/firebladeecs\/nexus\/storagekind","abstract":[{"text":"The storage a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"text":" keeps its entities and components in.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"StorageKind"}],"navigatorTitle":[{"kind":"identifier","text":"StorageKind"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind","role":"symbol","type":"topic","title":"Nexus.StorageKind"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEvent":{"url":"\/documentation\/firebladeecs\/nexusevent","abstract":[{"text":"A marker protocol for all Nexus events.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusEvent"}],"navigatorTitle":[{"kind":"identifier","text":"NexusEvent"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","role":"symbol","type":"topic","title":"NexusEvent"},"doc://FirebladeECS/documentation/FirebladeECS/NexusEventMask":{"url":"\/documentation\/firebladeecs\/nexuseventmask","abstract":[{"text":"The kinds of events a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"},{"text":" subscribes to.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NexusEventMask","kind":"identifier"}],"navigatorTitle":[{"text":"NexusEventMask","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","role":"symbol","type":"topic","title":"NexusEventMask"},"doc://FirebladeECS/documentation/FirebladeECS/SavingAndLoadingScenes":{"url":"\/documentation\/firebladeecs\/savingandloadingscenes","abstract":[{"text":"Store a whole ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"text":" on disk and load it again with the same entities, components and entity identifiers.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","role":"article","type":"topic","title":"Saving and Loading Scenes"},"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"url":"\/documentation\/firebladeecs\/readingandwritingcomponents","abstract":[{"text":"Read a copy, replace a component or change it in place.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","role":"article","type":"topic","title":"Reading and writing components"},"https://github.com/fireblade-engine/ecs-demo":{"title":"Fireblade ECS Demo App","titleInlineContent":[{"text":"Fireblade ECS Demo App","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo","url":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},"doc://FirebladeECS/documentation/FirebladeECS/ReactingToNexusEvents":{"url":"\/documentation\/firebladeecs\/reactingtonexusevents","abstract":[{"text":"Observe structural changes and, on request, changes of component values.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","role":"article","type":"topic","title":"Reacting to Nexus events"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"url":"\/documentation\/firebladeecs\/nexus","abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Nexus"}],"navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","role":"symbol","type":"topic","title":"Nexus"},"https://en.wikipedia.org/wiki/Singleton_(mathematics)":{"type":"link","identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)","title":"Singleton","titleInlineContent":[{"text":"Singleton","type":"text"}],"url":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"url":"\/documentation\/firebladeecs\/migratingtofirebladeecs2","abstract":[{"text":"Move a project from FirebladeECS 1.x to 2.0: components become value types, and every write goes through the nexus.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","role":"article","type":"topic","title":"Migrating to FirebladeECS 2"},"https://en.wikipedia.org/wiki/Entity_component_system":{"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","title":"ECS","titleInlineContent":[{"text":"ECS","type":"text"}],"type":"link"},"https://developer.apple.com/documentation/swift/sequence":{"title":"Sequence","url":"https:\/\/developer.apple.com\/documentation\/swift\/sequence","titleInlineContent":[{"text":"Sequence","type":"text"}],"type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},"doc://FirebladeECS/documentation/FirebladeECS":{"url":"\/documentation\/firebladeecs","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"type":"topic","role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","title":"FirebladeECS","kind":"symbol"},"https://en.wiktionary.org/wiki/nexus#Noun":{"type":"link","url":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun","title":"Nexus","titleInlineContent":[{"text":"Nexus","type":"text"}]},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"url":"\/documentation\/firebladeecs\/choosingastorage","abstract":[{"text":"Pick the sparse-set or the archetype storage for a ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true,"type":"reference"},{"text":", and know what changes.","type":"text"}],"kind":"article","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","role":"article","type":"topic","title":"Choosing a storage"}}}