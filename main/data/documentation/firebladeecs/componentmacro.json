{"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The optional ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" product provides the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro.","type":"text"},{"text":" ","type":"text"},{"text":"It turns a ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" into a component and implements a set of component protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Protocol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enables","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.register(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.registeredComponentTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.componentType(named:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"init(cloning:context:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clone(context:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"entity.clone()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.clone(entities:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.clone(into:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.encodeSnapshot(using:handling:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.restoreSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.decodeSnapshot(from:using:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Nexus: Codable","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"componentProperties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"init()","type":"codeVoice"},{"text":" if every stored property has a default value (structs)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"key path assignment, state machines","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"static let componentIndex","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"typed lookups read a plain static instead of taking the registry lock","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"The core ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" library stays dependency free. Only ","type":"text"},{"type":"codeVoice","code":"FirebladeECSMacros"},{"text":" depends on ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}]},{"type":"heading","level":3,"text":"Adding the product","anchor":"Adding-the-product"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":": add the ","type":"text"},{"type":"codeVoice","code":"FirebladeECS"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"]},{"type":"heading","level":3,"text":"Declaring components","anchor":"Declaring-components"},{"type":"codeListing","syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"type":"codeVoice","code":"static let componentTypeName"},{"type":"text","text":" to override it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"type":"text","text":" takes a "},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"type":"text","text":" set: "},{"type":"codeVoice","code":".cloneable"},{"type":"text","text":", "},{"type":"codeVoice","code":".serializable"},{"type":"text","text":", "},{"type":"codeVoice","code":".inspectable"},{"type":"text","text":" and "},{"type":"codeVoice","code":".defaultInit"},{"type":"text","text":". Registration is always implemented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@ComponentIgnored"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Serialized properties need an explicit type annotation. "},{"type":"codeVoice","code":"let"},{"type":"text","text":" constants with an initial value are not serialized."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" leaves serialization entirely to you."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A "},{"type":"codeVoice","code":"public"},{"type":"text","text":" or "},{"type":"codeVoice","code":"package"},{"type":"text","text":" struct, and a struct that declares initializers, gets a generated "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" in its body (the implicit "},{"type":"codeVoice","code":"init()"},{"type":"text","text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" itself, and it gets "},{"type":"codeVoice","code":"DefaultInitializable"},{"type":"text","text":" only if it declares "},{"type":"codeVoice","code":"init()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The macro stores "},{"type":"codeVoice","code":"static let componentIndex = registeredComponentIndex"},{"type":"text","text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own "},{"type":"codeVoice","code":"componentIndex"},{"type":"text","text":" to opt out."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Value types and diagnostics","anchor":"Value-types-and-diagnostics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component"},{"text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property spelled ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Entity?"},{"text":", ","type":"text"},{"type":"codeVoice","code":"[Entity]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Set<Entity>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[Key: Entity]"},{"text":" is an error with a fix-it that replaces ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" by ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier"},{"text":". An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity"},{"text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" behind a typealias or in a nested type is not diagnosed and stays a convention.","type":"text"}]},{"type":"heading","level":3,"text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots"},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"]},{"type":"paragraph","inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},{"text":" starts with a ","type":"text"},{"type":"codeVoice","code":"formatVersion"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"abstract":[{"type":"text","text":"Implement registration, cloning, snapshots and inspection for a component from its stored properties."}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"FirebladeECS"}],"t