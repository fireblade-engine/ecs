{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReactingToNexusEvents","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"FirebladeECS"}],"role":"article","title":"Reacting to Nexus events"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Observe structural changes and, on request, changes of component values."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":" reports what happens to its entities, components and families to its "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/delegate","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Structural events are always delivered:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityCreated","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityDestroyed","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentRemoved","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberAdded","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/FamilyMemberRemoved","type":"reference","isActive":true}]}]}]},{"inlineContent":[{"type":"text","text":"Value change events are opt-in:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","isActive":true},{"type":"text","text":": a component was set on an entity that already had one of that type."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","isActive":true},{"type":"text","text":": a component of one entity was changed in place."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":": a bulk write pass changed the components of a type. One event per pass, not one per entity; "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified\/count","type":"reference","isActive":true},{"type":"text","text":" is the number of components the pass could write."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every event names its entity with the generational "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","isActive":true,"type":"reference"},{"type":"text","text":", so a stale identifier never matches a later entity in the same slot."}]},{"level":3,"type":"heading","anchor":"Subscribing","text":"Subscribing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate\/subscribedEvents","type":"reference","isActive":true},{"type":"text","text":" is "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","type":"reference","isActive":true},{"type":"text","text":" by default. Return "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/all","type":"reference","isActive":true},{"type":"text","text":" to receive value changes:"}]},{"code":["final class Observer: NexusEventDelegate {","    var subscribedEvents: NexusEventMask { .all }","","    func nexusEvent(_ event: NexusEvent) {","        switch event {","        case let added as ComponentAdded:","            print(\"added\", added.component, \"to\", added.toEntity)","        case let modified as ComponentModified:","            print(\"modified\", modified.component, \"of\", modified.entityId)","        default:","            break","        }","    }","","    func nexusNonFatalError(_ message: String) {}","}","","nexus.delegate = observer"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","isActive":true},{"type":"text","text":" is an open protocol and later releases add events. Always switch with a "},{"code":"default:","type":"codeVoice"},{"type":"text","text":" case."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The nexus reads "},{"code":"subscribedEvents","type":"codeVoice"},{"type":"text","text":" once, when the delegate is assigned. After changing the subscription, assign the delegate again: "},{"code":"nexus.delegate = observer","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/structural","isActive":true},{"type":"text","text":" is informational. Structural events are always delivered, as in FirebladeECS 1, also to a delegate whose mask does not contain it."}],"type":"paragraph"}]}]},{"level":3,"type":"heading","anchor":"Cost","text":"Cost"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the default mask a write to a component costs one branch on a flag the nexus caches, and nothing else: the delegate is not called and no event is created."}]},{"level":3,"type":"heading","anchor":"Ordering","text":"Ordering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifying a component that is missing, with a default value, delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" and then "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":". Setting a component the entity does not have yet delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only, never "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":". Setting a component the entity already has replaces it and delivers "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","type":"reference","isActive":true},{"type":"text","text":" to delegates that subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"Comparison-with-flecs","text":"Comparison with flecs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"flecs observers (OnAdd, OnRemove, OnSet) fire on an actual add or remove, and OnSet fires on every "},{"type":"codeVoice","code":"set"},{"type":"text","text":" and on an explicit "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call, but not on direct writes through a pointer. Setting a missing component fires OnAdd and then OnSet. Observers cost nothing while none exist."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"FirebladeECS differs on purpose: in-place writes through the nexus emit "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentModified","type":"reference","isActive":true},{"type":"text","text":" automatically, so there is no "},{"type":"codeVoice","code":"modified()"},{"type":"text","text":" call to forget, and setting a missing component emits "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentAdded","type":"reference","isActive":true},{"type":"text","text":" only."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Benchmarks","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/StorageKind"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"sections":[],"variants":[{"paths":["\/documentation\/firebladeecs\/reactingtonexusevents"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentRemoved":{"url":"\/documentation\/firebladeec