{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The dense index of this component type."}],"variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storages address their per-type state and the per-entity component bitset by this value."}]},{"type":"paragraph","inlineContent":[{"text":"The default implementation assigns indices lazily: the first access of a type takes the next free index","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true},{"type":"text","text":" for persistent data."}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Provide your own implementation (the "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" macro will) as a stored "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" for a plain load,"},{"type":"text","text":" "},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(1)","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"property","modules":[{"name":"FirebladeECS"}],"role":"symbol","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","extendedModule":"FirebladeECS","roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"componentIndex"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","isActive":true},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stableIdentifier","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StableComponentIdentifier","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV"}],"title":"stableIdentifier"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"kind":"symbol","url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","required":true,"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","abstract":[{"type":"text","text":"The stable, unique name of this component type."}],"defaultImplementations":1,"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentTypeName","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"componentTypeName"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"Component"}]}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/component","type":"topic","title":"Component"},"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","role":"collection","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","type":"topic","title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"kind":"symbol","title":"componentIndex","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","type":"topic","abstract":[{"type":"text","text":"The dense index of this component type."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/nexus","type":"topic","title":"Nexus"}}}