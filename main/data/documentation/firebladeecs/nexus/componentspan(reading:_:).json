{"abstract":[{"type":"text","text":"Gives "},{"code":"body","type":"codeVoice"},{"type":"text","text":" read access to all components of a type as one contiguous "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)"},"sections":[],"metadata":{"extendedModule":"FirebladeECS","symbolKind":"method","externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"text":"C","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"}],"roleHeading":"Instance Method","title":"componentSpan(reading:_:)","role":"symbol","modules":[{"name":"FirebladeECS"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"26.0"}]},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"reading"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"type"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"text":".Type, ","kind":"text"},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"body"},{"text":": (","kind":"text"},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"kind":"text","text":">) "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","text":"Component"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type."}]}],"name":"type"},{"name":"body","content":[{"inlineContent":[{"text":"Receives the span; its result is returned.","type":"text"}],"type":"paragraph"}]}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"text":"removed. It is zero copy: it views the storage itself. Because ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"type":"text","text":", it cannot leave "},{"code":"body","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Span","type":"codeVoice"},{"text":" is not a ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":": loop over ","type":"text"},{"code":"indices","type":"codeVoice"},{"text":". Element access is bounds checked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"While ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or"},{"type":"text","text":" "},{"type":"text","text":"removing components, replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":") and writes to the type stop the process with a message,"},{"type":"text","text":" "},{"type":"text","text":"since they would move or change what the span views. Reading the component through the nexus and reading"},{"type":"text","text":" "},{"text":"the type again are fine. Collect changes and apply them after the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An empty storage (or a type no entity ever had) passes an empty span.","type":"text"}]},{"text":"Storage","type":"heading","level":3,"anchor":"Storage"},{"inlineContent":[{"text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself.","type":"text"},{"text":" ","type":"text"},{"text":"The archetype storage keeps one column per table (one table per component set), so entities with different","type":"text"},{"text":" ","type":"text"},{"text":"component sets are not next to each other. If one table holds all components of the type the span views its column,","type":"text"},{"text":" ","type":"text"},{"text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs","type":"text"},{"text":" ","type":"text"},{"text":"one allocation and O(N) copying per call and is released after ","type":"text"},{"type":"codeVoice","code":"body"},{"type":"text","text":". Use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","isActive":true},{"type":"text","text":" to get zero copy spans, one batch per table."}],"type":"paragraph"},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(1) plus "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/ReadingAndWritingComponents":{"type":"topic","abstract":[{"type":"text","text":"Read a copy, replace a component or change it in place."}],"role":"article","url":"\/documentation\/firebladeecs\/readingandwritingcomponents","title":"Reading and writing components","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/ChoosingAStorage":{"title":"Choosing a storage","url":"\/documentation\/firebladeecs\/choosingastorage","role":"article","type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","abstract":[{"type":"text","text":"Pick the sparse-set or the archetype storage for a "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":", and know what changes."}],"kind":"article"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","url":"\/documentation\/firebladeecs\/component","navigatorTitle":[{"kind":"identifier","text":"Component"}],"title":"Component","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS":{"abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","type":"topic","role":"collection","kind":"symbol","title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus/componentSpan(reading:_:)":{"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"