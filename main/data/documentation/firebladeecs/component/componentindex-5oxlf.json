..< n"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" types used so far) and unbounded.","type":"text"},{"text":" ","type":"text"},{"text":"They depend on the order of first use and are not stable between process launches;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier"},{"text":" for persistent data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static.","type":"text"},{"text":" ","type":"text"},{"text":"Provide your own implementation (the ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro will) as a stored ","type":"text"},{"type":"codeVoice","code":"static let"},{"text":" for a plain load,","type":"text"},{"text":" ","type":"text"},{"text":"but only if you can guarantee that two types never share an index and that it is in ","type":"text"},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type.","type":"text"},{"text":" ","type":"text"},{"text":"A collision or an index out of range traps at first use of the type in a nexus.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(1)","type":"text"}]}],"name":"Complexity"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The dense index of this component type.","type":"text"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swif