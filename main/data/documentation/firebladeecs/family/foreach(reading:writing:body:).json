mentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the fallback for more than 4 read or 4 written types; fewer are served by the overloads with fixed arity,"},{"text":" ","type":"text"},{"type":"text","text":"which are faster because their loop specializes. The contract is the one of those overloads (see"},{"type":"text","text":" "},{"text":"the overload that reads 1 and writes 1 type), with two differences in shape:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"body"},{"type":"text","text":" receives the written components first, as one "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" tuple, then the read components. Swift can not"},{"type":"text","text":" "},{"type":"text","text":"express "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" pack parameters in a closure, and two packs in one closure type can not be inferred."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The written components are copied out of the storage into the tuple and back after "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returned, so a"},{"type":"text","text":" "},{"type":"text","text":"write is not visible in the storage before "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns."}]}]}]},{"syntax":"swift","type":"codeListing","code":["family.forEach(reading: A.self, B.self, C.self, D.self, E.self, writing: X.self, Y.self) { (written: inout (X, Y), a, b, c, d, e) in","    written.0.value += a.value","}"]},{"type":"paragraph","inlineContent":[{"text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TypeSubstituter.transformPackElementType"},{"text":").","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)"},"references":{"doc://FirebladeECS/documentation/FirebladeECS":{"type":"topic","title":"FirebladeECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","url":"\/documentation\/firebladeecs","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"role":"collection","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:body:)":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)","url":"\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)","conformance":{"constraints":[{"type":"codeVoice","code":"each C"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"type":"topic","kind":"symbol","title":"forEach(reading:writing:body:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEach","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":").Type, ","kind":"text"},{"text":"writing","