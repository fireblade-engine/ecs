lly qualified type name. Declare ","type":"text"},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"code":"static let componentTypeNameAliases","type":"codeVoice"},{"type":"text","text":" so existing snapshots keep loading. See "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@Component(excluding:)","type":"codeVoice"},{"text":" takes a ","type":"text"},{"code":"ComponentMacroFeatures","type":"codeVoice"},{"text":" set: ","type":"text"},{"code":".cloneable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".serializable","type":"codeVoice"},{"text":", ","type":"text"},{"code":".inspectable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":". Registration is always implemented.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"type":"text","text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"code":"CodingKeys","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" leaves serialization entirely to you."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The generated initializers are designated initializers, so the class no longer gets an implicit ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":". Keep ","type":"text"},{"code":".defaultInit","type":"codeVoice"},{"text":" enabled or declare your own initializers.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"text":"Registering, cloning and snapshots","anchor":"Registering-cloning-and-snapshots","type":"heading"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"inlineContent":[{"text":"Component types are registered automatically the first time an instance is assigned.","type":"text"},{"text":" ","type":"text"},{"text":"Register them explicitly before decoding snapshots that reference them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","isActive":true,"type":"reference"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","isActive":true,"type":"reference"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"typ