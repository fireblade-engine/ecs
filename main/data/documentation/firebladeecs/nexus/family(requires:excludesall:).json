{"kind":"symbol","abstract":[{"type":"text","text":"Create a family of entities (aka members) having 1 required components."}],"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/family(requires:excludesall:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/family(requires:excludesAll:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Comp","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"requires","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"comp","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"excludesAll","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"excludedComponents","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":".Type...) -> ","kind":"text"},{"text":"Family","preciseIdentifier":"s:12FirebladeECS6FamilyV","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"},{"text":"<","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Comp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Comp