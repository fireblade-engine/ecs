rl":"\/documentation\/firebladeecs\/component","type":"topic","kind":"symbol","abstract":[{"inlineContent":[{"text":"Component","type":"text"}],"type":"strong"}]},"doc://FirebladeECS/documentation/FirebladeECS":{"role":"collection","url":"\/documentation\/firebladeecs","kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","type":"topic","abstract":[{"text":"A lightweight, fast and easy to use Entity-Component System in Swift.","type":"text"}],"title":"FirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Nexus","kind":"identifier"}],"title":"Nexus","role":"symbol","navigatorTitle":[{"text":"Nexus","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","kind":"symbol","url":"\/documentation\/firebladeecs\/nexus","type":"topic","abstract":[]},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","abstract":[{"text":"The stable, unique name of this component type.","type":"text"}],"title":"componentTypeName","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","type":"topic","defaultImplementations":1}}}