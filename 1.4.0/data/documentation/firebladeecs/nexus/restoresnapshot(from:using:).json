{"abstract":[{"text":"Restores a snapshot into this nexus, keeping the encoded entity identifiers.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/nexus\/restoresnapshot(from:using:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restoreSnapshot"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"SnapshotDecoder"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SnapshotDecoder"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Input","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelDecoder\/Input","preciseIdentifier":"s:12FirebladeECS15TopLevelDecoderP5InputQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"SnapshotDecoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"SnapshotDecoder"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"TopLevelDecoder","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/TopLevelDecoder","preciseIdentifier":"s:12FirebladeECS15TopLevelDecoderP"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The encoded snapshot.","type":"text"}]}],"name":"data"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The decoder to use.","type":"text"}]}],"name":"decoder"}],