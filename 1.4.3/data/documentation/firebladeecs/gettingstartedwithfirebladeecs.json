{"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"FirebladeECS"}],"title":"Getting started with Fireblade ECS"},"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fireblade ECS is a dependency free, Swift language implementation of an Entity-Component-System ("},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"An ECS comprises entities composed from components of data, with systems which operate on the components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend the following lines in your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" file or use it to create a new project."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ swift-tools-version:6.1","","import PackageDescription","","let package = Package(","    name: \"YourPackageName\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/fireblade-engine\/ecs.git\", from: \"1.2.0\")","    ],","    targets: [","        .target(","            name: \"YourTargetName\",","            dependencies: [\"FirebladeECS\"])","    ]",")",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article introduces you to the key concepts of Fireblade ECS’s API."},{"type":"text","text":" "},{"type":"text","text":"For a more detailed example, see the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/fireblade-engine\/ecs-demo"},{"type":"text","text":"."}]},{"text":"🏛️ Nexus","type":"heading","level":3,"anchor":"%F0%9F%8F%9B%EF%B8%8F-Nexus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core element in the Fireblade ECS is the "},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wiktionary.org\/wiki\/nexus#Noun"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It acts as a centralized way to store, access and manage entities and their components."},{"type":"text","text":" "},{"type":"text","text":"A single "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" may (theoretically) hold up to 4294967295 "},{"type":"codeVoice","code":"Entities"},{"type":"text","text":" at a time."},{"type":"text","text":"\n"},{"type":"text","text":"You may use more than one "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" at a time."}]},{"type":"paragraph","inlineContent":[{"text":"Initialize a ","type":"text"},{"type":"codeVoice","code":"Nexus"},{"text":" with","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let nexus = Nexus()"]},{"text":"👤 Entities","type":"heading","level":3,"anchor":"%F0%9F%91%A4-Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"then create entities by letting the "},{"type":"codeVoice","code":"Nexus"},{"type":"text","text":" generate them."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity without components","let newEntity = nexus.createEntity()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To define components, conform your class to the "},{"code":"Component","type":"codeVoice"},{"text":" protocol","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["final class Position: Component {","    var x: Int = 0","    var y: Int = 0","}"]},{"type":"paragraph","inlineContent":[{"text":"and assign instances of it to an ","type":"text"},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" with"}]},{"type":"codeListing","syntax":"swift","code":["let position = Position(x: 1, y: 2)","entity.set(position)"]},{"type":"paragraph","inlineContent":[{"text":"You can be more efficient by assigning components while creating an entity.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ an entity with two components assigned.","nexus.createEntity {","    Position(x: 1, y: 2)","    Color(.red)","}","","\/\/ bulk create entities with multiple components assigned.","nexus.createEntities(count: 100) { _ in","    Position()","    Color()","}",""]},{"text":"👪 Families","type":"heading","level":3,"anchor":"%F0%9F%91%AA-Families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ECS uses a grouping approach for entities with the same component types to optimize cache locality and ease up access to them."},{"type":"text","text":"\n"},{"type":"text","text":"Entities with the "},{"type":"strong","inlineContent":[{"text":"same component types","type":"text"}]},{"text":" may belong to one ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"Family","type":"codeVoice"},{"text":" has entities as members and component types as family traits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Create a family by calling ","type":"text"},{"code":".family","type":"codeVoice"},{"text":" with a set of traits on the nexus.","type":"text"},{"text":" ","type":"text"},{"text":"A family that contains only entities with a ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PlayerInput","type":"codeVoice"},{"text":" component, but no ","type":"text"},{"code":"Texture","type":"codeVoice"},{"text":" component is created by","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                          excludesAll: Texture.self)"]},{"type":"paragraph","inlineContent":[{"text":"These entities are cached in the nexus for efficient access and iteration.","type":"text"},{"text":" ","type":"text"},{"text":"Families conform to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swift\/sequence"},{"text":" protocol so that members (components)","type":"text"},{"text":" ","type":"text"},{"text":"may be iterated and accessed like any other sequence in Swift.","type":"text"},{"text":"\n","type":"text"},{"text":"Access a family’s components directly on the family instance. To get family entities and access components at the same time call ","type":"text"},{"code":"family.entityAndComponents","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you are only interested in a family’s entities call ","type":"text"},{"code":"family.entities","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class PlayerMovementSystem {","    let family = nexus.family(requiresAll: Movement.self, PlayerInput.self,","                              excludesAll: Texture.self)","","    func update() {","        family","            .forEach { (mov: Movement, input: PlayerInput) in","            ","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            \/\/ set properties","            mov.position.x = mov.position.x + 3.0","            ...","            ","            \/\/ current input command for the given entity","            _ = input.command","            ...","            ","        }","    }","","    func update2() {","        family","            .entityAndComponents","            .forEach { (entity: Entity, mov: Movement, input: PlayerInput) in","            ","            \/\/ the current entity instance","            _ = entity","","            \/\/ position & velocity component for the current entity","            ","            \/\/ get properties","            _ = mov.position","            _ = mov.velocity","            ","            ","        }","    }","","    func update3() {","        family","            .entities","            .forEach { (entity: Entity) in","            ","            \/\/ the current entity instance","            _ = entity","        }","    }","}"]},{"text":"🧑 Singles","type":"heading","level":3,"anchor":"%F0%9F%A7%91-Singles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Single"},{"type":"text","text":" on the other hand is a special kind of family that holds exactly "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" entity with exactly "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" component for the entire lifetime of the Nexus. This may come in handy if you have components that have a "},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Singleton_(mathematics)"},{"type":"text","text":" character. Single components must conform to the "},{"type":"codeVoice","code":"SingleComponent"},{"type":"text","text":" protocol and will not be available through regular family iteration."}]},{"type":"codeListing","syntax":"swift","code":["final class GameState: SingleComponent {","    var quitGame: Bool = false","}","class GameLogicSystem {","    let gameState: Single<GameState>","    ","    init(nexus: Nexus) {","        gameState = nexus.single(GameState.self)","    }","    ","    func update() {","        \/\/ update your game sate here","        gameState.component.quitGame = true","        ","        \/\/ entity access is provided as well","        _ = gameState.entity","    }","}",""]},{"level":3,"type":"heading","anchor":"%F0%9F%94%97-Serialization","text":"🔗 Serialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To serialize\/deserialize entities you must conform their assigned components to the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" protocol."},{"type":"text","text":"\n"},{"type":"text","text":"Conforming components can then be serialized per family like this:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ MyComponent and YourComponent both conform to Component and Codable protocols.","let nexus = Nexus()","let family = nexus.family(requiresAll: MyComponent.self, YourComponent.self)","","\/\/ JSON encode entities from given family.","var jsonEncoder = JSONEncoder()","let encodedData = try family.encodeMembers(using: &jsonEncoder)","","\/\/ Decode entities into given family from JSON. ","\/\/ The decoded entities will be added to the nexus.","var jsonDecoder = JSONDecoder()","let newEntities = try family.decodeMembers(from: jsonData, using: &jsonDecoder)",""]}]}],"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEvent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventDelegate"],"anchor":"Essentials"}],"abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs"]}],"kind":"article","references":{"https://en.wikipedia.org/wiki/Entity_component_system":{"url":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system","type":"link","titleInlineContent":[{"type":"text","text":"ECS"}],"title":"ECS","identifier":"https:\/\/en.wikipedia.org\/wiki\/Entity_component_system"},"https://github.com/fireblade-engine/ecs-demo":{"type":"link","titleInlineContent":[{"type":"text","text":"Fireblade ECS Demo App"}],"ur