aving 1 required components each."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A family is a collection of entities with uniform component types per entity."},{"type":"text","text":" "},{"type":"text","text":"Entities that are be part of this family will have at least the 1 required components,"},{"type":"text","text":" "},{"type":"text","text":"but may have more components assigned."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A family is just a view on (component) data, creating them is cheap."},{"type":"text","text":" "},{"type":"text","text":"Use them to iterate efficiently over entities with the same components assigned."},{"type":"text","text":" "},{"type":"text","text":"Families with the same requirements provide a view on the same collection of entities (aka members)."},{"type":"text","text":" "},{"type":"text","text":"A family conforms to the "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":" and therefore can be accessed like any other (lazy) sequence."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General usage"}]}],"type":"paragraph"},{"code":["let family = nexus.family(requires: Comp1.self)","\/\/ iterate each entity's components","family.forEach { (comp1) in","  ...","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caveats"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component types must be unique per family"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N 