tifier","preciseIdentifier":"s:SS","text":"String"}],"required":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"abstract":[{"type":"text","text":"The stable identifier of this component type, derived from "},{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","type":"reference"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","title":"stableIdentifier","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier"}],"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","role":"symbol","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Component":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","type":"topic","role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"title":"Component","url":"\/documentation\/firebladeecs\/component","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"kind":"symbol","abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}]}}}