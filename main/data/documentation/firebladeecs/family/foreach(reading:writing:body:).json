":"paragraph","inlineContent":[{"text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TypeSubstituter.transformPackElementType"},{"text":").","type":"text"}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","title":"Component","url":"\/documentation\/firebladeecs\/component","role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"abstract":[{"inlineContent":[{"type":"text","text":"Component"}],"type":"strong"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","title":"Family","url":"\/documentation\/firebladeecs\/family","role":"symbol","navigatorTitle":[{"text":"Family","kind":"identifier"}],"abstract":[{"type":"text","text":"A group of entities that share a common set of component types."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"}]},"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:body:)":{"type":"topic","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:body:)","title":"forEach(reading:writing:body:)","url":"\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"c