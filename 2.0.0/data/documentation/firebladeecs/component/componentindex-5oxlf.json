{"kind":"symbol","variants":[{"paths":["\/documentation\/firebladeecs\/component\/componentindex-5oxlf"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storages address their per-type state and the per-entity component bitset by this value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default implementation assigns indices lazily: the first access of a type takes the next free index"},{"type":"text","text":" "},{"type":"text","text":"of the process, later accesses look it up in a thread-safe table. The index is process-wide, not per "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so all nexuses of a process agree on it. Indices are dense ("},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" for "},{"type":"codeVoice","code":"n"},{"type":"text","text":" types used so far) and unbounded."},{"type":"text","text":" "},{"type":"text","text":"They depend on the order of first use and are not stable between process launches;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","isActive":true},{"type":"text","text":" for persistent data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift has no stored static properties in generic types, so a plain conformance can not cache its index in a static."},{"type":"text","text":" "},{"type":"text","text":"Provide your own implementation (the "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" macro will) as a stored "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" for a plain load,"},{"type":"text","text":" "},{"type":"text","text":"but only if you can guarantee that two types never share an index and that it is in "},{"type":"codeVoice","code":"0 ..< 1_048_576"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Indices are process-wide: a hand-assigned index must not collide with a lazily assigned one of another type."},{"type":"text","text":" "},{"type":"text","text":"A collision or an index out of range traps at first use of the type in a nexus."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(1)"}],"type":"paragraph"}],"style":"note"}]}],"metadata":{"title":"componentIndex","externalID":"s:12FirebladeECS9ComponentPAAE14componentIndexSivpZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"roleHeading":"Type Property","extendedModule":"FirebladeECS","modules":[{"name":"FirebladeECS"}],"role":"symbol","symbolKind":"property"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"]]},"abstract":[{"text":"The dense index of this component type.","type":"text"}],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Component":{"title":"Component","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"url":"\/documentation\/firebladeecs\/component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"strong","inlineContent":[{"text":"Component","type":"text"}]}]},"doc://FirebladeECS/documentation/FirebladeECS":{"kind":"symbol","abstract":[{"type":"text","text":"A lightweight, fast and easy to use Entity-Component System in Swift."}],"role":"collection","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS","type":"topic","title":"FirebladeECS","url":"\/documentation\/firebladeecs"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/componentTypeName":{"defaultImplementations":1,"title":"componentTypeName","type":"topic","role":"symbol","required":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The stable, unique name of this component type.","type":"text"}],"url":"\/documentation\/firebladeecs\/registrablecomponent\/componenttypename","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent/stableIdentifier":{"title":"stableIdentifier","type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/stableIdentifier","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stableIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS25StableComponentIdentifierV","text":"StableComponentIdentifier"}],"abstract":[{"text":"The stable identifier of this component type, derived from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent\/componentTypeName"},{"text":".","type":"text"}],"url":"\/documentation\/firebladeecs\/registrablecomponent\/stableidentifier","kind":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/Nexus":{"kind":"symbol","abstract":[],"role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Nexus"}],"title":"Nexus","url":"\/documentation\/firebladeecs\/nexus","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Nexus"}]},"doc://FirebladeECS/documentation/FirebladeECS/Component/componentIndex-5oxlf":{"kind":"symbol","title":"componentIndex","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"componentIndex","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/firebladeecs\/component\/componentindex-5oxlf","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component\/componentIndex-5oxlf","role":"symbol","type":"topic","abstract":[{"text":"The dense index of this component type.","type":"text"}]}}}