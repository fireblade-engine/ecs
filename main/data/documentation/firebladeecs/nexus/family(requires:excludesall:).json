ts","family.forEach { (comp1) in","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Caveats","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Component types must be unique per family","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component type order is arbitrary"}]}]}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1) for existing families, O(N) where N is the number of entities for new families."}],"type":"paragraph"}]}]}],"metadata":{"role":"symbol","externalID":"s:12FirebladeECS5NexusC6family8requires11excludesAllAA6FamilyVyx_QPGxm_AA9Component_pXpdtAaJRzlF","extendedModule":"FirebladeECS","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"family"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Comp"},{"kind":"text","text":">("},{"kind":"externalParam","text":"requires"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Comp"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"excludesAll"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"},{"text":".Type...) -> ","kind":"text"},{"preciseIdentifier":"s:12FirebladeECS6FamilyV","text":"Family","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Comp"},{"kind":"text","text":">"}],"title":"family(requires:excludesAll:)","modules":[{"name":"FirebladeECS"}]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"}],"title":"Family","role":"symbol","navigatorTitle":[{"text":"Family","kind":"identifier"}],"identifier":"doc:\/\/FirebladeECS\/