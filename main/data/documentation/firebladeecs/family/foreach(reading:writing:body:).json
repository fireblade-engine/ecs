type":"text","text":"Specialization is disabled for this slow path: the Swift 6.4 SIL GenericSpecializer crashes on it in release builds"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"TypeSubstituter.transformPackElementType"},{"text":").","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}],"type":"aside","style":"note","name":"Complexity"}]}],"sections":[],"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family/forEach(reading:writing:body:)":{"title":"forEach(reading:writing:body:)","url":"\/documentation\/firebladeecs\/family\/foreach(reading:writing:body:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"R"},{"kind":"text","text":", each "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":").Type, "},{"kind":"externalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" (repeat each "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"), repeat each "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"kind":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"each C","type":"codeVoice"},{"t