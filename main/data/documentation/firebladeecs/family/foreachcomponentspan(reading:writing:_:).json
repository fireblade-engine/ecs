{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Iterates the members of this family in batches, giving "},{"type":"codeVoice","code":"body"},{"type":"text","text":" the components of a batch as contiguous spans."}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:writing:_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEachComponentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W1"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"writing"},{"kind":"text","text":" "},{"kind":"internalParam","text":"wType1"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":">, "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R1"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W1"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","text":"Component"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads 1 and writes 1 component type: "},{"type":"codeVoice","code":"body"},{"type":"text","text":" receives a "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" of the read type and an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableSpan"},{"type":"text","text":" "},{"type":"text","text":"of the written type. Within one call all spans have the same count and the same order: element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of every"},{"type":"text","text":" "},{"type":"text","text":"span belongs to the same member. The batches visit every member exactly once, in the iteration order of the"},{"type":"text","text":" "},{"type":"text","text":"family."}]},{"type":"codeListing","syntax":"swift","code":["movers.forEachComponentSpan(reading: Velocity.self, writing: Position.self) { velocities, positions in","    for i in positions.indices { positions[i].x += velocities[i].dx }","}"]},{"type":"heading","text":"Batches","level":3,"anchor":"Batches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps every component type in its own dense array, so the components of the members of a"},{"type":"text","text":" "},{"type":"text","text":"family are not necessarily next to each other in all arrays. The spans view the storage itself and nothing is"},{"type":"text","text":" "},{"type":"text","text":"copied or allocated, so a batch is a maximal run of members whose components are consecutive in every involved"},{"type":"text","text":" "},{"type":"text","text":"array. Entities that were created together and never had components removed form one big batch; after"},{"type":"text","text":" "},{"type":"text","text":"churn (removing components swap-removes) the batches get shorter, down to 1 element per call in the worst case."},{"type":"text","text":" "},{"type":"text","text":"Write "},{"type":"codeVoice","code":"body"},{"type":"text","text":" so that it is correct for any batch size, and do not rely on the number of calls."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The archetype storage keeps the columns of a table aligned, so it passes exactly one batch per table that matches"},{"type":"text","text":" "},{"type":"text","text":"the family and has members, in table creation order. Entities with the same component set form one batch, however"},{"type":"text","text":" "},{"type":"text","text":"the component set came about, and a family whose members have several component sets gets several calls."}]},{"type":"heading","text":"Rules","level":3,"anchor":"Rules"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every type must be a required component of the family. The spans cannot escape "},{"type":"codeVoice","code":"body"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the pass runs the nexus is locked like in "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","isActive":true,"type":"reference"},{"type":"text","text":": structural changes, reading a"},{"type":"text","text":" "},{"type":"text","text":"written type through the nexus, writing a type twice, and writing a type that is read (or reading a written"},{"type":"text","text":" "},{"type":"text","text":"type) stop the process with a message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delegate subscribed to "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true,"type":"reference"},{"type":"text","text":" receives one "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true,"type":"reference"},{"type":"text","text":" per written type"},{"type":"text","text":" "},{"type":"text","text":"and call, not one event per batch."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(N) where N is the number of members, plus one hash lookup per component type."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebladeecs\/family\/foreachcomponentspan(reading:writing:_:)"]}],"metadata":{"platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"introducedAt":"26.0","beta":false},{"name":"macOS","deprecated":false,"unavailable":false,"introducedAt":"26.0","beta":false},{"name":"tvOS","deprecated":false,"unavailable":false,"introducedAt":"26.0","beta":false},{"name":"visionOS","deprecated":false,"unavailable":false,"introducedAt":"26.0","beta":false},{"name":"watchOS","deprecated":false,"unavailable":false,"introducedAt":"26.0","beta":false}],"symbolKind":"method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"each C"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Component"},{"type":"text","text":"."}]},"modules":[{"name":"FirebladeECS"}],"extendedModule":"FirebladeECS","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forEachComponentSpan","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s11MutableSpanV","text":"MutableSpan","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"role":"symbol","externalID":"s:12FirebladeECS6FamilyV20forEachComponentSpan7reading7writing_yqd__m_qd_0_mys0G0Vyqd__G_s07MutableG0Vyqd_0_GztKXEtKAA0F0Rd__AaMRd_0_r0_lF","title":"forEachComponentSpan(reading:writing:_:)"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/Family":{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family","abstract":[{"type":"text"