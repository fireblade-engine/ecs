h","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R1","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W1","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"reading","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"writing","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"wType1","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"R1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"},{"text":", ","kind":"text"},{"text":"W1","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:12FirebladeECS9ComponentP","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to read."}]}],"name":"rType1"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to change in place."}]}],"name":"wType1"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called once per member."}]}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"code":"body","type":"codeVoice"},{"text":" receives the read components first (as copies), then the written ones as ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". The writes land","type":"text"},{"text":" ","type":"text"},{"text":"in the component storage directly. Overloads exist for 0 to 4 read and 0 to 4 written component types, and a","type":"text"},{"text":" ","type":"text"},{"text":"parameter pack overload covers more. Every fixed arity overload resolves the typed storages once and then runs","type":"text"},{"text":" ","type":"text"},{"text":"a plain loop over the members: no allocation and no dynamic dispatch per member.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let movers = nexus.family(requiresAll: Position.self, Velocity.self)","movers.forEach(reading: Velocity.self, writing: Position.self) { velocity, position in","    position.x += velocity.dx","}"]},{"inlineContent":[{"text":"Access is declared like the ","type":"text"},{"code":"in","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" term modifiers of flecs queries","type":"text"},{"text":" ","type":"text"},{"text":"(“Access modifiers” in ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/SanderMertens\/flecs\/blob\/master\/docs\/Queries.md"},{"text":"), whose ","type":"text"},{"code":"each","type":"codeVoice"},{"text":" callbacks take ","type":"text"},{"code":"const T&","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for reads and ","type":"text"},{"code":"T&","type":"codeVoice"},{"text":" for writes: here the labels ","type":"text"},{"code":"reading:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"writing:","type":"codeVoice"},{"text":" state it.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every read and written type must be a required component of this family, not an excluded one.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The written types must be pairwise different and different from the read types, and a pass must not nest"},{"type":"text","text":" "},{"type":"text","text":"a write access to a type that an enclosing pass or "},{"type":"codeVoice","code":"modify"},{"type":"text","text":" writes. Violations trap."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs, structural changes trap: creating or destroying entities, adding or removing"},{"type":"text","text":" "},{"type":"text","text":"components, and replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Collect them and apply them after the pass, and write"},{"type":"text","text":" "},{"type":"text","text":"changed values through the "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" parameters. Reading a written type through the nexus"},{"type":"text","text":" "},{"type":"text","text":"(for example "},{"type":"codeVoice","code":"entity.get(_:)"},{"type":"text","text":") traps, too."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Members are visited once each. The sparse-set storage visits them in the order of the family’s member list, the"},{"type":"text","text":" "},{"type":"text","text":"archetype storage table by table and row by row; neither order is a contract, and structural changes reorder them."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the delegate subscribed to "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusEventMask\/valueChanges","isActive":true},{"type":"text","text":", one "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentsModified","isActive":true},{"type":"text","text":" event per written type"},{"type":"text","text":" "},{"type":"text","text":"is delivered after the pass, not one per member. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" throws, the pass ends there, members already visited,"},{"type":"text","text":" "},{"type":"text","text":"including the one that threw, stay changed and the events cover them."}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(N) where N is the number of members, plus one hash lookup per component type.","type":"text"}]}],"name":"Complexity","type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEach(reading:writing:_:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family"]]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/ComponentReplaced":{"title":"ComponentReplaced","navigatorTitle":[{"text":"ComponentReplaced","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentReplaced","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComponentReplaced","kind":"identifier"}],"abstract":[{"text":"Event triggered when a component is set on an entity that already has a component of that type.","type":"text"}],"url":"\/documentation\/firebladeecs\/componentrepl