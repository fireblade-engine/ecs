{"kind":"symbol","abstract":[{"text":"Gives ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" read access to all components of a type as one contiguous ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/firebladeecs\/nexus\/componentspan(reading:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus\/componentSpan(reading:_:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component","preciseIdentifier":"s:12FirebladeECS9ComponentP"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"text":"Receives the span; its result is returned.","type":"text"}],"type":"paragraph"}],"name":"body"}]},{"kind":"mentions","mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ReadingAndWritingComponents","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ChoosingAStorage","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/MigratingToFirebladeECS2"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The span covers every component of the type in storage order, which is not the creation order once components were"},{"type":"text","text":" "},{"type":"text","text":"removed. It is zero copy: it views the storage itself. Because "},{"type":"codeVoice","code":"Span"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":", it cannot leave "},{"type":"codeVoice","code":"body"},{"type":"text","text":" "},{"text":"(storing it in a variable outside the closure or returning it is a compile time error), so it can never dangle.","type":"text"}]},{"type":"codeListing","code":["var maxX = 0","nexus.componentSpan(reading: Position.self) { (positions: Span<Position>) in","    for i in positions.indices { maxX = max(maxX, positions[i].x) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Span"},{"text":" is not a ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":": loop over "},{"type":"codeVoice","code":"indices"},{"type":"text","text":". Element access is bounds checked."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While "},{"type":"codeVoice","code":"body"},{"type":"text","text":" runs the type is locked for reading: structural changes (creating or destroying entities, adding or"},{"type":"text","text":" "},{"type":"text","text":"removing components, replacing a component with "},{"type":"codeVoice","code":"set"},{"type":"text","text":") and writes to the type stop the process with a message,"},{"type":"text","text":" "},{"type":"text","text":"since they would move or change what the span views. Reading the component through the nexus and reading"},{"type":"text","text":" "},{"type":"text","text":"the type again are fine. Collect changes and apply them after the call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty storage (or a type no entity ever had) passes an empty span."}]},{"level":3,"type":"heading","anchor":"Storage","text":"Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sparse-set storage keeps all components of a type in one array, so the span always views the storage itself."},{"type":"text","text":" "},{"type":"text","text":"The archetype storage keeps one column per table (one table per component set), so entities with different"},{"type":"text","text":" "},{"type":"text","text":"component sets are not next to each other. If one table holds all components of the type the span views its column,"},{"type":"text","text":" "},{"type":"text","text":"as above. If several tables hold them, the span views a temporary copy that is made table by table, which costs"},{"type":"text","text":" "},{"type":"text","text":"one allocation and O(N) copying per call and is released after "},{"type":"codeVoice","code":"body"},{"type":"text","text":". Use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Family\/forEachComponentSpan(reading:_:)","isActive":true},{"type":"text","text":" to get zero copy spans, one batch per table."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) plus "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}]}],"name":"Complexity","style":"note"}]}],"metadata":{"role":"symbol","externalID":"s:12FirebladeECS5NexusC13componentSpan7reading_q_xm_q_s0E0VyxGKXEtKAA9ComponentRzr0_lF","extendedModule":"FirebladeECS","platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"26.0","beta":false}],"roleHeading":"Instance Method","symbolKind":"method","title":"componentSpan(reading:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"componentSpan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"reading"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, ("},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"}],"modules":[{"name":"FirebladeECS"}]},"references":{"doc://FirebladeECS/documentation/FirebladeECS/MigratingToFirebladeECS2":{"title":"Migrating to FirebladeECS 2","role":"