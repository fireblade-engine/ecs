{"abstract":[{"type":"text","text":"An encodable view of the entities of a nexus and their serializable components."}],"hierarchy":{"paths":[["doc:\/\/FirebladeECS\/documentation\/FirebladeECS"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NonSerializableComponentHandling","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentSerializationError","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceError"],"generated":true,"title":"Snapshots","anchor":"Snapshots"}],"identifier":{"url":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NexusSnapshot"}],"modules":[{"name":"FirebladeECS"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusSnapshot"}],"externalID":"s:12FirebladeECS13NexusSnapshotV","roleHeading":"Structure","title":"NexusSnapshot"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NexusSnapshot"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/ComponentMacro","doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot references the live components and entity identifier generator of the nexus. Encode it right after creation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoded form starts with the "},{"isActive":true,"identifier":"