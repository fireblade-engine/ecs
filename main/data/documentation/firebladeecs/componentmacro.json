nent protocols from its stored properties, so you don’t have to write that code by hand:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol"}]}],[{"type":"paragraph","inlineContent":[{"text":"Generated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"stable ","type":"text"},{"code":"componentTypeName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nexus.register(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.registeredComponentTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nexus.componentType(named:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/CloneableComponent"}]}],[{"type":"paragraph","inlineContent":[{"code":"init(cloning:context:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clone(context:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.clone()"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(entities:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.clone(into:)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SerializableComponent","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"encode(to:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nexus.encodeSnapshot(using:handling:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.restoreSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"nexus.decodeSnapshot(from:using:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Nexus: Codable"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/InspectableComponent","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"componentProperties"}]}],[{"type":"paragraph","inlineContent":[{"text":"generic inspection, e.g. in editors","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/DefaultInitializable"}]}],[{"type":"paragraph","inlineContent":[{"code":"init()","type":"codeVoice"},{"text":" if every stored property has a default value (structs)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"key path assignment, state machines"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Component"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static let componentIndex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed lookups read a plain static instead of taking the registry lock"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"The core ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" library stays dependency free. Only ","type":"text"},{"code":"FirebladeECSMacros","type":"codeVoice"},{"text":" depends on ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-syntax","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All protocols can also be implemented by hand without the macro.","type":"text"}]},{"level":3,"text":"Adding the product","type":"heading","anchor":"Adding-the-product"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target. It does not re-export ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":": add the ","type":"text"},{"code":"FirebladeECS","type":"codeVoice"},{"text":" product too and import both modules in every file that uses ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":[".target(","    name: \"YourTargetName\",","    dependencies: [","        .product(name: \"FirebladeECS\", package: \"ecs\"),","        .product(name: \"FirebladeECSMacros\", package: \"ecs\")","    ])"],"type":"codeListing"},{"level":3,"text":"Declaring components","type":"heading","anchor":"Declaring-components"},{"syntax":"swift","code":["import FirebladeECS","import FirebladeECSMacros","","@Component","struct Transform {","    var position: SIMD3<Float> = .zero","    var parent: EntityIdentifier?","    @ComponentIgnored var cachedMatrix: [Float] = []  \/\/ still cloned, but not serialized or inspected","}","","@Component(excluding: .serializable)  \/\/ runtime-only component","struct RenderHandle: @unchecked Sendable {","    var handle: Int = 0","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The stable type name defaults to the fully qualified type name. Declare "},{"code":"static let componentTypeName","type":"codeVoice"},{"text":" to override it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After renaming a persisted type, list its former names in "},{"type":"codeVoice","code":"static let componentTypeNameAliases"},{"type":"text","text":" so existing snapshots keep loading. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/SavingAndLoadingScenes"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Component(excluding:)"},{"text":" takes a ","type":"text"},{"type":"codeVoice","code":"ComponentMacroFeatures"},{"text":" set: ","type":"text"},{"type":"codeVoice","code":".cloneable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".serializable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".inspectable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".defaultInit"},{"text":". Registration is always implemented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@ComponentIgnored","type":"codeVoice"},{"text":" keeps a stored property out of serialization and inspection. Ignored properties are still cloned and need a default value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Serialized properties need an explicit type annotation. ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants with an initial value are not serialized.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Members you declare yourself are not generated. Declaring any of "},{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" leaves serialization entirely to you.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generated initializers live in an extension, so a struct keeps its memberwise initializer. A ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"package"},{"text":" struct, and a struct that declares initializers, gets a generated ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" in its body (the implicit ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" is internal and disappears next to declared initializers); an internal struct without initializers keeps the implicit one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An enum is cloned as a whole and listed without properties. It is serialized only if it declares "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" itself, and it gets "},{"code":"DefaultInitializable","type":"codeVoice"},{"type":"text","text":" only if it declares "},{"code":"init()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"The macro stores ","type":"text"},{"code":"static let componentIndex = registeredComponentIndex","type":"codeVoice"},{"text":". The index still comes from the registry at first access, so it cannot collide with a lazily assigned one. Declare your own ","type":"text"},{"code":"componentIndex","type":"codeVoice"},{"text":" to opt out.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Value-types-and-diagnostics","level":3,"type":"heading","text":"Value types and diagnostics"},{"inlineContent":[{"type":"codeVoice","code":"@Component"},{"type":"text","text":" reports an error when it is applied to a class: components are value types, so use a struct or enum. The nexus also asserts once per component type, in debug builds, that a hand-written conformance is not a class."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property spelled "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":", "},{"code":"Entity?","type":"codeVoice"},{"type":"text","text":", "},{"code":"[Entity]","type":"codeVoice"},{"type":"text","text":", "},{"code":"Set<Entity>","type":"codeVoice"},{"type":"text","text":" or "},{"code":"[Key: Entity]","type":"codeVoice"},{"type":"text","text":" is an error with a fix-it that replaces "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" by "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityIdentifier","type":"reference","isActive":true},{"type":"text","text":". An "},{"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","type":"reference","isActive":true},{"type":"text","text":" keeps its nexus alive and is not valid after a copy, a clone or a snapshot, while an identifier is a plain value that the clone context remaps. The macro sees syntax only: an "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" behind a typealias or in a nested type is not diagnosed and stays a convention."}],"type":"paragraph"},{"anchor":"Registering-cloning-and-snapshots","level":3,"type":"heading","text":"Registering, cloning and snapshots"},{"syntax":"swift","code":["let nexus = Nexus()","try nexus.register([Transform.self, RenderHandle.self])","","\/\/ Clone a whole world; entity references (`parent`) are remapped to the clones.","let playMode = Nexus()","try nexus.clone(into: playMode)","","\/\/ Export and import all serializable components, keyed by their stable type names.","var encoder = JSONEncoder()","let data = try nexus.encodeSnapshot(using: &encoder, handling: .skip)","var decoder = JSONDecoder()","try playMode.decodeSnapshot(from: data, using: &decoder)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Component types are registered automatically the first time an instance is assigned."},{"type":"text","text":" "},{"type":"text","text":"Register them explicitly before decoding snapshots that reference them."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/NexusSnapshot"},{"text":" starts with a ","type":"text"},{"code":"formatVersion","type":"codeVoice"},{"text":" and keeps the original entity identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Decoding creates new entities, remaps entity references to them through an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/EntityReferenceResolver"},{"text":", and rejects snapshots written in a newer format version.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"article","title":"Generating components with the component macro","modules":[{"name":"FirebladeECS"}],"roleHeading":"Article"},"references":{"doc://FirebladeECS/documentation/FirebladeECS/RegistrableComponent":{"url":"\/documentation\/firebladeecs\/registrablecomponent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegistrableComponent"}],"kind":"symbol","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/RegistrableComponent","type":"topic","title":"RegistrableComponent","navigatorTitle":[{"kind":"identifier","text":"RegistrableComponent"}],"abstract":[{"type":"text","text":"A component type that can be registered in the component registry of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Nexus"},{"type":"text","text":"."}],"role":"symbol"},"doc://FirebladeECS/documentation/FirebladeECS/GettingStartedWithFirebladeECS":{"url":"\/documentation\/firebladeecs\/gettingstartedwithfirebladeecs","abstract":[{"text":"Learn the API and key types Fireblade provides to compose your game or app logic.","type":"text"}],"type":"topic","role":"article","kind":"article","title":"Getting started with Fireblade ECS","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/GettingStartedWithFirebladeECS"},"doc://FirebladeECS/documentation/FirebladeECS/Entity":{"url":"\/documentation\/firebladeecs\/entity","identifier":"doc:\/\/FirebladeECS\/documentation\/FirebladeECS\/Entity","title":"Entity","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Entity","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"inlineContent":[{"type":"text","text":"Entity"}],"type":"strong"}]},"doc://FirebladeECS/documentation/FirebladeECS/Ent